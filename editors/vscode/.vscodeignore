# What NOT to ship in the .vsix. The old list had `node_modules/**`, which
# excluded the language client the extension imports at activation, so the
# packaged extension could never start; only the dev-only trees belong here.
.vscode/**
.vscode-test/**
src/**
test/**
out/**/*.map
node_modules/.bin/**
node_modules/typescript/**
node_modules/@types/**
node_modules/@vscode/**
**/*.ts
**/.gitignore
**/tsconfig.json
**/*.vsix
