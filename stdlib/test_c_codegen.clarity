-- Clarity → C native-compilation tests (stage 1).
--
-- For each program: run it through the tree-walking interpreter AND compile
-- it to C, build the C with a real compiler, run the binary — then assert the
-- native output matches the interpreter exactly. This proves the generated C
-- is not just well-formed but semantically faithful.
--
-- Skipped gracefully where no C compiler is on PATH.

from "lexer.clarity" import tokenize
from "parser.clarity" import parse
from "interpreter.clarity" import Interpreter
from "c_codegen.clarity" import compile_to_c

mut PASSED = 0
mut FAILED = 0
fn assert_eq(actual, expected, msg) {
    if actual == expected { PASSED += 1 }
    else { FAILED += 1; show "  FAIL: {msg}\n    interp: {expected}\n    native: {actual}" }
}

-- Pick a C compiler that's actually present.
fn _find_cc() {
    for cc in ["cc", "gcc", "clang"] {
        let r = exec_full(cc + " --version")
        if len(trim(r.stdout)) > 0 { return cc }
    }
    return null
}
let CC = _find_cc()
-- FFI programs pull dlsym, which needs libdl on Linux (a stub on modern glibc);
-- on macOS dlsym is in libSystem. Non-FFI programs strip the helper at -O2, so
-- the extra flag is harmless everywhere.
let LDL = if CC != null and contains(exec("uname"), "Linux") { " -ldl" } else { "" }
-- /proc-backed features (read_mem) only work on Linux; gate their native checks.
let IS_LINUX = CC != null and contains(exec("uname"), "Linux")

fn interp_run(src) {
    let i = Interpreter(null, null)
    i.run(parse(tokenize(src, "<t>"), src))
    return join(i.output, "\n")
}

-- Compile `src` to a native binary and return its stdout (trimmed).
fn native_run(src, tag) {
    let c = compile_to_c(parse(tokenize(src, "<t>"), src))
    let cfile = "/tmp/_clc_" + tag + ".c"
    let bin = "/tmp/_clc_" + tag
    write(cfile, c)
    exec_full(CC + " -O2 -w " + cfile + " -o " + bin + " -lm" + LDL)
    return trim(exec_full(bin).stdout)
}

fn same(tag, src) {
    assert_eq(native_run(src, tag), trim(interp_run(src)), tag)
}

-- Native-only check: FFI calls into libc/libm have no interpreter counterpart
-- (the interpreter's FFI is a different, Bun-based surface), so we assert the
-- compiled binary's output against a known-good expected string.
fn nat_eq(tag, src, expected) {
    assert_eq(native_run(src, tag), expected, tag)
}

if CC == null {
    show "-- C codegen: no C compiler on PATH — native compile tests skipped --"
} else {
    show "-- C codegen: compiling with '" + CC + "' --"

    same("arithmetic", "show 2 + 3 * 4\nshow 10 - 6 / 2\nshow 2 ** 10\nshow 17 % 5\nshow -(4 + 1)")
    same("integer_div_float", "show 12 / 4\nshow 7 / 2")
    same("float_math", "show 1.5 + 2.5\nshow 3.0 * 2.0\nshow 10.0 / 4.0")
    same("booleans", "show true\nshow false\nshow not true\nshow 5 > 3 and 2 < 1")
    same("comparisons", "show 5 > 3\nshow 3 >= 3\nshow 2 == 2\nshow 2 != 3\nshow \"a\" < \"b\"")
    same("variables", "let x = 40\nmut y = 2\ny = y + x\ny += 1\nshow y")
    same("strings", "let n = \"Clarity\"\nshow \"hi \" + n + \"!\"\nshow \"a\" + \"b\" + \"c\"")
    same("if_elif_else", "fn grade(n) { if n >= 90 { return \"A\" } elif n >= 80 { return \"B\" } else { return \"C\" } }\nshow grade(95)\nshow grade(85)\nshow grade(70)")
    same("while_loop", "mut i = 0\nmut s = 0\nwhile i < 5 { if i % 2 == 0 { s = s + i }\ni = i + 1 }\nshow s")
    same("recursion", "fn fib(n) { if n < 2 { return n }\nreturn fib(n - 1) + fib(n - 2) }\nshow fib(20)")
    same("mutual_recursion", "fn is_even(n) { if n == 0 { return true }\nreturn is_odd(n - 1) }\nfn is_odd(n) { if n == 0 { return false }\nreturn is_even(n - 1) }\nshow is_even(10)\nshow is_odd(7)")
    same("factorial_loop", "fn fact(n) { mut r = 1\nmut i = 1\nwhile i <= n { r = r * i\ni = i + 1 }\nreturn r }\nshow fact(10)")

    -- ── stage 2: lists, maps, for-loops, builtins ──
    same("list_literal", "show [1, 2, 3]\nshow [\"a\", \"b\"]\nshow []")
    same("list_index", "let xs = [10, 20, 30]\nshow xs[0]\nshow xs[2]\nshow xs[-1]")
    same("list_len_push", "mut xs = [1, 2]\npush(xs, 3)\npush(xs, 4)\nshow len(xs)\nshow xs")
    same("list_index_assign", "mut xs = [1, 2, 3]\nxs[1] = 99\nxs[0] += 5\nshow xs")
    same("map_literal", "show {\"a\": 1, \"b\": 2}\nshow {\"x\": [1, 2], \"y\": \"hi\"}")
    same("map_index", "let m = {\"a\": 1, \"b\": 2}\nshow m[\"a\"]\nshow m[\"b\"]")
    same("map_ops", "mut m = {\"a\": 1}\nm[\"b\"] = 2\nshow len(m)\nshow has(m, \"a\")\nshow has(m, \"z\")")
    same("for_list", "mut s = 0\nfor x in [1, 2, 3, 4] { s = s + x }\nshow s")
    same("for_range", "mut s = 0\nfor i in range(5) { s = s + i }\nshow s\nfor j in range(2, 5) { show j }")
    same("for_string", "for c in \"abc\" { show c }")
    same("for_map_keys", "let m = {\"a\": 1, \"b\": 2}\nmut s = 0\nfor k in m { s = s + m[k] }\nshow s")
    same("contains_str", "show contains(\"hello world\", \"world\")\nshow contains(\"abc\", \"z\")")
    same("contains_list", "show contains([1, 2, 3], 2)\nshow contains([1, 2, 3], 9)")
    same("str_builtin", "show str(42) + \"!\"\nshow \"n=\" + str(3 + 4)")
    same("nested_loops", "mut total = 0\nfor i in range(3) { for j in range(3) { total = total + i * j } }\nshow total")

    -- ── stage 3: classes ──
    same("class_counter", "class Counter { fn init(start) { this.n = start }\nfn inc() { this.n = this.n + 1 }\nfn get() { return this.n } }\nlet c = Counter(5)\nc.inc()\nc.inc()\nshow c.get()")
    same("class_to_string", "class Point { fn init(x, y) { this.x = x\nthis.y = y }\nfn to_string() { return \"(\" + str(this.x) + \", \" + str(this.y) + \")\" } }\nshow Point(3, 4)")
    same("class_default_display", "class Empty { fn init() {} }\nshow Empty()")
    same("class_mutation", "class Calc { fn init() { this.total = 0 }\nfn add(x) { this.total = this.total + x }\nfn double() { this.total = this.total * 2 }\nfn result() { return this.total } }\nlet k = Calc()\nk.add(3)\nk.double()\nshow k.result()")
    same("class_field_list", "class Stack { fn init() { this.items = [] }\nfn put(x) { push(this.items, x) }\nfn size() { return len(this.items) } }\nlet s = Stack()\ns.put(10)\ns.put(20)\nshow s.size()\nshow s.items")
    same("class_method_calls_method", "class Greeter { fn init(name) { this.name = name }\nfn greeting() { return \"Hello, \" + this.name }\nfn shout() { return this.greeting() + \"!\" } }\nshow Greeter(\"Kyan\").shout()")
    same("class_inheritance", "class Animal { fn init(name) { this.name = name }\nfn speak() { return \"...\" }\nfn describe() { return this.name + \" says \" + this.speak() } }\nclass Dog < Animal { fn speak() { return \"woof\" } }\nlet d = Dog(\"Rex\")\nshow d.describe()")

    -- ── stage 4: closures ──
    same("closure_map", "show map([1, 2, 3], fn(x) { return x * 2 })")
    same("closure_capture", "let factor = 10\nshow map([1, 2, 3], fn(x) { return x * factor })")
    same("closure_filter", "show filter([1, 2, 3, 4, 5, 6], fn(x) { return x % 2 == 0 })")
    same("closure_reduce", "show reduce([1, 2, 3, 4], fn(a, b) { return a + b }, 0)")
    same("closure_var_call", "let add = fn(a, b) { return a + b }\nshow add(3, 4)")
    same("closure_returns_closure", "fn adder(n) { return fn(x) { return x + n } }\nlet add5 = adder(5)\nshow add5(10)\nshow add5(100)")
    same("closure_multi_capture", "let a = 1\nlet b = 100\nshow map([1, 2, 3], fn(x) { return x * a + b })")
    -- closures capture collections/objects by their (shared) pointer, so
    -- mutating through the capture is visible outside — matching the interpreter.
    same("closure_captures_list", "let acc = []\neach([1, 2, 3], fn(x) { push(acc, x * x) })\nshow acc")
    same("closure_captures_object", "class Box { fn init() { this.n = 0 }\nfn add(x) { this.n = this.n + x } }\nlet b = Box()\neach([1, 2, 3, 4], fn(x) { b.add(x) })\nshow b.n")

    -- ── stage 5/6: allocation, then the mark-sweep GC ──
    -- Heavy allocation crosses the GC threshold and exercises list-growth-by-
    -- copy; output must still match the interpreter exactly.
    same("arena_bulk_alloc", "mut acc = []\nmut i = 0\nwhile i < 30000 { push(acc, i * 2)\ni = i + 1 }\nshow len(acc)\nshow acc[29999]\nshow acc[0]")
    same("arena_string_churn", "mut s = \"\"\nmut i = 0\nwhile i < 2000 { s = s + \"ab\"\ni = i + 1 }\nshow len(s)")
    -- Heavy allocation through the GC-tracked allocator (mid-run collection is
    -- off by default — see CLARITY_GC): live data must remain correct while a
    -- lot of per-iteration garbage is allocated and dropped.
    same("gc_live_data_correct", "mut kept = []\nmut i = 0\nwhile i < 20000 { let junk = [i, i, i, i]\npush(kept, i * 2)\ni = i + 1 }\nshow len(kept)\nshow kept[0]\nshow kept[19999]")
    -- A captured, mutated collection inside a returned closure stays correct
    -- across a lot of allocation.
    same("gc_closure_state_correct", "fn counter() { mut c = [0]\nreturn fn() { c[0] = c[0] + 1\nreturn c[0] } }\nlet next = counter()\nmut i = 0\nwhile i < 20000 { let g = [i, i, i]\nnext()\ni = i + 1 }\nshow next()")

    -- ── stage 7: native app stdlib — strings, file I/O, args/env ──
    same("str_case_trim", "show upper(trim(\"  hi there  \"))\nshow lower(\"MixEd\")")
    same("str_split_join", "show split(\"a,b,c\", \",\")\nshow join([\"x\", \"y\", \"z\"], \"-\")\nshow split(\"one two three\", \" \")")
    same("str_replace", "show replace(\"foo bar foo baz\", \"foo\", \"X\")")
    same("str_starts_ends", "show starts(\"hello\", \"he\")\nshow ends(\"hello\", \"lo\")\nshow starts(\"hello\", \"x\")")
    same("str_substring", "show substring(\"clarity\", 0, 5)\nshow substring(\"clarity\", 3, 7)\nshow substring(\"clarity\", -3, 5)")
    same("str_chars_index", "show char_at(\"abc\", 1)\nshow char_code(\"A\")\nshow from_char_code(66)\nshow index_of(\"hello world\", \"world\")\nshow index_of(\"abc\", \"z\")")
    same("str_pad_repeat_chars", "show pad_left(\"7\", 4) + \"|\"\nshow pad_right(\"7\", 4) + \"|\"\nshow repeat(\"ab\", 3)\nshow chars(\"hi\")")
    same("str_predicates", "show is_digit(\"123\")\nshow is_digit(\"12a\")\nshow is_alpha(\"abc\")\nshow is_alnum(\"a1b2\")\nshow is_space(\"   \")")
    same("str_int_float_conv", "show int(\"42\") + 8\nshow float(\"3.5\") * 2.0\nlet nums = map(split(\"5 10 15\", \" \"), fn(x) { return int(x) })\nshow reduce(nums, fn(a, b) { return a + b }, 0)")

    -- File I/O: write then read back, exists, line count. Both the interpreter
    -- and the native binary hit the real filesystem, so results must match.
    same("file_write_read", "let p = \"/tmp/_clc_s7_file.txt\"\nwrite(p, \"line1\\nline2\\nline3\")\nshow read(p)\nshow exists(p)\nshow exists(\"/tmp/_clc_nope_xyz\")\nshow len(lines(p))")
    same("file_append", "let p = \"/tmp/_clc_s7_app.txt\"\nwrite(p, \"a\")\nappend(p, \"b\")\nappend(p, \"c\")\nshow read(p)")

    -- ── stage 8: exec/process + math ──
    same("math_basic", "show abs(-5)\nshow abs(-3.5)\nshow floor(3.7)\nshow ceil(3.2)\nshow round(2.5)\nshow round(3.14159, 2)\nshow sqrt(16.0)")
    same("math_agg", "show sum([1, 2, 3, 4])\nshow min([3, 1, 2])\nshow max([3, 1, 2])\nshow min(5, 3)\nshow max(5, 3)\nshow sum([1.5, 2.5])")
    -- exec: both the interpreter and the native binary run the real shell command
    same("exec_echo", "show exec(\"echo hello\")\nshow exec(\"echo one; echo two\")")
    same("exec_full_cmd", "show trim(exec_full(\"echo hi\").stdout)\nshow exec_full(\"echo hi\").exit_code\nshow exec_full(\"exit 3\").exit_code")

    -- ── stage 9: JSON (single-quoted JSON literals keep the escaping sane) ──
    same("json_parse_display", "let o = json_parse('{\"name\": \"Kyan\", \"age\": 3, \"pi\": 3.14, \"ok\": true, \"nil\": null, \"tags\": [\"a\", \"b\"]}')\nshow o\nshow o.name\nshow o.tags[1]\nshow o.pi")
    same("json_parse_nested", "let o = json_parse('{\"a\": 1, \"nested\": {\"x\": [10, 20, 30]}}')\nshow o.a\nshow o.nested.x[2]\nshow len(keys(o))")
    same("json_string_basic", "show json_string({\"a\": 1, \"b\": [true, null, \"x\"], \"c\": {\"d\": 2.5}})")
    same("json_string_types", "show json_string([1, \"two\", false])\nshow json_string(\"hi\\nthere\")")
    same("json_roundtrip", "let s = '{\"k\": [1, 2, 3], \"s\": \"hello\", \"n\": 42}'\nshow json_string(json_parse(s))")
    same("json_numbers", "let o = json_parse('[1, 2.5, -3, 100]')\nshow o\nshow sum(o)")

    -- ── stage 10: binary I/O + bitwise ops (RE/mod foundation) ──
    same("bitwise_ops", "show 12 & 10\nshow 12 | 10\nshow 12 ^ 10\nshow 1 << 4\nshow 255 >> 4\nshow 6 & 3 | 8")
    same("bitwise_precedence", "show 1 + 2 << 3\nshow (255 & 15) + (1 << 2)")
    -- little-endian u32 decode from raw bytes — the core RE primitive. The high
    -- byte sets bit 31, so the current 32-bit-signed semantics wrap it negative;
    -- native must match the interpreter exactly (pins the semantics for the
    -- planned 64-bit-bitwise follow-up).
    same("le_u32_decode", "let b = [33, 67, 101, 135]\nshow b[0] | (b[1] << 8) | (b[2] << 16) | (b[3] << 24)")
    -- big-endian u16 decode
    same("be_u16_decode", "let b = [1, 44]\nshow (b[0] << 8) | b[1]")
    same("bytes_roundtrip", "write_bytes(\"/tmp/_clc_b10.bin\", [72, 105, 33, 0, 255])\nlet r = read_bytes(\"/tmp/_clc_b10.bin\")\nshow r\nshow len(r)\nshow r[0]\nshow r[4]")
    -- magic-byte sniffing: does the file start with the PNG signature?
    same("magic_sniff", "write_bytes(\"/tmp/_clc_png.bin\", [137, 80, 78, 71, 13, 10, 26, 10, 99])\nlet b = read_bytes(\"/tmp/_clc_png.bin\")\nlet png = [137, 80, 78, 71]\nmut ok = true\nfor i in range(4) { if b[i] != png[i] { ok = false } }\nshow ok\nshow b[1]")

    -- ── stage 11: native FFI — call C directly from a compiled binary ──
    -- (native-only: the interpreter's FFI is a separate Bun-based surface)
    nat_eq("ffi_strlen", "show ffi_call(\"strlen\", \"ls\", [\"hello, world\"])", "12")
    nat_eq("ffi_abs", "show ffi_call(\"abs\", \"ll\", [-7])", "7")
    nat_eq("ffi_toupper", "show ffi_call(\"toupper\", \"ll\", [97])", "65")
    -- ffi_sym resolves a real symbol to a non-zero address
    nat_eq("ffi_sym", "let a = ffi_sym(\"strlen\")\nshow a != 0\nshow ffi_sym(\"no_such_symbol_xyz\")", "true\n0")
    -- compose: use an FFI result in ordinary Clarity control flow
    nat_eq("ffi_compose", "let n = ffi_call(\"strlen\", \"ls\", [\"clarity\"])\nif n > 5 { show \"long: \" + str(n) } else { show \"short\" }", "long: 7")

    -- ── stage 12: RE byte toolkit (bytes.clarity) compiles for free ──
    -- These are the real bytes.clarity function bodies, inlined so the harness
    -- (which doesn't resolve module imports) can compile them. Each proves the
    -- pure-Clarity RE primitives produce identical output native vs interpreter.

    -- Unsigned readers use arithmetic, not `<< 24`, so a high u32 stays UNSIGNED
    -- (0x87654321 = 2271560481) instead of sign-wrapping like the stage-10
    -- `le_u32_decode` case does; the signed reader wraps it back explicitly.
    same("re_readers", "fn u16le(b,o){return b[o]+b[o+1]*256}\nfn u32le(b,o){return b[o]+b[o+1]*256+b[o+2]*65536+b[o+3]*16777216}\nfn i32le(b,o){let v=u32le(b,o)\nif v>=2147483648{return v-4294967296}\nreturn v}\nlet b=[33,67,101,135]\nshow u16le(b,0)\nshow u32le(b,0)\nshow i32le(b,0)")

    -- big-endian readers + a 64-bit little-endian read (exact below 2^53)
    same("re_be_u64", "fn u16be(b,o){return b[o]*256+b[o+1]}\nfn u32be(b,o){return b[o]*16777216+b[o+1]*65536+b[o+2]*256+b[o+3]}\nfn u32le(b,o){return b[o]+b[o+1]*256+b[o+2]*65536+b[o+3]*16777216}\nfn u64le(b,o){return u32le(b,o)+u32le(b,o+4)*4294967296}\nshow u16be([1,44],0)\nshow u32be([222,173,190,239],0)\nshow u64le([33,67,101,135,1,0,0,0],0)")

    -- writers append encoded bytes onto a buffer; read them back unsigned
    same("re_writers", "fn u32le(b,o){return b[o]+b[o+1]*256+b[o+2]*65536+b[o+3]*16777216}\nfn put_u32le(b,v){push(b,v&255)\npush(b,(v>>8)&255)\npush(b,(v>>16)&255)\npush(b,(v>>24)&255)}\nmut w=[]\nput_u32le(w,3735928559)\nshow w\nshow u32le(w,0)")

    -- hex formatting
    same("re_hex", "fn hexch(n){return char_at(\"0123456789abcdef\",n&15)}\nfn hex_byte(v){let b=v&255\nreturn hexch((b>>4)&15)+hexch(b&15)}\nfn to_hex(buf){mut p=[]\nfor b in buf{push(p,hex_byte(b))}\nreturn join(p,\" \")}\nshow hex_byte(15)\nshow hex_byte(167)\nshow to_hex([127,69,76,70])")

    -- AOB signature scanning with wildcards — the RE centrepiece. code is a tiny
    -- x86-64 prologue: 55 48 89 E5 (push rbp; mov rbp,rsp) then E8 rel32 (call).
    same("re_scan", "fn hexval(ch){let c=char_code(ch)\nif c>=48 and c<=57{return c-48}\nif c>=97 and c<=102{return c-87}\nif c>=65 and c<=70{return c-55}\nreturn -1}\nfn parse_pattern(sig){mut out=[]\nfor tok in split(trim(sig),\" \"){if len(tok)==0{continue}\nif tok==\"??\" or tok==\"?\" or tok==\"*\"{push(out,-1)\ncontinue}\nif len(tok)==2{let hi=hexval(char_at(tok,0))\nlet lo=hexval(char_at(tok,1))\nif hi>=0 and lo>=0{push(out,hi*16+lo)\ncontinue}}\npush(out,-1)}\nreturn out}\nfn match_at(buf,pat,off){let n=len(pat)\nif off<0 or off+n>len(buf){return false}\nmut i=0\nwhile i<n{let p=pat[i]\nif p>=0 and buf[off+i]!=p{return false}\ni=i+1}\nreturn true}\nfn find_pattern(buf,pat){let n=len(pat)\nif n==0{return -1}\nlet last=len(buf)-n\nmut off=0\nwhile off<=last{if match_at(buf,pat,off){return off}\noff=off+1}\nreturn -1}\nfn scan(buf,sig){return find_pattern(buf,parse_pattern(sig))}\nlet code=[85,72,137,229,232,17,34,51,68,195]\nshow parse_pattern(\"48 8B ?? E8\")\nshow scan(code,\"E8 ?? ?? ?? ??\")\nshow scan(code,\"48 89 E5\")\nshow scan(code,\"90 90 90\")")

    -- find_all: every offset a pattern matches
    same("re_find_all", "fn match_at(buf,pat,off){let n=len(pat)\nif off<0 or off+n>len(buf){return false}\nmut i=0\nwhile i<n{let p=pat[i]\nif p>=0 and buf[off+i]!=p{return false}\ni=i+1}\nreturn true}\nfn find_all(buf,pat){mut hits=[]\nlet n=len(pat)\nif n==0{return hits}\nlet last=len(buf)-n\nmut off=0\nwhile off<=last{if match_at(buf,pat,off){push(hits,off)}\noff=off+1}\nreturn hits}\nshow find_all([171,0,171,0,171],[171])")

    -- classic hex dump (all-printable input keeps the ascii gutter ASCII-clean)
    same("re_hexdump", "fn hexch(n){return char_at(\"0123456789abcdef\",n&15)}\nfn hex_byte(v){let b=v&255\nreturn hexch((b>>4)&15)+hexch(b&15)}\nfn hexdump(buf){mut out=[]\nlet total=len(buf)\nmut row=0\nwhile row<total{mut oh=\"\"\nmut sh=28\nwhile sh>=0{oh=oh+hexch((row>>sh)&15)\nsh=sh-4}\nmut hp=\"\"\nmut ap=\"\"\nmut col=0\nwhile col<16{let idx=row+col\nif idx<total{let b=buf[idx]\nhp=hp+hex_byte(b)+\" \"\nif b>=32 and b<127{ap=ap+from_char_code(b)}else{ap=ap+\".\"}}else{hp=hp+\"   \"}\ncol=col+1}\npush(out,oh+\"  \"+hp+\" |\"+ap+\"|\")\nrow=row+16}\nreturn join(out,\"\\n\")}\nshow hexdump([72,105,33])")

    -- ── stage 13: live-process memory access (read_mem builtin) ──
    -- read_mem/proc are Linux-only, and addresses differ between the interpreter
    -- and the compiled process, so this is a native-only property check rather
    -- than a same()-diff: the compiled binary reads its OWN /proc/self/maps,
    -- resolves a mapping's base with read_mem, and confirms it sees the ELF magic
    -- of a mapped image in live memory. Proves the native read_mem path works.
    if IS_LINUX {
        nat_eq("mem_read_self_elf", "fn hx(s){mut v=0\nfor ch in chars(s){let c=char_code(ch)\nmut d=-1\nif c>=48 and c<=57{d=c-48}\nif c>=97 and c<=102{d=c-87}\nif c>=65 and c<=70{d=c-55}\nif d>=0{v=v*16+d}}\nreturn v}\nlet ls=lines(\"/proc/self/maps\")\nmut ok=false\nmut i=0\nwhile i<len(ls) and i<40 and not ok{let line=ls[i]\nlet dash=index_of(line,\"-\")\nif dash>0{let addr=hx(substring(line,0,dash))\nlet b=read_mem(0,addr,4)\nif len(b)==4 and b[0]==127 and b[1]==69 and b[2]==76 and b[3]==70{ok=true}}\ni=i+1}\nif ok{show \"ok\"}else{show \"no elf region found\"}", "ok")
    } else {
        show "-- stage 13 read_mem: non-Linux, native check skipped --"
    }

    -- ── stage 14: write_mem — poke a live process's memory ──
    -- Error path is portable: writing to unmapped address 0 returns 0 on every
    -- platform (open fails without /proc; pwrite fails with it).
    nat_eq("write_mem_badaddr", "show write_mem(0, 0, [1, 2, 3])", "0")
    -- Real mutation is Linux-only: build a unique marker string on the heap, find
    -- it in a writable region via read_mem, overwrite its first byte with 'Z',
    -- and confirm the string now reads 'Z' — self-modifying live memory, proving
    -- write_mem actually writes. Safe: it only touches its own heap string.
    if IS_LINUX {
        nat_eq("write_mem_mutate", "fn hx(s){mut v=0\nfor ch in chars(s){let c=char_code(ch)\nmut d=-1\nif c>=48 and c<=57{d=c-48}\nif c>=97 and c<=102{d=c-87}\nif c>=65 and c<=70{d=c-55}\nif d>=0{v=v*16+d}}\nreturn v}\nfn find_marker(m){let ls=lines(\"/proc/self/maps\")\nfor line in ls{let sp=index_of(line,\" \")\nif sp>0{let range=substring(line,0,sp)\nlet dash=index_of(range,\"-\")\nif dash>0{let perms=substring(line,sp+1,sp+5)\nif char_at(perms,0)==\"r\" and char_at(perms,1)==\"w\"{let start=hx(substring(range,0,dash))\nlet size=hx(substring(range,dash+1,len(range)))-start\nif size>0 and size<8388608{let buf=read_mem(0,start,size)\nmut i=0\nlet mlen=len(m)\nwhile i+mlen<=len(buf){mut ok=true\nmut j=0\nwhile j<mlen and ok{if buf[i+j]!=char_code(char_at(m,j)){ok=false}\nj=j+1}\nif ok{return start+i}\ni=i+1}}}}}}\nreturn -1}\nlet marker=\"CLARITY_WM_\"+\"MARK_\"+str(31337)+\"_END\"\nlet addr=find_marker(marker)\nmut result=\"notfound\"\nif addr>=0{write_mem(0,addr,[char_code(\"Z\")])\nif char_at(marker,0)==\"Z\"{result=\"ok\"}else{result=\"unchanged\"}}\nshow result", "ok")
    } else {
        show "-- stage 14 write_mem mutation: non-Linux, native check skipped --"
    }

    -- ── stage 15: 64-bit-capable bit manipulation (bits.clarity) ──
    -- Pure computation, so these diff native vs interpreter directly. The point
    -- is values ABOVE 2^31, where the plain `<<`/`&` operators (32-bit-signed)
    -- would mangle results but these arithmetic/decomposition helpers stay exact
    -- to 2^53.
    same("bits_shifts", "fn pow2(n){mut v=1\nmut i=0\nwhile i<n{v=v*2\ni=i+1}\nreturn v}\nfn shl(x,n){return x*pow2(n)}\nfn shr(x,n){return int(x/pow2(n))}\nfn mask(x,b){return x%pow2(b)}\nshow shl(255,32)\nshow shr(shl(255,32),32)\nshow mask(3735928559,16)\nshow pow2(48)")
    same("bits_getbits", "fn pow2(n){mut v=1\nmut i=0\nwhile i<n{v=v*2\ni=i+1}\nreturn v}\nfn get_bits(x,s,c){return int(x/pow2(s))%pow2(c)}\nshow get_bits(3735928559,16,16)\nshow get_bits(3735928559,0,16)\nshow get_bits(171*pow2(40),40,8)")
    same("bits_ops", "fn u32(r){if r<0{return r+4294967296}\nreturn r}\nfn band(a,b){let lo=u32((a%4294967296)&(b%4294967296))\nlet hi=u32(int(a/4294967296)&int(b/4294967296))\nreturn hi*4294967296+lo}\nfn bor(a,b){let lo=u32((a%4294967296)|(b%4294967296))\nlet hi=u32(int(a/4294967296)|int(b/4294967296))\nreturn hi*4294967296+lo}\nfn bxor(a,b){let lo=u32((a%4294967296)^(b%4294967296))\nlet hi=u32(int(a/4294967296)^int(b/4294967296))\nreturn hi*4294967296+lo}\nshow band(0x1000000FF,0x1FF)\nshow bor(0x100000000,0xFF)\nshow bxor(0x1000000FF,0x100000000)\nshow band(0xABCDEF012345,0xFFFFFF000000)")
    same("bits_tohex", "fn to_hex(x,d){mut v=x\nmut out=\"\"\nmut c=0\nwhile c<d{out=char_at(\"0123456789abcdef\",v%16)+out\nv=int(v/16)\nc=c+1}\nreturn out}\nshow to_hex(0xABCDEF012345,12)\nshow to_hex(255,2)\nshow to_hex(0,4)")

    -- ── stage 16: native FFI ffi_open — bind any shared library ──
    -- Native-only (the interpreter's FFI is a separate Bun surface), and
    -- Linux-gated (libm.so.6 path + --as-needed behaviour). This is the exact
    -- limitation stage 11 documented: under --as-needed the compiled binary
    -- never references libm, so `pow` isn't loaded and RTLD_DEFAULT can't find it
    -- (ffi_sym -> 0). ffi_open("libm.so.6") dlopen's it with RTLD_GLOBAL, and now
    -- ffi_sym/ffi_call reach it — pow(2, 10) = 1024.
    if IS_LINUX {
        nat_eq("ffi_open_libm", "show ffi_sym(\"pow\") != 0\nlet h = ffi_open(\"libm.so.6\")\nshow h != 0\nshow ffi_sym(\"pow\") != 0\nshow ffi_call(\"pow\", \"ddd\", [2.0, 10.0])", "false\ntrue\ntrue\n1024")
    } else {
        show "-- stage 16 ffi_open: non-Linux, native check skipped --"
    }

    -- ── stage 17: native FFI buffers + generic word-arg calls ──
    -- Portable (libc memset/memcpy/calloc on Linux and macOS): allocate a raw
    -- buffer, pass its pointer to a C function, and marshal the result back.
    -- Proves pointer args ('p') and the ffi_buffer/read/write path — the layer a
    -- real library binding (Capstone, a codec) needs. (Backward compat of the
    -- generic caller is covered by the stage-11 ffi_strlen/abs/toupper cases,
    -- which now route through the same path.)
    nat_eq("ffi_buffer_memset", "let b=ffi_buffer(8)\nffi_call(\"memset\",\"vpll\",[b,65,5])\nshow ffi_read(b,5)\nffi_free(b)", "[65, 65, 65, 65, 65]")
    nat_eq("ffi_buffer_memcpy", "let src=ffi_buffer(4)\nffi_write(src,[1,2,3,4])\nlet dst=ffi_buffer(4)\nffi_call(\"memcpy\",\"pppl\",[dst,src,4])\nshow ffi_read(dst,4)\nffi_free(src)\nffi_free(dst)", "[1, 2, 3, 4]")

    exec("rm -f /tmp/_clc_*")
}

show ""
show "C codegen: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " C codegen test(s) failed" }
