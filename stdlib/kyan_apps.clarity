-- KyanOS app content painters — rebrand phase K4.
--
-- Each painter draws an app's UI into a window's content rectangle
-- (chrome is drawn by KyanDesktop). Signature: (fb, x, y, w, h,
-- theme, focused). Built entirely from the K2 renderer primitives —
-- gradients, glass, scalable text — so they look like the identity.
--
-- Prism is the flagship: the game hub where you play games built in
-- Clarity and (later) build your own.

from "draw.clarity" import fill_rect, rounded_rect, rounded_rect_blend, linear_gradient, line, fill_rect_blend
from "font.clarity" import builtin_font, draw_text, draw_text_scaled, draw_text_smooth, measure_text
from "atlas_font.clarity" import shared_atlas, draw_atlas_text, measure_atlas_text
from "graphics.clarity" import rgba
from "theme_kyan.clarity" import kyan_gradient_stops

-- ── Prism — the game hub ────────────────────────────────

-- The Prism catalogue. Index 0 is Voidrunner (the featured, actually
-- playable, built-in title); 1..4 are the library grid. Each carries a
-- gradient "art", a genre, and a one-line pitch for the detail view.
let _PRISM_GAMES = [
    {"name": "Voidrunner", "genre": "Runner", "playable": true,
     "art": [{"t": 0.0, "color": 0xFF7C3AED}, {"t": 1.0, "color": 0xFF22D3EE}],
     "desc": "Outrun the collapse of a dying star system. A built-in Clarity title."},
    {"name": "Hexfield", "genre": "Strategy", "playable": false,
     "art": [{"t": 0.0, "color": 0xFF7C3AED}, {"t": 1.0, "color": 0xFF22D3EE}],
     "desc": "Command hex legions across a fractured frontier."},
    {"name": "Orbit Decay", "genre": "Arcade", "playable": false,
     "art": [{"t": 0.0, "color": 0xFFFB7185}, {"t": 1.0, "color": 0xFF4F46E5}],
     "desc": "Thread decaying orbits before the last satellite falls."},
    {"name": "Verdant", "genre": "Puzzle", "playable": false,
     "art": [{"t": 0.0, "color": 0xFF0EA5E9}, {"t": 1.0, "color": 0xFF34D399}],
     "desc": "Grow impossible gardens, one tessellation at a time."},
    {"name": "Ash Fable", "genre": "RPG", "playable": false,
     "art": [{"t": 0.0, "color": 0xFFFBBF24}, {"t": 1.0, "color": 0xFF7C3AED}],
     "desc": "A slow-burning saga through cinder kingdoms."}
]

fn new_prism() { return {"view": "library", "sel": 0} }

-- Shared main-column origin/size (right of the sidebar).
fn _prism_main(x, w) {
    let sw = 132
    return [x + sw + 18, w - sw - 36, sw]
}

-- Absolute rect of the library "Play" pill (featured card). Shared by
-- paint and hit-test; kept as a named fn for back-compat.
fn prism_play_rect(x, y, w, h) {
    return [x + 168, y + 104, 90, 24]
}

-- Library grid tile rects: [x, y, w, h] per visible tile (games 1..4).
fn _prism_grid(x, y, w, h) {
    let m = _prism_main(x, w)
    let mx = m[0]
    let mw = m[1]
    let gy = y + 18 + 120 + 18
    let cols = 4
    let gap = 12
    let cw = int((mw - (cols - 1) * gap) / cols)
    let ch = 96
    mut out = []
    mut i = 0
    while i < cols {
        push(out, {"idx": i + 1, "x": mx + i * (cw + gap), "y": gy, "w": cw, "h": ch})
        i = i + 1
    }
    return out
}

-- Detail-view rects: the back affordance and the play button.
fn _prism_detail_layout(x, y, w, h) {
    let m = _prism_main(x, w)
    let mx = m[0]
    let mw = m[1]
    let hero_y = y + 44
    let hero_h = 150
    return {"mx": mx, "mw": mw, "hero_y": hero_y, "hero_h": hero_h,
            "back": [mx, y + 14, 80, 22],
            "play": [mx, hero_y + hero_h + 74, 130, 34]}
}

fn paint_prism(fb, x, y, w, h, theme, state) {
    let t = theme
    let atlas = shared_atlas()
    let view = if state != null and has(state, "view") { state["view"] } else { "library" }
    -- sidebar (both views)
    let sw = 132
    fill_rect(fb, x, y, sw, h, t["surface_elevated"])
    fill_rect(fb, x + sw - 1, y, 1, h, t["border"])
    _prism_head(fb, x + 14, y + 14, "PLAY", t, atlas)
    _prism_item(fb, x + 10, y + 32, sw - 20, "Library", t, atlas, true)
    _prism_item(fb, x + 10, y + 56, sw - 20, "Store", t, atlas, false)
    _prism_item(fb, x + 10, y + 80, sw - 20, "Friends", t, atlas, false)
    _prism_head(fb, x + 14, y + 110, "BUILD", t, atlas)
    _prism_item(fb, x + 10, y + 128, sw - 20, "Forge", t, atlas, false)
    _prism_item(fb, x + 10, y + 152, sw - 20, "Assets", t, atlas, false)

    let m = _prism_main(x, w)
    if m[1] < 40 { return null }
    if view == "detail" {
        let sel = if has(state, "sel") { state["sel"] } else { 0 }
        _paint_prism_detail(fb, x, y, w, h, t, atlas, sel)
    } else {
        _paint_prism_library(fb, x, y, w, h, t, atlas)
    }
}

fn _paint_prism_library(fb, x, y, w, h, t, atlas) {
    let m = _prism_main(x, w)
    let mx = m[0]
    let mw = m[1]
    -- featured card (game 0)
    let g0 = _PRISM_GAMES[0]
    let fh = 120
    let fy = y + 18
    linear_gradient(fb, mx, fy, mw, fh, [
        {"t": 0.0, "color": 0xFF131022},
        {"t": 1.0, "color": 0xFF0B2440}
    ], "h")
    linear_gradient(fb, mx, fy, mw, 3, kyan_gradient_stops(), "h")
    draw_atlas_text(fb, mx + 18, fy + 14, "FEATURED - BUILT IN CLARITY", atlas, t["accent"], {"size": 12, "tracking": 1})
    draw_atlas_text(fb, mx + 18, fy + 32, g0["name"], atlas, 0xFFFFFFFF, {"size": 30})
    draw_atlas_text(fb, mx + 18, fy + 70, g0["desc"], atlas, t["foreground_muted"], {"size": 14})
    let pr = prism_play_rect(x, y, w, h)
    rounded_rect(fb, pr[0], pr[1], pr[2], pr[3], 8, t["accent"])
    draw_atlas_text(fb, pr[0] + 14, pr[1] + 4, "> Play", atlas, 0xFF05060A, {"size": 15})

    -- game grid (games 1..4), from the shared geometry
    for cell in _prism_grid(x, y, w, h) {
        if cell["y"] + cell["h"] < y + h {
            _prism_game(fb, cell["x"], cell["y"], cell["w"], cell["h"], _PRISM_GAMES[cell["idx"]], t, atlas)
        }
    }
}

fn _paint_prism_detail(fb, x, y, w, h, t, atlas, sel) {
    let g = _PRISM_GAMES[sel]
    let L = _prism_detail_layout(x, y, w, h)
    let mx = L["mx"]
    let mw = L["mw"]
    -- back affordance
    let bk = L["back"]
    draw_atlas_text(fb, bk[0], bk[1] + 4, "< Library", atlas, t["accent"], {"size": 14})
    -- hero art with the title over a darkened base
    let hy = L["hero_y"]
    let hh = L["hero_h"]
    linear_gradient(fb, mx, hy, mw, hh, g["art"], "h")
    fill_rect_blend(fb, mx, hy + hh - 52, mw, 52, rgba(5, 6, 10, 150))
    draw_atlas_text(fb, mx + 16, hy + hh - 44, g["name"], atlas, 0xFFFFFFFF, {"size": 26})
    draw_atlas_text(fb, mx + 16, hy + hh - 16, g["genre"], atlas, t["ink_soft"], {"size": 13})
    -- description
    draw_atlas_text(fb, mx, hy + hh + 20, g["desc"], atlas, t["foreground_muted"], {"size": 14})
    -- play button (label reflects whether it's the real built-in title)
    let pl = L["play"]
    rounded_rect(fb, pl[0], pl[1], pl[2], pl[3], 8, t["accent"])
    let label = if g["playable"] { "> Play" } else { "> Play demo" }
    draw_atlas_text(fb, pl[0] + 16, pl[1] + 9, label, atlas, 0xFF05060A, {"size": 15})
}

-- Hit-test a Prism click. Returns {"kind":"play"} (launch the game),
-- {"kind":"open","idx"} (open a game's detail), {"kind":"back"} (return to
-- the library), or null.
fn prism_hit(state, x, y, w, h, px, py) {
    let view = if state != null and has(state, "view") { state["view"] } else { "library" }
    if view == "detail" {
        let L = _prism_detail_layout(x, y, w, h)
        if _rect_has(L["back"], px, py) { return {"kind": "back"} }
        if _rect_has(L["play"], px, py) { return {"kind": "play"} }
        return null
    }
    -- library: featured play pill, then the featured card, then the grid
    let pr = prism_play_rect(x, y, w, h)
    if _rect_has(pr, px, py) { return {"kind": "play"} }
    if px >= _prism_main(x, w)[0] and py >= y + 18 and py < y + 18 + 120 { return {"kind": "open", "idx": 0} }
    for cell in _prism_grid(x, y, w, h) {
        if px >= cell["x"] and px < cell["x"] + cell["w"] and py >= cell["y"] and py < cell["y"] + cell["h"] {
            return {"kind": "open", "idx": cell["idx"]}
        }
    }
    return null
}
fn _rect_has(r, px, py) {
    return px >= r[0] and px < r[0] + r[2] and py >= r[1] and py < r[1] + r[3]
}

-- Registry/fallback wrapper: renders the library with fresh state.
fn paint_prism_content(fb, x, y, w, h, theme, focused) {
    paint_prism(fb, x, y, w, h, theme, new_prism())
}

fn _prism_head(fb, x, y, text, t, atlas) {
    draw_atlas_text(fb, x, y, text, atlas, t["foreground_muted"], {"size": 12, "tracking": 1})
}

fn _prism_item(fb, x, y, w, text, t, atlas, active) {
    if active {
        rounded_rect(fb, x, y, w, 20, 6, t["accent_tertiary"])
        draw_atlas_text(fb, x + 10, y + 3, text, atlas, 0xFFFFFFFF, {"size": 14})
    } else {
        draw_atlas_text(fb, x + 10, y + 3, text, atlas, t["foreground_muted"], {"size": 14})
    }
}

fn _prism_game(fb, x, y, w, h, game, t, atlas) {
    let art_h = h - 26
    linear_gradient(fb, x, y, w, art_h, game["art"], "h")
    draw_atlas_text(fb, x + 4, y + art_h + 2, game["name"], atlas, t["foreground"], {"size": 14})
    draw_atlas_text(fb, x + 4, y + art_h + 16, game["genre"], atlas, t["foreground_muted"], {"size": 12})
}

-- ── Terminal ────────────────────────────────────────────

fn paint_terminal_content(fb, x, y, w, h, theme, focused) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, 0xFF05060A)
    let lines = [
        "kyan > clarity os build",
        "-> kernel: zig build ... ok",
        "-> runtime: native vm ... ok",
        "-> iso: kyanos-1.1.iso (238 MB) ok",
        "kyan > clarity test stdlib/",
        "42 passed, 0 failed"
    ]
    mut ly = y + 10
    for ln in lines {
        let col = if char_at(ln, 0) == "k" { t["accent"] } else { t["foreground_muted"] }
        draw_atlas_text(fb, x + 12, ly, ln, atlas, col, {"size": 15})
        ly = ly + 20
    }
    -- cursor block
    fill_rect(fb, x + 12, ly + 2, 8, 13, t["accent"])
}

-- ── Terminal echo shell ─────────────────────────────────
-- A small interactive shell for hosts without a real PTY (e.g. the browser
-- build). It keeps a scrollback of output lines plus the line being typed;
-- the host feeds raw input via shell_input (Enter = "\n", Backspace = "\b").

fn new_shell() {
    return {"input": "", "lines": ["KyanOS shell - type 'help' for commands", ""]}
}

fn _starts_with(s, pre) {
    let m = len(pre)
    if m > len(s) { return false }
    return substring(s, 0, m) == pre
}

-- Feed raw typed text to the shell, char by char.
fn shell_input(state, text) {
    mut i = 0
    while i < len(text) {
        let ch = char_at(text, i)
        let code = char_code(ch)
        if ch == "\n" or ch == "\r" {
            _shell_run(state, state["input"])
            state["input"] = ""
            i = i + 1
        } elif code == 8 or code == 127 {
            -- Backspace (BS) or Delete (DEL) — the host feeds DEL(127).
            let n = len(state["input"])
            if n > 0 { state["input"] = substring(state["input"], 0, n - 1) }
            i = i + 1
        } elif code == 27 {
            -- ESC: swallow a CSI sequence (ESC [ … final-letter) whole so
            -- arrow keys don't paste "[A" into the prompt.
            i = i + 1
            if i < len(text) and char_at(text, i) == "[" {
                i = i + 1
                while i < len(text) {
                    let fc = char_code(char_at(text, i))
                    i = i + 1
                    if (fc >= 65 and fc <= 90) or (fc >= 97 and fc <= 122) { break }
                }
            }
        } elif code < 32 {
            -- swallow stray control bytes (Tab, etc.)
            i = i + 1
        } else {
            state["input"] = state["input"] + ch
            i = i + 1
        }
    }
    -- keep the scrollback bounded
    let ln = len(state["lines"])
    if ln > 200 {
        mut kept = []
        mut k = ln - 200
        while k < ln { push(kept, state["lines"][k]); k = k + 1 }
        state["lines"] = kept
    }
    return state
}

fn _shell_run(state, cmd) {
    push(state["lines"], "kyan > " + cmd)
    if cmd == "" { return null }
    if cmd == "clear" { state["lines"] = []; return null }
    if cmd == "help" {
        push(state["lines"], "commands: help  ls  clarity  echo <text>  neofetch  clear")
        return null
    }
    if cmd == "ls" {
        push(state["lines"], "voidrunner.clarity  kyan_desktop.clarity  draw.clarity  aurora.wall")
        return null
    }
    if cmd == "clarity" {
        push(state["lines"], "Clarity 1.1 - self-hosted. try: clarity run hello.clarity")
        return null
    }
    if cmd == "neofetch" {
        push(state["lines"], "KyanOS - Obsidian & neon - self-hosted in Clarity")
        return null
    }
    if _starts_with(cmd, "echo ") {
        push(state["lines"], substring(cmd, 5, len(cmd)))
        return null
    }
    push(state["lines"], "command not found: " + cmd)
    return null
}

fn paint_shell(fb, x, y, w, h, theme, state) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, 0xFF05060A)
    let lh = 20
    let maxrows = int((h - 20) / lh)
    let lines = state["lines"]
    -- show the last maxrows lines (leaving room for the live prompt)
    let total = len(lines) + 1
    mut start = 0
    if total > maxrows { start = total - maxrows }
    mut ly = y + 10
    mut idx = start
    while idx < len(lines) {
        let line = lines[idx]
        let col = if _starts_with(line, "kyan >") { t["accent"] } else { t["foreground_muted"] }
        draw_atlas_text(fb, x + 12, ly, line, atlas, col, {"size": 15})
        ly = ly + lh
        idx = idx + 1
    }
    -- the live prompt + a block cursor
    let prompt = "kyan > " + state["input"]
    draw_atlas_text(fb, x + 12, ly, prompt, atlas, t["foreground"], {"size": 15})
    let pw = measure_atlas_text(atlas, prompt, 15, 0)[0]
    fill_rect(fb, x + 12 + pw + 2, ly, 8, 14, t["accent"])
}

-- ── Text editor ─────────────────────────────────────────
-- A small immediate-mode text editor. State is a list of line strings, a
-- cursor (cy row, cx column) and a vertical scroll offset. The host feeds
-- raw input through editor_input the same way it feeds the shell: printable
-- chars insert at the cursor, "\n" splits a line, DEL/BS delete, and ESC-CSI
-- arrow sequences move the cursor — so host.clarity routes to it identically.

let _ED_LINE_H = 19
let _ED_PAD = 8
let _ED_GUTTER = 46
let _ED_STATUS_H = 22
let _ED_SIZE = 15

fn new_editor() {
    return {
        "name": "untitled.clarity",
        "lines": [
            "-- Welcome to the KyanOS editor.",
            "-- Type to edit; arrow keys move; Enter splits a line.",
            "",
            "fn main() {",
            "    show \"hello from Clarity\"",
            "}",
            ""
        ],
        "cy": 0, "cx": 0, "scroll": 0, "_rows": 20
    }
}

fn _ed_insert(state, s) {
    let line = state["lines"][state["cy"]]
    let cx = state["cx"]
    state["lines"][state["cy"]] = substring(line, 0, cx) + s + substring(line, cx, len(line))
    state["cx"] = cx + len(s)
}

fn _ed_newline(state) {
    let line = state["lines"][state["cy"]]
    let cx = state["cx"]
    let left = substring(line, 0, cx)
    let right = substring(line, cx, len(line))
    state["lines"][state["cy"]] = left
    mut out = []
    mut i = 0
    while i < len(state["lines"]) {
        push(out, state["lines"][i])
        if i == state["cy"] { push(out, right) }
        i = i + 1
    }
    state["lines"] = out
    state["cy"] = state["cy"] + 1
    state["cx"] = 0
}

fn _ed_backspace(state) {
    let cx = state["cx"]
    if cx > 0 {
        let line = state["lines"][state["cy"]]
        state["lines"][state["cy"]] = substring(line, 0, cx - 1) + substring(line, cx, len(line))
        state["cx"] = cx - 1
        return null
    }
    if state["cy"] == 0 { return null }
    let prev = state["lines"][state["cy"] - 1]
    let cur = state["lines"][state["cy"]]
    let newcx = len(prev)
    mut out = []
    mut i = 0
    while i < len(state["lines"]) {
        if i == state["cy"] - 1 { push(out, prev + cur) }
        elif i != state["cy"] { push(out, state["lines"][i]) }
        i = i + 1
    }
    state["lines"] = out
    state["cy"] = state["cy"] - 1
    state["cx"] = newcx
}

fn _ed_left(state) {
    if state["cx"] > 0 { state["cx"] = state["cx"] - 1; return null }
    if state["cy"] > 0 {
        state["cy"] = state["cy"] - 1
        state["cx"] = len(state["lines"][state["cy"]])
    }
}

fn _ed_right(state) {
    let line = state["lines"][state["cy"]]
    if state["cx"] < len(line) { state["cx"] = state["cx"] + 1; return null }
    if state["cy"] < len(state["lines"]) - 1 { state["cy"] = state["cy"] + 1; state["cx"] = 0 }
}

fn _ed_up(state) {
    if state["cy"] > 0 {
        state["cy"] = state["cy"] - 1
        let m = len(state["lines"][state["cy"]])
        if state["cx"] > m { state["cx"] = m }
    }
}

fn _ed_down(state) {
    if state["cy"] < len(state["lines"]) - 1 {
        state["cy"] = state["cy"] + 1
        let m = len(state["lines"][state["cy"]])
        if state["cx"] > m { state["cx"] = m }
    }
}

fn _ed_ensure_visible(state, rows) {
    if state["cy"] < state["scroll"] { state["scroll"] = state["cy"] }
    elif state["cy"] >= state["scroll"] + rows { state["scroll"] = state["cy"] - rows + 1 }
    if state["scroll"] < 0 { state["scroll"] = 0 }
}

-- Feed raw typed input to the editor, char by char.
fn editor_input(state, text) {
    mut i = 0
    while i < len(text) {
        let ch = char_at(text, i)
        let code = char_code(ch)
        if ch == "\n" or ch == "\r" {
            _ed_newline(state); i = i + 1
        } elif code == 8 or code == 127 {
            _ed_backspace(state); i = i + 1
        } elif code == 9 {
            _ed_insert(state, "  "); i = i + 1
        } elif code == 27 {
            -- ESC CSI arrow: ESC [ <A|B|C|D>
            i = i + 1
            if i < len(text) and char_at(text, i) == "[" {
                i = i + 1
                if i < len(text) {
                    let d = char_at(text, i)
                    if d == "A" { _ed_up(state) }
                    elif d == "B" { _ed_down(state) }
                    elif d == "C" { _ed_right(state) }
                    elif d == "D" { _ed_left(state) }
                    i = i + 1
                }
            }
        } elif code < 32 {
            i = i + 1
        } else {
            _ed_insert(state, ch); i = i + 1
        }
    }
    _ed_ensure_visible(state, state["_rows"])
    return state
}

fn _editor_layout(state, x, y, w, h) {
    let body_h = h - _ED_STATUS_H
    let rows = int((body_h - _ED_PAD) / _ED_LINE_H)
    return {
        "text_x": x + _ED_GUTTER,
        "text_y": y + _ED_PAD,
        "line_h": _ED_LINE_H,
        "gutter": _ED_GUTTER,
        "body_h": if body_h > 0 { body_h } else { 0 },
        "rows": if rows > 0 { rows } else { 1 }
    }
}

-- Place the cursor from a click. Returns true when the click landed in the
-- text body (not the status bar).
fn editor_click(state, x, y, w, h, px, py) {
    -- only clicks inside the text body (not the chrome above/around it, and
    -- not the status bar) reposition the cursor
    if px < x or px >= x + w { return false }
    if py < y or py >= y + h - _ED_STATUS_H { return false }
    let L = _editor_layout(state, x, y, w, h)
    let atlas = shared_atlas()
    mut rrel = int((py - L["text_y"]) / L["line_h"])
    if rrel < 0 { rrel = 0 }
    mut li = state["scroll"] + rrel
    if li >= len(state["lines"]) { li = len(state["lines"]) - 1 }
    if li < 0 { li = 0 }
    state["cy"] = li
    let line = state["lines"][li]
    mut col = 0
    if px > L["text_x"] {
        let target = px - L["text_x"]
        mut best = 0
        mut bestd = if target < 0 { -target } else { target }
        mut c = 1
        while c <= len(line) {
            let ww = measure_atlas_text(atlas, substring(line, 0, c), _ED_SIZE, 0)[0]
            mut dd = target - ww
            if dd < 0 { dd = -dd }
            if dd < bestd { bestd = dd; best = c }
            c = c + 1
        }
        col = best
    }
    state["cx"] = col
    _ed_ensure_visible(state, L["rows"])
    return true
}

fn paint_editor(fb, x, y, w, h, theme, state, focused) {
    let t = theme
    let atlas = shared_atlas()
    let L = _editor_layout(state, x, y, w, h)
    state["_rows"] = L["rows"]
    _ed_ensure_visible(state, L["rows"])
    -- body + gutter
    fill_rect(fb, x, y, w, h, t["surface"])
    fill_rect(fb, x, y, L["gutter"], L["body_h"], t["surface_elevated"])
    let cur_screen = state["cy"] - state["scroll"]
    -- current-line highlight
    if focused and cur_screen >= 0 and cur_screen < L["rows"] {
        let hy = L["text_y"] + cur_screen * L["line_h"]
        fill_rect(fb, x + L["gutter"], hy - 2, w - L["gutter"], L["line_h"], t["surface_elevated"])
    }
    -- visible lines + line numbers
    mut r = 0
    while r < L["rows"] {
        let li = state["scroll"] + r
        if li >= len(state["lines"]) { break }
        let ly = L["text_y"] + r * L["line_h"]
        let num = str(li + 1)
        let nw = measure_atlas_text(atlas, num, 13, 0)[0]
        draw_atlas_text(fb, x + L["gutter"] - 10 - nw, ly, num, atlas, t["foreground_muted"], {"size": 13})
        draw_atlas_text(fb, L["text_x"], ly, state["lines"][li], atlas, t["foreground"], {"size": _ED_SIZE})
        r = r + 1
    }
    -- cursor caret
    if focused and cur_screen >= 0 and cur_screen < L["rows"] {
        let line = state["lines"][state["cy"]]
        let pre = substring(line, 0, state["cx"])
        let cxp = measure_atlas_text(atlas, pre, _ED_SIZE, 0)[0]
        fill_rect(fb, L["text_x"] + cxp, L["text_y"] + cur_screen * L["line_h"], 2, L["line_h"] - 2, t["accent"])
    }
    -- status bar
    let sy = y + h - _ED_STATUS_H
    fill_rect(fb, x, sy, w, _ED_STATUS_H, t["surface_elevated"])
    let info = state["name"] + "   Ln " + str(state["cy"] + 1) + ", Col " + str(state["cx"] + 1) + "   " + str(len(state["lines"])) + " lines"
    draw_atlas_text(fb, x + 12, sy + 5, info, atlas, t["foreground_muted"], {"size": 13})
}

fn paint_editor_content(fb, x, y, w, h, theme, focused) {
    paint_editor(fb, x, y, w, h, theme, new_editor(), focused)
}

-- ── Files ───────────────────────────────────────────────
--
-- A navigable virtual filesystem. The tree below is the whole "disk";
-- the app keeps only a current path (a list of folder names) as state,
-- so paint and hit-test both derive the visible rows from the tree. Click
-- a folder to descend, a breadcrumb crumb to jump back up any number of
-- levels, or the "‹ Back" affordance to pop one level.

-- One immutable tree stands in for the KyanOS home directory.
fn _kyan_fs() {
    return {"name": "Home", "dir": true, "children": [
        {"name": "Projects", "dir": true, "children": [
            {"name": "clarity", "dir": true, "children": [
                {"name": "stdlib", "dir": true, "children": [
                    {"name": "kyan_desktop.clarity", "dir": false, "size": "44.3 KB"},
                    {"name": "kyan_apps.clarity", "dir": false, "size": "31.5 KB"},
                    {"name": "graphics.clarity", "dir": false, "size": "10.7 KB"}
                ]},
                {"name": "README.md", "dir": false, "size": "6.1 KB"},
                {"name": "transpile.clarity", "dir": false, "size": "48.2 KB"},
                {"name": "interpreter.clarity", "dir": false, "size": "92.7 KB"}
            ]},
            {"name": "voidrunner", "dir": true, "children": [
                {"name": "sprites", "dir": true, "children": [
                    {"name": "ship.png", "dir": false, "size": "2.4 KB"},
                    {"name": "asteroid.png", "dir": false, "size": "5.1 KB"}
                ]},
                {"name": "game.clarity", "dir": false, "size": "31.0 KB"}
            ]}
        ]},
        {"name": "Documents", "dir": true, "children": [
            {"name": "design-notes.md", "dir": false, "size": "12.4 KB"},
            {"name": "roadmap.md", "dir": false, "size": "4.8 KB"}
        ]},
        {"name": "Pictures", "dir": true, "children": [
            {"name": "wallpaper-obsidian.png", "dir": false, "size": "1.2 MB"},
            {"name": "wallpaper-quartz.png", "dir": false, "size": "1.1 MB"}
        ]},
        {"name": "Music", "dir": true, "children": [
            {"name": "synthwave.flac", "dir": false, "size": "38.2 MB"}
        ]},
        {"name": "theme_kyan.clarity", "dir": false, "size": "8.2 KB"},
        {"name": "notes.txt", "dir": false, "size": "1.1 KB"}
    ]}
}

fn new_files() { return {"path": [], "expanded": {"/": true}, "selected": null} }

-- Human-readable kind for a file, from its extension.
fn _file_kind(name, dir) {
    if dir { return "Folder" }
    if _ends_with(name, ".clarity") { return "Clarity source" }
    if _ends_with(name, ".md")      { return "Markdown" }
    if _ends_with(name, ".txt")     { return "Text" }
    if _ends_with(name, ".png")     { return "PNG image" }
    if _ends_with(name, ".flac")    { return "Audio (FLAC)" }
    if _ends_with(name, ".wall")    { return "Wallpaper" }
    return "File"
}
fn _ends_with(s, suffix) {
    let n = len(s)
    let m = len(suffix)
    if m > n { return false }
    return substring(s, n - m, n) == suffix
}
-- The entry in the current directory matching state["selected"] (or null).
fn _selected_entry(state) {
    if not has(state, "selected") or state["selected"] == null { return null }
    for e in _files_sorted(_files_dir(state)) {
        if e["name"] == state["selected"] { return e }
    }
    return null
}
-- The current folder's name (for the details "Where" row).
fn _where_label(state) {
    let p = state["path"]
    if len(p) == 0 { return "Home" }
    return p[len(p) - 1]
}

-- ── File-tree sidebar helpers ───────────────────────────
-- Path utilities: paths are lists of folder names from the Home root.
fn _path_plus(path, name) {
    mut p = []
    for x in path { push(p, x) }
    push(p, name)
    return p
}
fn _path_key(path) {
    mut s = "/"
    mut i = 0
    while i < len(path) { if i > 0 { s = s + "/" }; s = s + path[i]; i += 1 }
    return s
}
fn _path_eq(a, b) {
    if len(a) != len(b) { return false }
    mut i = 0
    while i < len(a) { if a[i] != b[i] { return false }; i += 1 }
    return true
}
fn _has_subdir(dir) {
    for c in dir["children"] { if c["dir"] { return true } }
    return false
}
fn _is_expanded(state, path) {
    let k = _path_key(path)
    return has(state["expanded"], k) and state["expanded"][k]
}

-- The visible sidebar tree, flattened top-to-bottom: the Home root, then
-- each expanded folder's subfolders (folders only — files show in the main
-- pane). Each row carries its full path, depth, and disclosure state.
fn _files_tree_rows(state) {
    let root = _kyan_fs()
    mut out = [{"name": "Home", "path": [], "depth": 0,
                "has_kids": _has_subdir(root), "expanded": _is_expanded(state, [])}]
    if _is_expanded(state, []) {
        for r in _files_subtree(state, root, [], 1) { push(out, r) }
    }
    return out
}
fn _files_subtree(state, dir, path, depth) {
    mut out = []
    for c in dir["children"] {
        if not c["dir"] { continue }
        let cpath = _path_plus(path, c["name"])
        let expanded = _is_expanded(state, cpath)
        push(out, {"name": c["name"], "path": cpath, "depth": depth,
                   "has_kids": _has_subdir(c), "expanded": expanded})
        if expanded {
            for r in _files_subtree(state, c, cpath, depth + 1) { push(out, r) }
        }
    }
    return out
}

-- Collapse/expand a folder in the sidebar; returns the new state (bool).
fn files_toggle(state, key) {
    let cur = has(state["expanded"], key) and state["expanded"][key]
    state["expanded"][key] = not cur
    return not cur
}

-- Navigate to (select) a folder by full path, revealing it in the tree by
-- expanding every ancestor and the node itself.
fn files_open_path(state, path) {
    mut np = []
    for x in path { push(np, x) }
    state["path"] = np
    mut pre = []
    state["expanded"][_path_key(pre)] = true
    for name in path { push(pre, name); state["expanded"][_path_key(pre)] = true }
    return state
}

-- Find a child node by name inside a directory node (null if absent).
fn _fs_child(dir, name) {
    for c in dir["children"] {
        if c["name"] == name { return c }
    }
    return null
}

-- Walk the current path from the root, returning the directory node it
-- names. A path element that no longer resolves stops the walk at the
-- deepest valid directory (so state can't point off the tree).
fn _files_dir(state) {
    mut node = _kyan_fs()
    for name in state["path"] {
        let nxt = _fs_child(node, name)
        if nxt == null or not nxt["dir"] { return node }
        node = nxt
    }
    return node
}

-- Directory contents, folders first then files, each with a display meta
-- ("N items" for a folder, the size for a file).
fn _files_sorted(dir) {
    mut out = []
    for c in dir["children"] { if c["dir"] { push(out, c) } }
    for c in dir["children"] { if not c["dir"] { push(out, c) } }
    return out
}
fn _entry_meta(e) {
    if e["dir"] { return str(len(e["children"])) + " items" }
    return e["size"]
}

fn files_entries(state) { return _files_sorted(_files_dir(state)) }

-- Descend into a named folder (no-op for a file or unknown name).
fn files_nav(state, name) {
    let dir = _files_dir(state)
    let child = _fs_child(dir, name)
    if child != null and child["dir"] { push(state["path"], name) }
    return state
}

-- Pop one level toward the root.
fn files_up(state) {
    let n = len(state["path"])
    if n > 0 {
        mut np = []
        mut i = 0
        while i < n - 1 { push(np, state["path"][i]); i = i + 1 }
        state["path"] = np
    }
    return state
}

-- Jump to breadcrumb crumb `idx` (0 = Home root; keep the first idx names).
fn files_goto(state, idx) {
    mut np = []
    mut i = 0
    while i < idx and i < len(state["path"]) { push(np, state["path"][i]); i = i + 1 }
    state["path"] = np
    return state
}

-- Crumb labels: "Home" plus each path element.
fn _files_crumbs(state) {
    mut out = ["Home"]
    for name in state["path"] { push(out, name) }
    return out
}

-- Shared geometry so paint and hit-test agree. Returns the breadcrumb
-- crumb rects and the row rects for the current directory.
let _FILES_ROW_H = 26
let _FILES_HEAD_H = 34
let _FILES_SIDEBAR_W = 160
let _FILES_INDENT = 13
let _FILES_DETAILS_W = 190
fn _files_layout(state, x, y, w, h) {
    let atlas = shared_atlas()
    let sb = _FILES_SIDEBAR_W
    -- sidebar: the folder tree, flattened
    mut tree = []
    mut ty = y + _FILES_HEAD_H + 4
    for node in _files_tree_rows(state) {
        let tri_x = x + 10 + node["depth"] * _FILES_INDENT
        push(tree, {"name": node["name"], "path": node["path"], "depth": node["depth"],
                    "has_kids": node["has_kids"], "expanded": node["expanded"],
                    "selected": _path_eq(node["path"], state["path"]),
                    "x": x, "y": ty, "w": sb, "h": _FILES_ROW_H - 2, "tri_x": tri_x})
        ty = ty + _FILES_ROW_H
    }
    -- a details pane is carved off the right when the window is wide enough
    let dw = if w - sb > 340 { _FILES_DETAILS_W } else { 0 }
    let dx = x + w - dw
    -- main pane sits between the sidebar and the details pane
    let mx = x + sb
    let mw = w - sb - dw
    mut crumbs = []
    mut cx = mx + 14
    let cy = y + 10
    let labels = _files_crumbs(state)
    mut i = 0
    for label in labels {
        let cw = measure_atlas_text(atlas, label, 13, 0)[0]
        push(crumbs, {"label": label, "index": i, "x": cx, "y": cy, "w": cw, "h": 16})
        cx = cx + cw + 16   -- room for a "/" separator between crumbs
        i = i + 1
    }
    mut rows = []
    mut ry = y + _FILES_HEAD_H + 6
    for e in _files_sorted(_files_dir(state)) {
        push(rows, {"name": e["name"], "dir": e["dir"], "meta": _entry_meta(e),
                    "x": mx + 6, "y": ry, "w": mw - 12, "h": _FILES_ROW_H - 2})
        ry = ry + _FILES_ROW_H
    }
    return {"crumbs": crumbs, "rows": rows, "tree": tree, "main_x": mx, "main_w": mw,
            "sidebar_w": sb, "details_x": dx, "details_w": dw}
}

-- Hit-test a click. Returns {"kind":"crumb","index"} to jump up the path,
-- {"kind":"row","name","dir"} for a file/folder row, or null.
fn files_hit(state, x, y, w, h, px, py) {
    let lay = _files_layout(state, x, y, w, h)
    -- sidebar tree: the disclosure triangle toggles; the rest selects
    for tr in lay["tree"] {
        if px >= tr["x"] and px < tr["x"] + tr["w"] and py >= tr["y"] and py <= tr["y"] + tr["h"] {
            if tr["has_kids"] and px >= tr["tri_x"] - 3 and px <= tr["tri_x"] + 14 {
                return {"kind": "tree_toggle", "path": tr["path"]}
            }
            return {"kind": "tree_open", "path": tr["path"]}
        }
    }
    for c in lay["crumbs"] {
        if px >= c["x"] - 4 and px <= c["x"] + c["w"] + 4 and py >= c["y"] - 4 and py <= c["y"] + c["h"] + 4 {
            return {"kind": "crumb", "index": c["index"]}
        }
    }
    for r in lay["rows"] {
        if px >= r["x"] and px <= r["x"] + r["w"] and py >= r["y"] and py <= r["y"] + r["h"] {
            return {"kind": "row", "name": r["name"], "dir": r["dir"]}
        }
    }
    return null
}

-- Apply a click to the state: descend into folders, follow breadcrumbs.
-- Returns true if navigation changed the current directory.
fn files_click(state, x, y, w, h, px, py) {
    let hit = files_hit(state, x, y, w, h, px, py)
    if hit == null { return false }
    if hit["kind"] == "tree_toggle" {
        files_toggle(state, _path_key(hit["path"]))
        return true
    }
    if hit["kind"] == "tree_open" {
        state["selected"] = null
        files_open_path(state, hit["path"])
        return true
    }
    if hit["kind"] == "crumb" {
        state["selected"] = null
        let before = len(state["path"])
        files_goto(state, hit["index"])
        return len(state["path"]) != before
    }
    if hit["kind"] == "row" and hit["dir"] {
        -- descend into the folder and reveal it in the sidebar tree
        state["selected"] = null
        files_open_path(state, _path_plus(state["path"], hit["name"]))
        return true
    }
    if hit["kind"] == "row" {
        -- a file row: select it so the details pane can describe it
        state["selected"] = hit["name"]
        return true
    }
    return false
}

fn paint_files(fb, x, y, w, h, theme, state) {
    let t = theme
    let atlas = shared_atlas()
    let lay = _files_layout(state, x, y, w, h)
    let sb = lay["sidebar_w"]
    let mx = lay["main_x"]
    let mw = lay["main_w"]

    -- backgrounds: a slightly darker sidebar, the content surface on the right
    fill_rect(fb, x, y, w, h, t["surface"])
    fill_rect(fb, x, y, sb, h, t["surface_elevated"])
    fill_rect(fb, x + sb - 1, y, 1, h, t["border"])   -- divider

    -- sidebar header
    draw_atlas_text(fb, x + 12, y + 10, "Files", atlas, t["foreground_muted"], {"size": 12})
    fill_rect(fb, x, y + _FILES_HEAD_H - 1, sb, 1, t["border"])

    -- sidebar tree rows
    for tr in lay["tree"] {
        if tr["selected"] {
            rounded_rect(fb, tr["x"] + 4, tr["y"], sb - 8, tr["h"], 6, t["selection"])
        }
        -- disclosure chevron (drawn only when the folder has subfolders)
        if tr["has_kids"] {
            let tx = tr["tri_x"]
            let cyc = tr["y"] + int(tr["h"] / 2)
            let cc = t["foreground_muted"]
            if tr["expanded"] {
                line(fb, tx, cyc - 1, tx + 4, cyc + 3, cc)
                line(fb, tx + 4, cyc + 3, tx + 8, cyc - 1, cc)
            } else {
                line(fb, tx + 1, cyc - 4, tx + 5, cyc, cc)
                line(fb, tx + 5, cyc, tx + 1, cyc + 4, cc)
            }
        }
        -- folder swatch + name (indented)
        let nx = tr["tri_x"] + 14
        let sel = tr["selected"]
        let icol = if sel { t["accent"] } else { t["accent_secondary"] }
        fill_rect(fb, nx, tr["y"] + 6, 11, 9, icol)
        let ncol = if sel { t["foreground"] } else { t["ink_soft"] }
        draw_atlas_text(fb, nx + 17, tr["y"] + 3, tr["name"], atlas, ncol, {"size": 13})
    }

    -- main-pane breadcrumb header
    fill_rect(fb, mx, y, mw, _FILES_HEAD_H, t["surface_elevated"])
    fill_rect(fb, mx, y + _FILES_HEAD_H - 1, mw, 1, t["border"])
    let last = len(lay["crumbs"]) - 1
    mut ci = 0
    for c in lay["crumbs"] {
        let col = if ci == last { t["foreground"] } else { t["accent"] }
        draw_atlas_text(fb, c["x"], c["y"], c["label"], atlas, col, {"size": 13})
        if ci != last {
            draw_atlas_text(fb, c["x"] + c["w"] + 5, c["y"], "/", atlas, t["foreground_muted"], {"size": 13})
        }
        ci = ci + 1
    }

    -- directory rows (main pane)
    for r in lay["rows"] {
        if has(state, "selected") and r["name"] == state["selected"] {
            rounded_rect(fb, r["x"], r["y"] - 2, r["w"], r["h"] + 4, 6, t["selection"])
        }
        let ic = if r["dir"] { t["accent_secondary"] } else { t["accent"] }
        fill_rect(fb, r["x"] + 6, r["y"] + 6, 12, 10, ic)
        draw_atlas_text(fb, r["x"] + 26, r["y"] + 3, r["name"], atlas, t["foreground"], {"size": 15})
        let mtw = measure_atlas_text(atlas, r["meta"], 14, 0)[0]
        draw_atlas_text(fb, mx + mw - mtw - 14, r["y"] + 4, r["meta"], atlas, t["foreground_muted"], {"size": 14})
    }

    -- empty-folder hint
    if len(lay["rows"]) == 0 {
        draw_atlas_text(fb, mx + 20, y + _FILES_HEAD_H + 14, "This folder is empty", atlas, t["foreground_muted"], {"size": 14})
    }

    -- details / preview pane on the right
    let dw = lay["details_w"]
    if dw > 0 {
        let dx = lay["details_x"]
        fill_rect(fb, dx, y, dw, h, t["surface_elevated"])
        fill_rect(fb, dx, y, 1, h, t["border"])       -- divider
        draw_atlas_text(fb, dx + 16, y + 10, "Details", atlas, t["foreground_muted"], {"size": 12})
        fill_rect(fb, dx, y + _FILES_HEAD_H - 1, dw, 1, t["border"])
        let sel = _selected_entry(state)
        let px2 = dx + 16
        if sel == null {
            draw_atlas_text(fb, px2, y + _FILES_HEAD_H + 20, "Select a file to see", atlas, t["foreground_muted"], {"size": 13})
            draw_atlas_text(fb, px2, y + _FILES_HEAD_H + 38, "its details here.", atlas, t["foreground_muted"], {"size": 13})
        } else {
            let pw2 = dw - 32
            let pvy = y + _FILES_HEAD_H + 16
            let pvh = 88
            let kind = _file_kind(sel["name"], sel["dir"])
            -- preview: gradient for images, a document glyph otherwise
            if _ends_with(sel["name"], ".png") or _ends_with(sel["name"], ".wall") {
                linear_gradient(fb, px2, pvy, pw2, pvh, [
                    {"t": 0.0, "color": 0xFF22D3EE}, {"t": 1.0, "color": 0xFF7C3AED}], "h")
            } else {
                rounded_rect(fb, px2, pvy, pw2, pvh, 10, t["surface"])
                rounded_rect(fb, px2 + int(pw2 / 2) - 15, pvy + 20, 30, 44, 4, t["accent"])
            }
            -- name + info rows
            draw_atlas_text(fb, px2, pvy + pvh + 14, sel["name"], atlas, t["foreground"], {"size": 15})
            mut dyy = pvy + pvh + 42
            let info = [["Kind", kind], ["Size", _entry_meta(sel)], ["Where", _where_label(state)]]
            for row in info {
                draw_atlas_text(fb, px2, dyy, row[0], atlas, t["foreground_muted"], {"size": 12})
                draw_atlas_text(fb, px2, dyy + 15, row[1], atlas, t["foreground"], {"size": 13})
                dyy = dyy + 40
            }
        }
    }
}

fn paint_files_content(fb, x, y, w, h, theme, focused) {
    paint_files(fb, x, y, w, h, theme, new_files())
}

-- ── System Monitor ─────────────────────────────────────

-- Live System Monitor state. Values drift over time via monitor_tick so
-- the app reads as a real, updating monitor rather than a static mock.
-- A tiny LCG keeps the drift deterministic (seed lives in the state), so
-- tests can advance it and assert exact behaviour.
fn new_monitor() {
    return {
        "_seed": 1234567,
        "cpu":   0.42,                                        -- 0..1 overall load
        "cores": [0.32, 0.58, 0.24, 0.71, 0.44, 0.63, 0.38, 0.52],
        "mem_used":  6.2, "mem_total": 16.0,                  -- GB
        "procs": [
            {"name": "clarity-init", "cpu": 2.4,  "mem": "38 MB"},
            {"name": "compositor",   "cpu": 6.1,  "mem": "72 MB"},
            {"name": "prism",        "cpu": 11.7, "mem": "144 MB"},
            {"name": "voidrunner",   "cpu": 18.3, "mem": "96 MB"},
            {"name": "terminal",     "cpu": 0.9,  "mem": "24 MB"}
        ]
    }
}

fn _mon_rand(state) {
    -- LCG → a float in [0, 1)
    state["_seed"] = (state["_seed"] * 1103515245 + 12345) % 2147483648
    return (state["_seed"] % 1000) / 1000.0
}
fn _clampf(v, lo, hi) { if v < lo { return lo }; if v > hi { return hi }; return v }
fn _mon_fmt1(x) { return str(round(x, 1)) }

-- Advance the monitor: nudge the overall load, each core, memory, and each
-- process's CPU by a small random walk. `dt` is accepted for parity with
-- other live apps; the walk is per-tick.
fn monitor_tick(state, dt) {
    state["cpu"] = _clampf(state["cpu"] + (_mon_rand(state) - 0.5) * 0.10, 0.03, 0.99)
    mut cores = []
    for c in state["cores"] { push(cores, _clampf(c + (_mon_rand(state) - 0.5) * 0.22, 0.04, 0.99)) }
    state["cores"] = cores
    state["mem_used"] = _clampf(state["mem_used"] + (_mon_rand(state) - 0.5) * 0.3, 2.0, state["mem_total"])
    for p in state["procs"] { p["cpu"] = _clampf(p["cpu"] + (_mon_rand(state) - 0.5) * 2.4, 0.1, 60.0) }
    return state
}

fn _stat_card(fb, x, y, w, h, t, atlas, label, value) {
    rounded_rect(fb, x, y, w, h, 10, t["surface_elevated"])
    fill_rect(fb, x, y, w, 3, t["accent"])
    draw_atlas_text(fb, x + 12, y + 10, label, atlas, t["foreground_muted"], {"size": 12, "tracking": 1})
    draw_atlas_text(fb, x + 12, y + 24, value, atlas, 0xFFFFFFFF, {"size": 24})
}

fn paint_monitor(fb, x, y, w, h, theme, state) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, t["surface"])
    let pad = 16

    -- two stat cards up top, reading the live state
    let cw = int((w - pad * 3) / 2)
    _stat_card(fb, x + pad, y + pad, cw, 58, t, atlas, "CPU LOAD", str(int(state["cpu"] * 100)) + "%")
    _stat_card(fb, x + pad * 2 + cw, y + pad, cw, 58, t, atlas, "MEMORY",
               _mon_fmt1(state["mem_used"]) + " / " + str(int(state["mem_total"])) + " GB")

    -- CPU core bar graph
    let cores = state["cores"]
    let gy = y + pad + 58 + 16
    let gh = 74
    rounded_rect(fb, x + pad, gy, w - pad * 2, gh, 10, t["surface_elevated"])
    draw_atlas_text(fb, x + pad + 12, gy + 8, "CORES", atlas, t["foreground_muted"], {"size": 11, "tracking": 1})
    let bars = len(cores)
    let inner = w - pad * 2 - 24
    let bw = int(inner / bars) - 6
    let base_y = gy + gh - 12
    let max_h = gh - 30
    mut i = 0
    while i < bars {
        let bx = x + pad + 12 + i * (bw + 6)
        let bh = int(cores[i] * max_h)
        fill_rect(fb, bx, gy + 24, bw, max_h, t["surface"])
        linear_gradient(fb, bx, base_y - bh, bw, bh, [
            {"t": 0.0, "color": 0xFF22D3EE},
            {"t": 1.0, "color": 0xFF7C3AED}
        ], "v")
        i = i + 1
    }

    -- process list (CPU% is live, formatted from the drifting float)
    let py0 = gy + gh + 16
    draw_atlas_text(fb, x + pad, py0, "PROCESSES", atlas, t["foreground_muted"], {"size": 11, "tracking": 1})
    mut py = py0 + 18
    mut r = 0
    for p in state["procs"] {
        if py + 22 > y + h { break }
        if r % 2 == 1 { fill_rect(fb, x + pad, py - 3, w - pad * 2, 22, t["surface_elevated"]) }
        fill_rect(fb, x + pad + 4, py + 4, 6, 6, t["accent"])
        draw_atlas_text(fb, x + pad + 18, py, p["name"], atlas, t["foreground"], {"size": 14})
        let cpu_str = _mon_fmt1(p["cpu"]) + "%"
        let cpuw = measure_atlas_text(atlas, cpu_str, 14, 0)[0]
        draw_atlas_text(fb, x + w - pad - 90 - cpuw, py, cpu_str, atlas, t["accent"], {"size": 14})
        let memw = measure_atlas_text(atlas, p["mem"], 14, 0)[0]
        draw_atlas_text(fb, x + w - pad - memw, py, p["mem"], atlas, t["foreground_muted"], {"size": 14})
        py = py + 24
        r = r + 1
    }
}

-- Registry/fallback wrapper: a fresh (static-snapshot) monitor.
fn paint_monitor_content(fb, x, y, w, h, theme, focused) {
    paint_monitor(fb, x, y, w, h, theme, new_monitor())
}

-- ── Settings ────────────────────────────────────────────

let _SWATCHES = [
    {"id": "obsidian", "name": "Obsidian", "a": 0xFF7C3AED, "b": 0xFF22D3EE},
    {"id": "quartz",   "name": "Quartz",   "a": 0xFFE5E7FF, "b": 0xFF9AB6FF},
    {"id": "meadow",   "name": "Meadow",   "a": 0xFF34D399, "b": 0xFF0EA5E9},
    {"id": "midnight", "name": "Midnight", "a": 0xFF818CF8, "b": 0xFF0B1120}
]
-- pref keys (in row order) + their labels
let _TOGGLE_KEYS = ["frosted", "animations", "reduce_motion", "dock_labels"]
let _TOGGLE_LABELS = ["Frosted glass", "Window animations", "Reduce motion", "Show dock labels"]

-- Default desktop preferences.
fn new_prefs() {
    return {"frosted": true, "animations": true, "reduce_motion": false, "dock_labels": false,
            "theme": "obsidian", "section": "appearance"}
}

-- Settings sidebar categories. Appearance is interactive (theme + toggles);
-- the rest are informational panes that reflect live system/desktop state.
let _SETTINGS_SECTIONS = [
    {"id": "appearance", "label": "Appearance"},
    {"id": "display",    "label": "Display"},
    {"id": "network",    "label": "Network"},
    {"id": "sound",      "label": "Sound"},
    {"id": "about",      "label": "About"}
]

fn _settings_section(prefs) {
    if prefs != null and has(prefs, "section") { return prefs["section"] }
    return "appearance"
}

-- Sidebar row rects, shared by paint and hit-test.
fn _settings_sidebar(x, y, sw) {
    mut rows = []
    mut sy = y + 16
    mut i = 0
    for sec in _SETTINGS_SECTIONS {
        push(rows, {"id": sec["id"], "label": sec["label"], "index": i,
                    "x": x + 10, "y": sy - 3, "w": sw - 20, "h": 24})
        sy = sy + 30
        i = i + 1
    }
    return rows
}

fn _toggle(fb, x, y, t, on) {
    let tw = 40
    let th = 22
    let track = if on { t["accent"] } else { t["border"] }
    rounded_rect(fb, x, y, tw, th, 11, track)
    let knob = if on { x + tw - th + 3 } else { x + 3 }
    rounded_rect(fb, knob, y + 3, th - 6, th - 6, 8, 0xFFFFFFFF)
}

-- Shared layout for the Appearance pane: swatch cards + toggle rows.
fn _settings_layout(x, y, w, h) {
    let sw = 132
    let mx = x + sw + 20
    let mw = w - sw - 40
    let cols = 4
    let gap = 12
    let cwid = int((mw - (cols - 1) * gap) / cols)
    let chh = 58
    let cy = y + 60
    mut swatches = []
    mut c = 0
    while c < cols {
        push(swatches, {"index": c, "x": mx + c * (cwid + gap), "y": cy, "w": cwid, "h": chh})
        c = c + 1
    }
    mut toggles = []
    mut ty = y + 60 + chh + 20
    mut i = 0
    while i < len(_TOGGLE_KEYS) {
        push(toggles, {"index": i, "x": mx, "y": ty, "w": mw, "h": 30})
        ty = ty + 40
        i = i + 1
    }
    return {"sw": sw, "mx": mx, "mw": mw, "swatches": swatches, "toggles": toggles}
}

-- Hit-test the Appearance pane. Returns {"kind":"theme","id":..} or
-- {"kind":"toggle","key":..} or null.
fn settings_hit(x, y, w, h, px, py, ...rest) {
    let prefs = if len(rest) > 0 { rest[0] } else { null }
    let L = _settings_layout(x, y, w, h)
    -- sidebar categories switch the active pane
    for row in _settings_sidebar(x, y, L["sw"]) {
        if px >= row["x"] and px < row["x"] + row["w"] and py >= row["y"] and py < row["y"] + row["h"] {
            return {"kind": "section", "id": row["id"]}
        }
    }
    -- the Appearance pane's controls are only live when it's showing
    if _settings_section(prefs) == "appearance" {
        for s in L["swatches"] {
            if px >= s["x"] and px < s["x"] + s["w"] and py >= s["y"] and py < s["y"] + s["h"] {
                return {"kind": "theme", "id": _SWATCHES[s["index"]]["id"]}
            }
        }
        for tg in L["toggles"] {
            if px >= tg["x"] and px < tg["x"] + tg["w"] and py >= tg["y"] and py < tg["y"] + tg["h"] {
                return {"kind": "toggle", "key": _TOGGLE_KEYS[tg["index"]]}
            }
        }
    }
    return null
}

fn paint_settings(fb, x, y, w, h, theme, prefs) {
    let t = theme
    let atlas = shared_atlas()
    let L = _settings_layout(x, y, w, h)
    let sw = L["sw"]
    let section = _settings_section(prefs)
    fill_rect(fb, x, y, w, h, t["surface"])
    fill_rect(fb, x, y, sw, h, t["surface_elevated"])
    fill_rect(fb, x + sw - 1, y, 1, h, t["border"])
    -- sidebar categories; the active one is highlighted
    for row in _settings_sidebar(x, y, sw) {
        if row["id"] == section {
            rounded_rect(fb, row["x"], row["y"], row["w"], row["h"], 6, t["accent_tertiary"])
            draw_atlas_text(fb, row["x"] + 10, row["y"] + 4, row["label"], atlas, 0xFFFFFFFF, {"size": 14})
        } else {
            draw_atlas_text(fb, row["x"] + 10, row["y"] + 4, row["label"], atlas, t["foreground_muted"], {"size": 14})
        }
    }
    let mx = L["mx"]
    let mw = L["mw"]
    if mw < 40 { return null }
    -- pane title + body for the active section
    let title = _section_title(section)
    draw_atlas_text(fb, mx, y + 16, title, atlas, t["foreground"], {"size": 20})
    if section == "appearance" {
        _paint_appearance(fb, x, y, w, h, t, atlas, L, prefs)
    } else {
        _paint_info_pane(fb, mx, y, mw, atlas, t, _section_rows(section, prefs))
    }
}

fn _section_title(section) {
    for sec in _SETTINGS_SECTIONS { if sec["id"] == section { return sec["label"] } }
    return "Settings"
}

fn _paint_appearance(fb, x, y, w, h, t, atlas, L, prefs) {
    let mx = L["mx"]
    let mw = L["mw"]
    draw_atlas_text(fb, mx, y + 44, "THEME", atlas, t["foreground_muted"], {"size": 11, "tracking": 1})
    for s in L["swatches"] {
        let sw_meta = _SWATCHES[s["index"]]
        linear_gradient(fb, s["x"], s["y"], s["w"], s["h"] - 18, [
            {"t": 0.0, "color": sw_meta["a"]},
            {"t": 1.0, "color": sw_meta["b"]}
        ], "h")
        if prefs["theme"] == sw_meta["id"] {
            rounded_rect(fb, s["x"] + s["w"] - 20, s["y"] + 4, 14, 14, 7, 0xFF05060A)
            fill_rect(fb, s["x"] + s["w"] - 15, s["y"] + 10, 3, 3, t["accent"])
        }
        draw_atlas_text(fb, s["x"] + 2, s["y"] + s["h"] - 14, sw_meta["name"], atlas, t["foreground"], {"size": 13})
    }
    for tg in L["toggles"] {
        if tg["y"] + 30 > y + h { break }
        draw_atlas_text(fb, mx, tg["y"] + 3, _TOGGLE_LABELS[tg["index"]], atlas, t["foreground"], {"size": 15})
        _toggle(fb, mx + mw - 40, tg["y"], t, prefs[_TOGGLE_KEYS[tg["index"]]])
        fill_rect(fb, mx, tg["y"] + 30, mw, 1, t["border"])
    }
}

-- A read-only pane: rows of label / value pairs under the pane title.
fn _paint_info_pane(fb, mx, y, mw, atlas, t, rows) {
    mut ry = y + 56
    for row in rows {
        draw_atlas_text(fb, mx, ry, row[0], atlas, t["foreground_muted"], {"size": 14})
        let vw = measure_atlas_text(atlas, row[1], 15, 0)[0]
        draw_atlas_text(fb, mx + mw - vw, ry - 1, row[1], atlas, t["foreground"], {"size": 15})
        fill_rect(fb, mx, ry + 26, mw, 1, t["border"])
        ry = ry + 40
    }
}

-- Values for the informational panes. Reflect live desktop/theme state
-- where there is any; otherwise the honest current capability.
fn _section_rows(section, prefs) {
    let theme_name = if prefs != null and has(prefs, "theme") { prefs["theme"] } else { "obsidian" }
    if section == "display" {
        return [["Resolution", "1280 × 800"], ["Scale", "1x (native)"],
                ["Color profile", "sRGB"], ["Compositor", "software framebuffer"]]
    }
    if section == "network" {
        return [["Status", "Connected"], ["Interface", "user-mode (QEMU)"],
                ["IPv4", "10.0.2.15"], ["DNS", "10.0.2.3"]]
    }
    if section == "sound" {
        return [["Output", "Software mixer"], ["Volume", "72%"],
                ["Sample rate", "48.0 kHz"], ["Muted", "No"]]
    }
    -- about
    let vib = if prefs != null and has(prefs, "frosted") and prefs["frosted"] { "On" } else { "Off" }
    let anim = if prefs != null and has(prefs, "animations") and prefs["animations"] { "On" } else { "Off" }
    return [["System", "KyanOS 1.0"], ["Identity", "Obsidian & neon"],
            ["Kernel", "Zig microkernel"], ["Userspace", "Clarity (self-hosted)"],
            ["Theme", theme_name], ["Vibrancy", vib], ["Animations", anim]]
}

-- Registry/fallback wrapper: renders with default prefs.
fn paint_settings_content(fb, x, y, w, h, theme, focused) {
    paint_settings(fb, x, y, w, h, theme, new_prefs())
}

-- ── Calculator ──────────────────────────────────────────

-- ASCII operator labels — the atlas font only covers ASCII 32-126, so
-- ÷ × − ± would render as blank keys. / * - read clearly and are the same
-- symbols a keyboard sends anyway.
let _CALC_KEYS = [
    ["C", "+/-", "%", "/"],
    ["7", "8", "9", "*"],
    ["4", "5", "6", "-"],
    ["1", "2", "3", "+"],
    ["0", ".", "="]
]

-- Scientific keypad (6 wide): trig, logs, powers, roots, constants, and
-- memory on the left; the numeric pad on the right. Shown when the calc is
-- in scientific mode (toggled by the "mode" pill in the display).
let _CALC_KEYS_SCI = [
    ["sin", "cos", "tan", "C",   "+/-", "%"],
    ["ln",  "log", "^",   "7",   "8",   "9"],
    ["sqrt",   "x^2",  "1/x", "4",   "5",   "6"],
    ["pi",   "e",   "mr",  "1",   "2",   "3"],
    ["mc",  "m+",  "m-",  "0",   ".",   "="]
]

fn _is_op(k) {
    return k == "/" or k == "*" or k == "-" or k == "+" or k == "=" or k == "^"
}
fn _is_fn(k) {
    return k == "C" or k == "+/-" or k == "%" or k == "mode"
        or k == "sin" or k == "cos" or k == "tan" or k == "ln" or k == "log"
        or k == "sqrt" or k == "x^2" or k == "1/x" or k == "pi" or k == "e"
        or k == "mr" or k == "mc" or k == "m+" or k == "m-"
}

-- Unary scientific functions apply to the current display value at once.
fn _is_unary(k) {
    return k == "sin" or k == "cos" or k == "tan" or k == "ln" or k == "log"
        or k == "sqrt" or k == "x^2" or k == "1/x"
}
fn _calc_unary(k, v) {
    if k == "sin" { return sin(v) }
    if k == "cos" { return cos(v) }
    if k == "tan" { return tan(v) }
    if k == "ln"  { return log(v) }
    if k == "log" { return log(v) / log(10.0) }
    if k == "sqrt"   { return sqrt(v) }
    if k == "x^2"  { return v * v }
    if k == "1/x" { if v == 0.0 { return 0.0 } return 1.0 / v }
    return v
}

-- ── Calculator state machine ────────────────────────────

fn new_calc() {
    return {"display": "0", "expr": "", "acc": 0.0, "op": "", "fresh": true, "mem": 0.0, "sci": false}
}

fn _calc_num(s) {
    if s == "Error" or s == "" or s == "." { return 0.0 }
    return float(s)
}

fn _calc_fmt(n) {
    if n == int(n) and abs(n) < 1000000000000.0 { return str(int(n)) }
    return str(n)
}

fn _calc_compute(a, op, b) {
    if op == "+" { return a + b }
    if op == "-" { return a - b }
    if op == "*" { return a * b }
    if op == "/" { if b == 0.0 { return 0.0 } return a / b }
    if op == "^" { return pow(a, b) }
    return b
}

-- Apply a keypress to the calculator state (mutates and returns it).
fn calc_press(s, key) {
    if key == "C" {
        s["display"] = "0"; s["expr"] = ""; s["acc"] = 0.0; s["op"] = ""; s["fresh"] = true
        return s
    }
    -- mode toggle: basic ⇄ scientific keypad
    if key == "mode" { s["sci"] = not s["sci"]; return s }
    -- memory
    if key == "mc" { s["mem"] = 0.0; return s }
    if key == "mr" { s["display"] = _calc_fmt(s["mem"]); s["fresh"] = true; return s }
    if key == "m+" { s["mem"] = s["mem"] + _calc_num(s["display"]); s["fresh"] = true; return s }
    if key == "m-" { s["mem"] = s["mem"] - _calc_num(s["display"]); s["fresh"] = true; return s }
    -- constants
    if key == "pi" { s["display"] = _calc_fmt(3.141592653589793); s["fresh"] = true; return s }
    if key == "e" { s["display"] = _calc_fmt(2.718281828459045); s["fresh"] = true; return s }
    -- unary scientific functions apply to the current value immediately
    if _is_unary(key) {
        s["display"] = _calc_fmt(_calc_unary(key, _calc_num(s["display"])))
        s["fresh"] = true
        return s
    }
    if key == "+/-" { s["display"] = _calc_fmt(0.0 - _calc_num(s["display"])); return s }
    if key == "%" { s["display"] = _calc_fmt(_calc_num(s["display"]) / 100.0); return s }
    if key == "." {
        if s["fresh"] { s["display"] = "0."; s["fresh"] = false }
        elif not contains(s["display"], ".") { s["display"] = s["display"] + "." }
        return s
    }
    if _is_op(key) and key != "=" {
        if s["op"] != "" and not s["fresh"] {
            let r = _calc_compute(s["acc"], s["op"], _calc_num(s["display"]))
            s["acc"] = r; s["display"] = _calc_fmt(r)
        } else {
            s["acc"] = _calc_num(s["display"])
        }
        s["op"] = key; s["fresh"] = true
        s["expr"] = _calc_fmt(s["acc"]) + " " + key
        return s
    }
    if key == "=" {
        if s["op"] != "" {
            let r = _calc_compute(s["acc"], s["op"], _calc_num(s["display"]))
            s["expr"] = _calc_fmt(s["acc"]) + " " + s["op"] + " " + s["display"] + " ="
            s["display"] = _calc_fmt(r); s["acc"] = r; s["op"] = ""; s["fresh"] = true
        }
        return s
    }
    -- a digit
    if s["fresh"] { s["display"] = key; s["fresh"] = false }
    elif s["display"] == "0" { s["display"] = key }
    else { s["display"] = s["display"] + key }
    return s
}

-- Keypad geometry: the single source of truth shared by paint and the
-- desktop's hit-test. Returns a list of {"key","x","y","w","h"}.
fn _calc_layout(x, y, w, h, ...rest) {
    let sci = len(rest) > 0 and rest[0]
    let keys = if sci { _CALC_KEYS_SCI } else { _CALC_KEYS }
    let pad = 14
    let disp_h = 74
    let gy = y + disp_h + 6
    let gh = h - disp_h - pad - 6
    -- column count = the widest row, so basic (4) and scientific (6) both fit
    mut cols = 0
    for row in keys { if len(row) > cols { cols = len(row) } }
    let rows = len(keys)
    let gap = 8
    let kw = int((w - pad * 2 - (cols - 1) * gap) / cols)
    let kh = int((gh - (rows - 1) * gap) / rows)
    mut cells = []
    -- mode toggle pill, tucked in the display area's top-left
    push(cells, {"key": "mode", "x": x + pad, "y": y + 12, "w": 46, "h": 22})
    mut r = 0
    for row in keys {
        mut c = 0
        for k in row {
            let span = if k == "0" and not sci { 2 } else { 1 }
            let kx = x + pad + c * (kw + gap)
            let ky = gy + r * (kh + gap)
            let kwid = kw * span + (span - 1) * gap
            push(cells, {"key": k, "x": kx, "y": ky, "w": kwid, "h": kh})
            c = c + span
        }
        r = r + 1
    }
    return cells
}

-- Which key (if any) is under (px,py) for a calc at (x,y,w,h). The optional
-- trailing arg is the calc state (for scientific-mode layout); omitting it
-- hit-tests the basic keypad.
fn calc_key_at(x, y, w, h, px, py, ...rest) {
    let s = if len(rest) > 0 { rest[0] } else { null }
    let sci = s != null and has(s, "sci") and s["sci"]
    for cell in _calc_layout(x, y, w, h, sci) {
        if px >= cell["x"] and px < cell["x"] + cell["w"] and py >= cell["y"] and py < cell["y"] + cell["h"] {
            return cell["key"]
        }
    }
    return null
}

fn paint_calc(fb, x, y, w, h, theme, state) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, 0xFF0B0E16)
    let pad = 14
    -- display: pending expression (small) + current value (big, right-aligned)
    let expr = state["expr"]
    if len(expr) > 0 {
        draw_atlas_text(fb, x + w - pad - measure_atlas_text(atlas, expr, 14, 0)[0], y + 16, expr, atlas, t["foreground_muted"], {"size": 14})
    }
    let big = state["display"]
    let bw = measure_atlas_text(atlas, big, 40, 0)[0]
    draw_atlas_text(fb, x + w - pad - bw, y + 30, big, atlas, 0xFFFFFFFF, {"size": 40})
    -- memory indicator: a small "M" when a value is stored
    let sci = has(state, "sci") and state["sci"]
    if has(state, "mem") and state["mem"] != 0.0 {
        draw_atlas_text(fb, x + pad + 54, y + 16, "M", atlas, t["accent"], {"size": 13})
    }
    -- keypad + the mode-toggle pill (sci-aware layout)
    let ksize = if sci { 16 } else { 20 }
    for cell in _calc_layout(x, y, w, h, sci) {
        let k = cell["key"]
        if k == "mode" {
            -- a small pill; label shows the mode you switch to
            rounded_rect(fb, cell["x"], cell["y"], cell["w"], cell["h"], 11, t["surface"])
            let ml = if sci { "123" } else { "sci" }
            let mlw = measure_atlas_text(atlas, ml, 12, 0)[0]
            draw_atlas_text(fb, cell["x"] + int(cell["w"] / 2) - int(mlw / 2), cell["y"] + 5, ml, atlas, t["accent"], {"size": 12})
            continue
        }
        mut bgc = t["surface_elevated"]
        if _is_op(k) { bgc = t["accent"] }
        elif _is_fn(k) { bgc = t["surface"] }
        rounded_rect(fb, cell["x"], cell["y"], cell["w"], cell["h"], 10, bgc)
        let kcol = if _is_op(k) { 0xFF05060A } else { if _is_fn(k) { t["foreground_muted"] } else { 0xFFFFFFFF } }
        let lw = measure_atlas_text(atlas, k, ksize, 0)[0]
        draw_atlas_text(fb, cell["x"] + int(cell["w"] / 2) - int(lw / 2), cell["y"] + int(cell["h"] / 2) - int(ksize / 2), k, atlas, kcol, {"size": ksize})
    }
}

-- Registry/fallback wrapper: a fresh calculator (shows 0).
fn paint_calc_content(fb, x, y, w, h, theme, focused) {
    paint_calc(fb, x, y, w, h, theme, new_calc())
}

-- ── Registry ────────────────────────────────────────────

fn app_painters() {
    return {
        "prism": paint_prism_content,
        "terminal": paint_terminal_content,
        "files": paint_files_content,
        "monitor": paint_monitor_content,
        "settings": paint_settings_content,
        "calc": paint_calc_content,
        "editor": paint_editor_content
    }
}
