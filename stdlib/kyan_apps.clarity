-- KyanOS app content painters — rebrand phase K4.
--
-- Each painter draws an app's UI into a window's content rectangle
-- (chrome is drawn by KyanDesktop). Signature: (fb, x, y, w, h,
-- theme, focused). Built entirely from the K2 renderer primitives —
-- gradients, glass, scalable text — so they look like the identity.
--
-- Prism is the flagship: the game hub where you play games built in
-- Clarity and (later) build your own.

from "draw.clarity" import fill_rect, rounded_rect, rounded_rect_blend, linear_gradient, line
from "font.clarity" import builtin_font, draw_text, draw_text_scaled, draw_text_smooth, measure_text
from "atlas_font.clarity" import shared_atlas, draw_atlas_text, measure_atlas_text
from "graphics.clarity" import rgba
from "theme_kyan.clarity" import kyan_gradient_stops

-- ── Prism — the game hub ────────────────────────────────

let _GAME_ARTS = [
    [{"t": 0.0, "color": 0xFF7C3AED}, {"t": 1.0, "color": 0xFF22D3EE}],
    [{"t": 0.0, "color": 0xFFFB7185}, {"t": 1.0, "color": 0xFF4F46E5}],
    [{"t": 0.0, "color": 0xFF0EA5E9}, {"t": 1.0, "color": 0xFF34D399}],
    [{"t": 0.0, "color": 0xFFFBBF24}, {"t": 1.0, "color": 0xFF7C3AED}]
]
let _GAME_NAMES = ["Hexfield", "Orbit Decay", "Verdant", "Ash Fable"]
let _GAME_META = ["Strategy", "Arcade", "Puzzle", "RPG"]

-- Absolute rect of the "Play" pill given Prism's content origin/size.
-- Shared by paint_prism and the desktop's content-click hit-test.
fn prism_play_rect(x, y, w, h) {
    return [x + 168, y + 104, 90, 24]
}

fn paint_prism(fb, x, y, w, h, theme, focused) {
    let t = theme
    let atlas = shared_atlas()
    -- sidebar
    let sw = 132
    fill_rect(fb, x, y, sw, h, t["surface_elevated"])
    fill_rect(fb, x + sw - 1, y, 1, h, t["border"])
    _prism_head(fb, x + 14, y + 14, "PLAY", t, atlas)
    _prism_item(fb, x + 10, y + 32, sw - 20, "Library", t, atlas, true)
    _prism_item(fb, x + 10, y + 56, sw - 20, "Store", t, atlas, false)
    _prism_item(fb, x + 10, y + 80, sw - 20, "Friends", t, atlas, false)
    _prism_head(fb, x + 14, y + 110, "BUILD", t, atlas)
    _prism_item(fb, x + 10, y + 128, sw - 20, "Forge", t, atlas, false)
    _prism_item(fb, x + 10, y + 152, sw - 20, "Assets", t, atlas, false)

    -- main column
    let mx = x + sw + 18
    let mw = w - sw - 36
    if mw < 40 { return null }
    -- featured card
    let fh = 120
    let fy = y + 18
    linear_gradient(fb, mx, fy, mw, fh, [
        {"t": 0.0, "color": 0xFF131022},
        {"t": 1.0, "color": 0xFF0B2440}
    ], "h")
    -- a signature bloom across the top of the card
    linear_gradient(fb, mx, fy, mw, 3, kyan_gradient_stops(), "h")
    draw_atlas_text(fb, mx + 18, fy + 14, "FEATURED - BUILT IN CLARITY", atlas, t["accent"], {"size": 12, "tracking": 1})
    draw_atlas_text(fb, mx + 18, fy + 32, "Voidrunner", atlas, 0xFFFFFFFF, {"size": 30})
    draw_atlas_text(fb, mx + 18, fy + 70, "Outrun the collapse of a dying star system.", atlas, t["foreground_muted"], {"size": 14})
    -- play pill (geometry shared with the desktop's click hit-test)
    let pr = prism_play_rect(x, y, w, h)
    rounded_rect(fb, pr[0], pr[1], pr[2], pr[3], 8, t["accent"])
    draw_atlas_text(fb, pr[0] + 14, pr[1] + 4, "> Play", atlas, 0xFF05060A, {"size": 15})

    -- game grid
    let gy = fy + fh + 18
    let cols = 4
    let gap = 12
    let cw = int((mw - (cols - 1) * gap) / cols)
    let ch = 96
    mut i = 0
    while i < cols {
        let gx = mx + i * (cw + gap)
        if gy + ch < y + h {
            _prism_game(fb, gx, gy, cw, ch, i, t, atlas)
        }
        i = i + 1
    }
}

fn _prism_head(fb, x, y, text, t, atlas) {
    draw_atlas_text(fb, x, y, text, atlas, t["foreground_muted"], {"size": 12, "tracking": 1})
}

fn _prism_item(fb, x, y, w, text, t, atlas, active) {
    if active {
        rounded_rect(fb, x, y, w, 20, 6, t["accent_tertiary"])
        draw_atlas_text(fb, x + 10, y + 3, text, atlas, 0xFFFFFFFF, {"size": 14})
    } else {
        draw_atlas_text(fb, x + 10, y + 3, text, atlas, t["foreground_muted"], {"size": 14})
    }
}

fn _prism_game(fb, x, y, w, h, idx, t, atlas) {
    let art_h = h - 26
    linear_gradient(fb, x, y, w, art_h, _GAME_ARTS[idx], "h")
    draw_atlas_text(fb, x + 4, y + art_h + 2, _GAME_NAMES[idx], atlas, t["foreground"], {"size": 14})
    draw_atlas_text(fb, x + 4, y + art_h + 16, _GAME_META[idx], atlas, t["foreground_muted"], {"size": 12})
}

-- ── Terminal ────────────────────────────────────────────

fn paint_terminal_content(fb, x, y, w, h, theme, focused) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, 0xFF05060A)
    let lines = [
        "kyan > clarity os build",
        "-> kernel: zig build ... ok",
        "-> runtime: native vm ... ok",
        "-> iso: kyanos-1.1.iso (238 MB) ok",
        "kyan > clarity test stdlib/",
        "42 passed, 0 failed"
    ]
    mut ly = y + 10
    for ln in lines {
        let col = if char_at(ln, 0) == "k" { t["accent"] } else { t["foreground_muted"] }
        draw_atlas_text(fb, x + 12, ly, ln, atlas, col, {"size": 15})
        ly = ly + 20
    }
    -- cursor block
    fill_rect(fb, x + 12, ly + 2, 8, 13, t["accent"])
}

-- ── Files ───────────────────────────────────────────────

let _FILE_ROWS = [
    {"name": "clarity", "meta": "173 items", "dir": true},
    {"name": "kyanos-themes", "meta": "12 items", "dir": true},
    {"name": "theme_kyan.clarity", "meta": "8.2 KB", "dir": false},
    {"name": "prism_library.clarity", "meta": "14.6 KB", "dir": false},
    {"name": "voidrunner.clarity", "meta": "31.0 KB", "dir": false}
]

fn paint_files_content(fb, x, y, w, h, theme, focused) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, t["surface"])
    mut ry = y + 10
    mut i = 0
    for row in _FILE_ROWS {
        if i == 1 { fill_rect(fb, x + 6, ry - 3, w - 12, 24, t["accent_tertiary"]) }
        let ic = if row["dir"] { t["accent_secondary"] } else { t["accent"] }
        fill_rect(fb, x + 12, ry + 3, 12, 10, ic)
        let name_col = if i == 1 { 0xFFFFFFFF } else { t["foreground"] }
        draw_atlas_text(fb, x + 32, ry, row["name"], atlas, name_col, {"size": 15})
        let mw = measure_atlas_text(atlas, row["meta"], 14, 0)[0]
        draw_atlas_text(fb, x + w - mw - 14, ry + 1, row["meta"], atlas, t["foreground_muted"], {"size": 14})
        ry = ry + 26
        i = i + 1
    }
}

-- ── System Monitor ─────────────────────────────────────

let _CPU_BARS = [0.32, 0.58, 0.24, 0.71, 0.44, 0.63, 0.38, 0.52]
let _PROCS = [
    {"name": "clarity-init", "cpu": "2.4%", "mem": "38 MB"},
    {"name": "compositor",   "cpu": "6.1%", "mem": "72 MB"},
    {"name": "prism",        "cpu": "11.7%", "mem": "144 MB"},
    {"name": "voidrunner",   "cpu": "18.3%", "mem": "96 MB"},
    {"name": "terminal",     "cpu": "0.9%", "mem": "24 MB"}
]

fn _stat_card(fb, x, y, w, h, t, atlas, label, value) {
    rounded_rect(fb, x, y, w, h, 10, t["surface_elevated"])
    fill_rect(fb, x, y, w, 3, t["accent"])
    draw_atlas_text(fb, x + 12, y + 10, label, atlas, t["foreground_muted"], {"size": 12, "tracking": 1})
    draw_atlas_text(fb, x + 12, y + 24, value, atlas, 0xFFFFFFFF, {"size": 24})
}

fn paint_monitor_content(fb, x, y, w, h, theme, focused) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, t["surface"])
    let pad = 16

    -- two stat cards up top
    let cw = int((w - pad * 3) / 2)
    _stat_card(fb, x + pad, y + pad, cw, 58, t, atlas, "CPU LOAD", "47%")
    _stat_card(fb, x + pad * 2 + cw, y + pad, cw, 58, t, atlas, "MEMORY", "6.2 / 16 GB")

    -- CPU core bar graph
    let gy = y + pad + 58 + 16
    let gh = 74
    rounded_rect(fb, x + pad, gy, w - pad * 2, gh, 10, t["surface_elevated"])
    draw_atlas_text(fb, x + pad + 12, gy + 8, "CORES", atlas, t["foreground_muted"], {"size": 11, "tracking": 1})
    let bars = len(_CPU_BARS)
    let inner = w - pad * 2 - 24
    let bw = int(inner / bars) - 6
    let base_y = gy + gh - 12
    let max_h = gh - 30
    mut i = 0
    while i < bars {
        let bx = x + pad + 12 + i * (bw + 6)
        let bh = int(_CPU_BARS[i] * max_h)
        fill_rect(fb, bx, gy + 24, bw, max_h, t["surface"])
        linear_gradient(fb, bx, base_y - bh, bw, bh, [
            {"t": 0.0, "color": 0xFF22D3EE},
            {"t": 1.0, "color": 0xFF7C3AED}
        ], "v")
        i = i + 1
    }

    -- process list
    let py0 = gy + gh + 16
    draw_atlas_text(fb, x + pad, py0, "PROCESSES", atlas, t["foreground_muted"], {"size": 11, "tracking": 1})
    mut py = py0 + 18
    mut r = 0
    for p in _PROCS {
        if py + 22 > y + h { break }
        if r % 2 == 1 { fill_rect(fb, x + pad, py - 3, w - pad * 2, 22, t["surface_elevated"]) }
        fill_rect(fb, x + pad + 4, py + 4, 6, 6, t["accent"])
        draw_atlas_text(fb, x + pad + 18, py, p["name"], atlas, t["foreground"], {"size": 14})
        let cpuw = measure_atlas_text(atlas, p["cpu"], 14, 0)[0]
        draw_atlas_text(fb, x + w - pad - 90 - cpuw, py, p["cpu"], atlas, t["accent"], {"size": 14})
        let memw = measure_atlas_text(atlas, p["mem"], 14, 0)[0]
        draw_atlas_text(fb, x + w - pad - memw, py, p["mem"], atlas, t["foreground_muted"], {"size": 14})
        py = py + 24
        r = r + 1
    }
}

-- ── Settings ────────────────────────────────────────────

let _THEME_SWATCHES = [
    {"name": "Obsidian", "a": 0xFF7C3AED, "b": 0xFF22D3EE},
    {"name": "Quartz",   "a": 0xFFE5E7FF, "b": 0xFF9AB6FF},
    {"name": "Meadow",   "a": 0xFF34D399, "b": 0xFF0EA5E9},
    {"name": "Midnight", "a": 0xFF4F46E5, "b": 0xFF0B1120}
]
let _TOGGLES = [
    {"label": "Frosted glass", "on": true},
    {"label": "Window animations", "on": true},
    {"label": "Reduce motion", "on": false},
    {"label": "Show dock labels", "on": false}
]

fn _toggle(fb, x, y, t, on) {
    let tw = 40
    let th = 22
    let track = if on { t["accent"] } else { t["border"] }
    rounded_rect(fb, x, y, tw, th, 11, track)
    let knob = if on { x + tw - th + 3 } else { x + 3 }
    rounded_rect(fb, knob, y + 3, th - 6, th - 6, 8, 0xFFFFFFFF)
}

fn paint_settings_content(fb, x, y, w, h, theme, focused) {
    let t = theme
    let atlas = shared_atlas()
    let sw = 132
    fill_rect(fb, x, y, w, h, t["surface"])
    fill_rect(fb, x, y, sw, h, t["surface_elevated"])
    fill_rect(fb, x + sw - 1, y, 1, h, t["border"])
    let items = ["Appearance", "Display", "Network", "Sound", "About"]
    mut sy = y + 16
    mut i = 0
    for it in items {
        if i == 0 {
            rounded_rect(fb, x + 10, sy - 3, sw - 20, 24, 6, t["accent_tertiary"])
            draw_atlas_text(fb, x + 20, sy, it, atlas, 0xFFFFFFFF, {"size": 14})
        } else {
            draw_atlas_text(fb, x + 20, sy, it, atlas, t["foreground_muted"], {"size": 14})
        }
        sy = sy + 28
        i = i + 1
    }

    let mx = x + sw + 20
    let mw = w - sw - 40
    if mw < 40 { return null }
    draw_atlas_text(fb, mx, y + 16, "Appearance", atlas, t["foreground"], {"size": 20})
    draw_atlas_text(fb, mx, y + 44, "THEME", atlas, t["foreground_muted"], {"size": 11, "tracking": 1})

    -- theme swatches
    let cols = 4
    let gap = 12
    let cwid = int((mw - (cols - 1) * gap) / cols)
    let chh = 58
    mut c = 0
    while c < cols {
        let cx = mx + c * (cwid + gap)
        let cy = y + 60
        linear_gradient(fb, cx, cy, cwid, chh - 18, [
            {"t": 0.0, "color": _THEME_SWATCHES[c]["a"]},
            {"t": 1.0, "color": _THEME_SWATCHES[c]["b"]}
        ], "h")
        if c == 0 {
            rounded_rect(fb, cx + cwid - 20, cy + 4, 14, 14, 7, 0xFF05060A)
            fill_rect(fb, cx + cwid - 15, cy + 10, 3, 3, t["accent"])
        }
        draw_atlas_text(fb, cx + 2, cy + chh - 14, _THEME_SWATCHES[c]["name"], atlas, t["foreground"], {"size": 13})
        c = c + 1
    }

    -- toggle rows
    mut ty = y + 60 + chh + 20
    for tg in _TOGGLES {
        if ty + 30 > y + h { break }
        draw_atlas_text(fb, mx, ty + 3, tg["label"], atlas, t["foreground"], {"size": 15})
        _toggle(fb, mx + mw - 40, ty, t, tg["on"])
        fill_rect(fb, mx, ty + 30, mw, 1, t["border"])
        ty = ty + 40
    }
}

-- ── Calculator ──────────────────────────────────────────

let _CALC_KEYS = [
    ["C", "±", "%", "÷"],
    ["7", "8", "9", "×"],
    ["4", "5", "6", "−"],
    ["1", "2", "3", "+"],
    ["0", ".", "="]
]

fn _is_op(k) {
    return k == "÷" or k == "×" or k == "−" or k == "+" or k == "="
}
fn _is_fn(k) {
    return k == "C" or k == "±" or k == "%"
}

fn paint_calc_content(fb, x, y, w, h, theme, focused) {
    let t = theme
    let atlas = shared_atlas()
    fill_rect(fb, x, y, w, h, 0xFF0B0E16)
    let pad = 14

    -- display
    let disp_h = 74
    draw_atlas_text(fb, x + w - pad - measure_atlas_text(atlas, "128 x 8 +", 14, 0)[0], y + 16, "128 x 8 +", atlas, t["foreground_muted"], {"size": 14})
    let big = "1,024"
    let bw = measure_atlas_text(atlas, big, 40, 0)[0]
    draw_atlas_text(fb, x + w - pad - bw, y + 30, big, atlas, 0xFFFFFFFF, {"size": 40})

    -- keypad
    let gy = y + disp_h + 6
    let gh = h - disp_h - pad - 6
    let cols = 4
    let rows = 5
    let gap = 8
    let kw = int((w - pad * 2 - (cols - 1) * gap) / cols)
    let kh = int((gh - (rows - 1) * gap) / rows)
    mut r = 0
    for row in _CALC_KEYS {
        mut c = 0
        for k in row {
            -- the "0" key spans two columns on the last row
            let span = if k == "0" { 2 } else { 1 }
            let kx = x + pad + c * (kw + gap)
            let ky = gy + r * (kh + gap)
            let kwid = kw * span + (span - 1) * gap
            mut bgc = t["surface_elevated"]
            if _is_op(k) { bgc = t["accent"] }
            elif _is_fn(k) { bgc = t["surface"] }
            rounded_rect(fb, kx, ky, kwid, kh, 10, bgc)
            let kcol = if _is_op(k) { 0xFF05060A } else { if _is_fn(k) { t["foreground_muted"] } else { 0xFFFFFFFF } }
            let lw = measure_atlas_text(atlas, k, 20, 0)[0]
            draw_atlas_text(fb, kx + int(kwid / 2) - int(lw / 2), ky + int(kh / 2) - 12, k, atlas, kcol, {"size": 20})
            c = c + span
        }
        r = r + 1
    }
}

-- ── Registry ────────────────────────────────────────────

fn app_painters() {
    return {
        "prism": paint_prism,
        "terminal": paint_terminal_content,
        "files": paint_files_content,
        "monitor": paint_monitor_content,
        "settings": paint_settings_content,
        "calc": paint_calc_content
    }
}
