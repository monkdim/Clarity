-- Font — bitmap font loading and text rendering.
--
-- A Font is a fixed-size monospace bitmap: every glyph is `width` x
-- `height` pixels, encoded as one byte per row. Bit 7 (the MSB) is the
-- leftmost pixel; rows are top-to-bottom.
--
-- Two ways to get one:
--   1. builtin_font()        — small embedded 8x8 ASCII font (digits,
--                              uppercase, lowercase, basic punctuation)
--   2. load_psf(path)         — read a PSF v1 binary font from disk
--                              (the format used by Linux console fonts)
--
-- Render with:
--   draw_text(fb, x, y, text, font, color)
--   measure_text(font, text)   → [width, height]

from "ffi.clarity" import Pointer
from "draw.clarity" import fill_rect_blend

class Font {
    fn init(width, height, glyphs) {
        this.width = width
        this.height = height
        -- glyphs is a map from string(char_code) → list of `height` row bytes
        this.glyphs = glyphs
    }

    fn has_glyph(code) {
        return has(this.glyphs, str(code))
    }

    fn glyph(code) {
        let key = str(code)
        if has(this.glyphs, key) { return this.glyphs[key] }
        return null
    }
}

-- ── measure_text / draw_text ────────────────────────────

fn measure_text(font, text) {
    return [len(text) * font.width, font.height]
}

fn draw_text(fb, x, y, text, font, color) {
    let fw = font.width
    let fh = font.height
    -- Floor the origin so a fractional coord can't misalign the writes.
    let bx = int(x)
    let by = int(y)
    let chs = chars(text)
    mut col_offset = 0
    mut i = 0
    while i < len(chs) {
        let code = char_code(chs[i])
        let glyph = font.glyph(code)
        if glyph != null {
            mut row = 0
            while row < fh {
                let byte = glyph[row]
                mut bit = 0
                while bit < fw {
                    let mask = 1 << (fw - 1 - bit)
                    if (byte & mask) != 0 {
                        fb.put_pixel(bx + col_offset + bit, by + row, color)
                    }
                    bit += 1
                }
                row += 1
            }
        }
        col_offset += fw
        i += 1
    }
}

-- ── Scaled text ─────────────────────────────────────────
--
-- The builtin font is a single 8x8 strike, so headings and the
-- wordmark render each set bit as a `scale`×`scale` block — crisp
-- integer-scaled text at any size (2x, 3x, 4x …) without a second
-- font. `tracking` adds extra pixels of letter-spacing (in device
-- pixels). Translucent colours composite; opaque colours take the
-- fast rect fill.

fn measure_text_scaled(font, text, scale, tracking) {
    let s = if scale == null or scale < 1 { 1 } else { scale }
    let track = if tracking == null { 0 } else { tracking }
    let n = len(text)
    if n == 0 { return [0, 0] }
    return [n * font.width * s + (n - 1) * track, font.height * s]
}

fn draw_text_scaled(fb, x, y, text, font, color, scale, tracking) {
    let s = if scale == null or scale < 1 { 1 } else { scale }
    let track = if tracking == null { 0 } else { tracking }
    let fw = font.width
    let fh = font.height
    let sa = int(color / 16777216) & 0xFF
    -- Floor the origin: fractional pixel coords would make the u32
    -- colour writes land on a non-4-byte boundary and scramble channels.
    let by = int(y)
    let chs = chars(text)
    mut cx = int(x)
    mut i = 0
    while i < len(chs) {
        let code = char_code(chs[i])
        let glyph = font.glyph(code)
        if glyph != null {
            mut row = 0
            while row < fh {
                let byte = glyph[row]
                mut bit = 0
                while bit < fw {
                    let mask = 1 << (fw - 1 - bit)
                    if (byte & mask) != 0 {
                        let px = cx + bit * s
                        let py = by + row * s
                        if sa == 255 { fb.fill_rect(px, py, s, s, color) }
                        else { fill_rect_blend(fb, px, py, s, s, color) }
                    }
                    bit += 1
                }
                row += 1
            }
        }
        cx += fw * s + track
        i += 1
    }
    return cx - x
}

-- ── Built-in 8x8 ASCII font ─────────────────────────────
--
-- Public-domain 8x8 monospace bitmap. Each row is a byte, MSB on the
-- left. Covers space (0x20), digits, uppercase A-Z, lowercase a-z, and
-- a handful of punctuation. Characters not in the table render as
-- blanks of the same metrics.

let _BUILTIN_GLYPHS = {
    "32":  [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],   -- ' '
    "33":  [0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00],   -- '!'
    "34":  [0x36, 0x36, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],   -- '"'
    "35":  [0x36, 0x36, 0x7F, 0x36, 0x7F, 0x36, 0x36, 0x00],   -- '#'
    "36":  [0x18, 0x3E, 0x60, 0x3C, 0x06, 0x7C, 0x18, 0x00],   -- '$'
    "37":  [0x66, 0x6C, 0x18, 0x30, 0x66, 0x66, 0x00, 0x00],   -- '%'
    "38":  [0x38, 0x6C, 0x68, 0x76, 0x6C, 0x6E, 0x36, 0x00],   -- '&'
    "39":  [0x18, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],   -- '''
    "40":  [0x0C, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0C, 0x00],   -- '('
    "41":  [0x30, 0x18, 0x0C, 0x0C, 0x0C, 0x18, 0x30, 0x00],   -- ')'
    "42":  [0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00],   -- '*'
    "43":  [0x00, 0x18, 0x18, 0x7E, 0x18, 0x18, 0x00, 0x00],   -- '+'
    "44":  [0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30],   -- ','
    "45":  [0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00],   -- '-'
    "46":  [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x00],   -- '.'
    "47":  [0x06, 0x0C, 0x18, 0x30, 0x60, 0xC0, 0x80, 0x00],   -- '/'
    "48":  [0x3C, 0x66, 0x6E, 0x76, 0x66, 0x66, 0x3C, 0x00],   -- '0'
