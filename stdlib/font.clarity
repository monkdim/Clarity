    "125": [0x70, 0x18, 0x18, 0x0E, 0x18, 0x18, 0x70, 0x00],   -- '}'
    "126": [0x76, 0xDC, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]    -- '~'
}

fn builtin_font() {
    return Font(8, 8, _BUILTIN_GLYPHS)
}

-- ── PSF v1 loader ───────────────────────────────────────
--
-- The Linux console PSF v1 format is famously tiny:
--   offset 0   2 bytes magic   0x36 0x04
--   offset 2   1 byte  flags   (mode: 0/1/2/3 — bits we ignore for now)
--   offset 3   1 byte  height  (== width is always 8 in v1)
--   offset 4+  256 glyphs, each `height` bytes.

fn load_psf(path) {
    let h = _ffi_read_buffer(path)
    let p = Pointer(h)
    if h.size < 4 {
        throw "FontError: " + path + " is too small to be a PSF font"
    }
    if p.read_u8(0) != 0x36 or p.read_u8(1) != 0x04 {
        throw "FontError: " + path + " is not a PSF v1 font (magic mismatch)"
    }
    let height = p.read_u8(3)
    if height == 0 or height > 32 {
        throw "FontError: " + path + " has implausible height " + str(height)
    }
    -- v1 always has 256 glyphs at 8 pixels wide.
    let needed = 4 + 256 * height
    if h.size < needed {
        throw "FontError: " + path + " truncated (need " + str(needed) + " bytes, have " + str(h.size) + ")"
    }
    mut glyphs = {}
    mut code = 0
    while code < 256 {
        mut rows = []
        mut r = 0
        while r < height {
            push(rows, p.read_u8(4 + code * height + r))
            r += 1
        }
        glyphs[str(code)] = rows
        code += 1
    }
    return Font(8, height, glyphs)
}
