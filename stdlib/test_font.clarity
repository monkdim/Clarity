-- Font / draw_text tests — Phase 57 task 3.

from "graphics.clarity" import framebuffer, BLACK, WHITE
from "font.clarity" import Font, builtin_font, draw_text, measure_text, load_psf
from "ffi.clarity" import alloc, Pointer

mut PASSED = 0
mut FAILED = 0

fn assert(val, msg) {
    if val { PASSED += 1 } else { FAILED += 1; show "  FAIL: " + msg }
}

fn assert_eq(actual, expected, msg) {
    if actual == expected {
        PASSED += 1
    } else {
        FAILED += 1
        show "  FAIL: {msg} (expected {expected}, got {actual})"
    }
}

-- ── builtin_font basics ────────────────────────────────

show "-- Font: builtin_font --"

let font = builtin_font()
assert_eq(font.width, 8, "builtin font width")
assert_eq(font.height, 8, "builtin font height")
assert(font.has_glyph(65), "has 'A'")
assert(font.has_glyph(48), "has '0'")
assert(font.has_glyph(32), "has space")
assert(not font.has_glyph(0), "missing NUL")
assert(not font.has_glyph(200), "missing high byte")

let A = font.glyph(65)
assert_eq(len(A), 8, "glyph has height rows")
-- Row 0 of 'A' is 0x18 — an MSB-justified bit pattern: ...##... — 2 set bits in cols 3,4
assert_eq(A[0], 0x18, "A row 0")
-- Row 4 has the crossbar — 0x7E (six set bits, cols 1..6)
assert_eq(A[4], 0x7E, "A crossbar row")

-- ── measure_text ────────────────────────────────────────

show "-- Font: measure_text --"

let m1 = measure_text(font, "Hi")
assert_eq(m1[0], 16, "measure 2 chars wide")
assert_eq(m1[1], 8, "measure height")
let m_empty = measure_text(font, "")
assert_eq(m_empty[0], 0, "empty width")
assert_eq(m_empty[1], 8, "empty still has height")

-- ── draw_text renders the right pixels ─────────────────

show "-- Font: draw_text basic 'A' --"

let fb = framebuffer(32, 16)
fb.clear(BLACK)
draw_text(fb, 0, 0, "A", font, WHITE)

-- Row 0 of 'A' is 0x18 == 0b00011000 — pixels at columns 3 and 4 lit, MSB first.
assert_eq(fb.get_pixel(0, 0), BLACK, "A row 0 col 0 dim")
assert_eq(fb.get_pixel(2, 0), BLACK, "A row 0 col 2 dim")
assert_eq(fb.get_pixel(3, 0), WHITE, "A row 0 col 3 lit")
assert_eq(fb.get_pixel(4, 0), WHITE, "A row 0 col 4 lit")
assert_eq(fb.get_pixel(5, 0), BLACK, "A row 0 col 5 dim")

-- Row 4 (crossbar) of 'A' is 0x7E: cols 1..6 lit
mut col = 1
while col <= 6 {
    assert_eq(fb.get_pixel(col, 4), WHITE, "A crossbar col " + str(col))
    col += 1
}
assert_eq(fb.get_pixel(0, 4), BLACK, "A crossbar leftmost dim")
assert_eq(fb.get_pixel(7, 4), BLACK, "A crossbar rightmost dim")

-- ── draw_text advances 8 px per char ───────────────────

show "-- Font: draw_text 'AB' --"

fb.clear(BLACK)
draw_text(fb, 0, 0, "AB", font, WHITE)
-- 'B' starts at column 8. Row 0 of 'B' is 0x7C: cols 1..5 lit, 6 dim.
assert_eq(fb.get_pixel(8 + 1, 0), WHITE, "B col 1 lit")
assert_eq(fb.get_pixel(8 + 5, 0), WHITE, "B col 5 lit")
assert_eq(fb.get_pixel(8 + 6, 0), BLACK, "B col 6 dim")

-- ── Unknown char renders blank without crashing ────────

show "-- Font: missing glyphs are blanks --"

fb.clear(BLACK)
let with_missing = "A" + from_char_code(1) + "B"
draw_text(fb, 0, 0, with_missing, font, WHITE)
-- Char at index 1 (code 1) has no glyph. It should still consume font.width
-- pixels of horizontal space, so 'B' lands at column 16.
assert_eq(fb.get_pixel(16 + 1, 0), WHITE, "B is at expected column despite missing glyph in middle")
-- The blank gap (cols 8..15) should be entirely BLACK.
mut bx = 8
mut all_blank = true
while bx < 16 {
    if fb.get_pixel(bx, 0) != BLACK { all_blank = false }
    bx += 1
}
assert(all_blank, "missing glyph leaves a blank")

-- ── PSF v1 loader round-trip ───────────────────────────
-- Build a synthetic PSF v1 file in memory, write it out, parse it back.

show "-- Font: PSF v1 round-trip --"

let psf_height = 4
let psf_size = 4 + 256 * psf_height  -- 1028 bytes
let psf_buf = alloc(psf_size)
psf_buf.write_u8(0, 0x36)
psf_buf.write_u8(1, 0x04)
psf_buf.write_u8(2, 0)        -- mode flags (none)
psf_buf.write_u8(3, psf_height)

-- Glyph for 'A' (code 65): row pattern 0x18, 0x24, 0x3C, 0x24
let synth_a = [0x18, 0x24, 0x3C, 0x24]
mut r = 0
while r < psf_height {
    psf_buf.write_u8(4 + 65 * psf_height + r, synth_a[r])
    r += 1
}

let psf_path = "/tmp/_clarity_test_font.psf"
_ffi_write_buffer(psf_buf._handle, psf_path)

let loaded = load_psf(psf_path)
assert_eq(loaded.width, 8, "psf width")
assert_eq(loaded.height, psf_height, "psf height")
let loaded_a = loaded.glyph(65)
assert_eq(len(loaded_a), psf_height, "loaded A row count")
assert_eq(loaded_a[0], 0x18, "loaded A row 0")
assert_eq(loaded_a[1], 0x24, "loaded A row 1")
assert_eq(loaded_a[2], 0x3C, "loaded A row 2")
assert_eq(loaded_a[3], 0x24, "loaded A row 3")

-- Render with the loaded font on a fresh framebuffer.
let fb2 = framebuffer(16, 8)
fb2.clear(BLACK)
draw_text(fb2, 0, 0, "A", loaded, WHITE)
assert_eq(fb2.get_pixel(3, 0), WHITE, "loaded glyph row 0 col 3")
assert_eq(fb2.get_pixel(4, 0), WHITE, "loaded glyph row 0 col 4")
assert_eq(fb2.get_pixel(2, 2), WHITE, "loaded glyph row 2 col 2")

exec("rm -f " + psf_path)

-- ── PSF errors ──────────────────────────────────────────

show "-- Font: PSF v1 errors --"

let bad_path = "/tmp/_clarity_test_font_bad.psf"
let bad = alloc(8)
bad.write_u8(0, 0x00)  -- wrong magic
bad.write_u8(1, 0x00)
_ffi_write_buffer(bad._handle, bad_path)
mut threw = false
try { load_psf(bad_path) } catch e { threw = true }
assert(threw, "bad magic throws")
exec("rm -f " + bad_path)

-- ── Summary ─────────────────────────────────────────────

show ""
show "Font: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " font test(s) failed" }
