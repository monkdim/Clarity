-- Clarity IDE — Phase 69 task 1.
--
-- Multi-file project workspace with:
--   * Project tree    file/dir state mirrored from disk
--   * Editor buffers  one TextBuffer per open file, dirty flag
--   * Tabs            ordered list, active index
--   * LSP             diagnostics + hover + completions per buffer
--   * Terminal        embedded Terminal engine
--   * Debugger UI     Breakpoint set + step state machine
--   * Output panel    multi-channel log stream
--   * Git              status/diff/commit/push state
--
-- The widget tree the desktop mounts paints this state; the engine
-- is testable on its own.

from "app_editor.clarity" import TextBuffer
from "app_terminal.clarity" import Terminal

let CHANNEL_BUILD = "build"
let CHANNEL_TEST = "test"
let CHANNEL_RUN = "run"
let CHANNEL_LSP = "lsp"
let CHANNEL_GIT = "git"

let DEBUGGER_IDLE = "idle"
let DEBUGGER_RUNNING = "running"
let DEBUGGER_PAUSED = "paused"
let DEBUGGER_DONE = "done"

-- ── Project tree ─────────────────────────────────

class ProjectTreeNode {
    fn init(name, path, is_dir) {
        this.name = name
        this.path = path
        this.is_dir = is_dir
        this.children = []
        this.expanded = false
    }
}

class ProjectTree {
    fn init(root_path) {
        this.root_path = root_path
        this.root = ProjectTreeNode(_basename(root_path), root_path, true)
        this.root.expanded = true
    }

    fn refresh() {
        this._scan(this.root)
        return this.root
    }

    fn _scan(node) {
        if not node.is_dir { return }
        let r = exec_full("ls -1A '" + node.path + "' 2>/dev/null")
        if r.exit_code != 0 { return }
        let raw = split(trim(r.stdout), "\n")
        mut existing_by_name = {}
        for c in node.children { existing_by_name[c.name] = c }
        mut next = []
        for line in raw {
            let name = trim(line)
            if len(name) == 0 { continue }
            let path = node.path + "/" + name
            let is_dir = _is_dir(path)
            mut child = if has(existing_by_name, name) { existing_by_name[name] } else { ProjectTreeNode(name, path, is_dir) }
            child.is_dir = is_dir
            push(next, child)
        }
        node.children = next
    }

    fn expand(path) {
        let n = this._find(path)
        if n == null or not n.is_dir { return false }
        n.expanded = true
        this._scan(n)
        return true
    }

    fn collapse(path) {
        let n = this._find(path)
        if n == null { return false }
        n.expanded = false
        return true
    }

    fn _find(path) { return this._find_rec(this.root, path) }
    fn _find_rec(node, path) {
        if node.path == path { return node }
        for c in node.children {
            let r = this._find_rec(c, path)
            if r != null { return r }
        }
        return null
    }

    -- Visit all expanded paths (DFS pre-order) — what the UI paints.
    fn visible() {
        mut out = []
        this._visit(this.root, 0, out)
        return out
    }
    fn _visit(node, depth, out) {
        push(out, {"path": node.path, "name": node.name, "is_dir": node.is_dir, "depth": depth, "expanded": node.expanded})
        if node.is_dir and node.expanded {
            for c in node.children { this._visit(c, depth + 1, out) }
        }
    }
}

fn project_tree(root) { return ProjectTree(root) }

fn _basename(path) {
    let parts = split(path, "/")
    if len(parts) == 0 { return path }
    let last = parts[len(parts) - 1]
    if len(last) == 0 and len(parts) >= 2 { return parts[len(parts) - 2] }
    return last
}

fn _is_dir(path) {
    let r = exec_full("test -d '" + path + "' && echo yes || echo no")
    return trim(r.stdout) == "yes"
}

-- ── Editor buffers ───────────────────────────────

class IdeBuffer {
    fn init(path) {
        this.path = path
        this.buffer = TextBuffer()
        this.dirty = false
        this.diagnostics = []
        this.last_saved = 0
        if exists(path) {
            this.buffer.load(read(path))
            this.last_saved = time()
        }
    }

    fn save() {
        write(this.path, this.buffer.to_text())
        this.dirty = false
        this.last_saved = time()
    }

    fn mark_dirty() { this.dirty = true }

    fn revert() {
        if not exists(this.path) { return false }
        this.buffer.load(read(this.path))
        this.dirty = false
        return true
    }
}

fn ide_buffer(path) { return IdeBuffer(path) }

-- ── Debugger state ──────────────────────────────

class IdeBreakpoint {
    fn init(path, line) {
        this.path = path
        this.line = line
        this.enabled = true
        this.condition = null
    }
}

class IdeDebuggerState {
    fn init() {
        this.state = DEBUGGER_IDLE
        this.breakpoints = []
        this.current = null    -- {path, line}
        this.frames = []
        this.watches = []
        this.last_error = null
    }

    fn add_breakpoint(path, line) {
        for b in this.breakpoints {
            if b.path == path and b.line == line { return false }
        }
        push(this.breakpoints, IdeBreakpoint(path, line))
        return true
    }

    fn remove_breakpoint(path, line) {
        mut next = []
        mut removed = false
        for b in this.breakpoints {
            if b.path == path and b.line == line { removed = true }
            else { push(next, b) }
        }
        this.breakpoints = next
        return removed
    }

    -- Returns the new state: true if a breakpoint is now set at
    -- (path, line), false if it was removed.
    fn toggle_breakpoint(path, line) {
        if this.remove_breakpoint(path, line) { return false }
        this.add_breakpoint(path, line)
        return true
    }

    fn add_watch(expr) {
        for w in this.watches { if w == expr { return false } }
        push(this.watches, expr)
        return true
    }

    fn remove_watch(expr) {
        mut next = []
        for w in this.watches { if w != expr { push(next, w) } }
        this.watches = next
    }

    fn start(path, line) {
        this.state = DEBUGGER_RUNNING
        this.current = {"path": path, "line": line}
        this.frames = [{"name": "main", "path": path, "line": line, "locals": {}}]
        this.last_error = null
    }

    fn pause(line) {
        this.state = DEBUGGER_PAUSED
        if this.current != null { this.current["line"] = line }
        if len(this.frames) > 0 { this.frames[0]["line"] = line }
    }

    fn resume() {
        if this.state == DEBUGGER_PAUSED { this.state = DEBUGGER_RUNNING }
    }

    fn step() {
        if this.state != DEBUGGER_PAUSED { return false }
        if this.current != null { this.current["line"] = this.current["line"] + 1 }
        return true
    }

    fn stop() {
        this.state = DEBUGGER_DONE
        this.current = null
    }
}

fn debugger_state() { return IdeDebuggerState() }

-- ── Output panel ────────────────────────────────

class IdeOutputPanel {
    fn init() {
        this.channels = {}
        this.active = CHANNEL_BUILD
    }

    fn append(channel, line) {
        if not has(this.channels, channel) { this.channels[channel] = [] }
        push(this.channels[channel], {"ts": time(), "text": line})
    }

    fn clear(channel) {
        if has(this.channels, channel) { this.channels[channel] = [] }
    }

    fn lines(channel) {
        if not has(this.channels, channel) { return [] }
        return this.channels[channel]
    }

    fn switch_to(channel) { this.active = channel }
}

fn output_panel() { return IdeOutputPanel() }

-- ── Git pane ─────────────────────────────────────

class IdeGitPane {
    fn init(repo_root) {
        this.repo_root = repo_root
        this.status = []        -- list of {path, code} where code is M/A/D/?
        this.staged = []
        this.branch = ""
        this.last_commit_msg = ""
    }

    fn refresh() {
        let r = exec_full("cd '" + this.repo_root + "' && git status --porcelain 2>/dev/null")
        mut entries = []
        for line in split(r.stdout, "\n") {
            if len(line) < 3 { continue }
            push(entries, {"code": substring(line, 0, 2), "path": substring(line, 3, len(line))})
        }
        this.status = entries
        let br = exec_full("cd '" + this.repo_root + "' && git branch --show-current 2>/dev/null")
        this.branch = trim(br.stdout)
        return entries
    }

    fn stage(path) {
        for s in this.staged { if s == path { return false } }
        push(this.staged, path)
        return true
    }

    fn unstage(path) {
        mut next = []
        for s in this.staged { if s != path { push(next, s) } }
        this.staged = next
    }

    fn diff(path) {
        let r = exec_full("cd '" + this.repo_root + "' && git diff -- '" + path + "' 2>/dev/null")
        return r.stdout
    }
}

fn git_pane(root) { return IdeGitPane(root) }

-- ── IDE app ──────────────────────────────────

class Ide {
    fn init(root_path) {
        this.root_path = root_path
        this.tree = project_tree(root_path)
        this.buffers = []           -- list of IdeBuffer
        this.tabs = []              -- list of paths (== buffer paths)
        this.active_tab = -1
        this.terminal = Terminal()
        this.debugger = debugger_state()
        this.output = output_panel()
        this.git = git_pane(root_path)
        this.lsp_handlers = {}      -- file extension -> LSP backend
    }

    -- ── Buffer management ───────────────────────

    fn open(path) {
        for i in 0..len(this.buffers) {
            if this.buffers[i].path == path {
                this.active_tab = i
                return this.buffers[i]
            }
        }
        let b = ide_buffer(path)
        push(this.buffers, b)
        push(this.tabs, path)
        this.active_tab = len(this.buffers) - 1
        return b
    }

    fn close(path) {
        mut idx = -1
        for i in 0..len(this.buffers) {
            if this.buffers[i].path == path { idx = i; break }
        }
        if idx < 0 { return false }
        mut next_b = []
        mut next_t = []
        for i in 0..len(this.buffers) {
            if i != idx { push(next_b, this.buffers[i]); push(next_t, this.tabs[i]) }
        }
        this.buffers = next_b
        this.tabs = next_t
        if this.active_tab >= len(this.buffers) { this.active_tab = len(this.buffers) - 1 }
        return true
    }

    fn select(path) {
        for i in 0..len(this.buffers) {
            if this.buffers[i].path == path { this.active_tab = i; return true }
        }
        return false
    }

    fn active_buffer() {
        if this.active_tab < 0 or this.active_tab >= len(this.buffers) { return null }
        return this.buffers[this.active_tab]
    }

    fn save_active() {
        let b = this.active_buffer()
        if b == null { return false }
        b.save()
        return true
    }

    fn save_all() {
        mut count = 0
        for b in this.buffers {
            if b.dirty { b.save(); count = count + 1 }
        }
        return count
    }

    fn dirty_count() {
        mut n = 0
        for b in this.buffers { if b.dirty { n = n + 1 } }
        return n
    }

    -- ── LSP integration ────────────────────────

    fn register_lsp(extension, backend) {
        this.lsp_handlers[extension] = backend
    }

    fn check_active() {
        let b = this.active_buffer()
        if b == null { return [] }
        let ext = _ext(b.path)
        if not has(this.lsp_handlers, ext) { return [] }
        let backend = this.lsp_handlers[ext]
        let diags = backend(b.buffer.to_text(), b.path)
        b.diagnostics = diags
        return diags
    }

    -- ── Output convenience ─────────────────────

    fn log(channel, line) { this.output.append(channel, line) }

    fn run_in_terminal(cmd) {
        this.output.append(CHANNEL_RUN, "$ " + cmd)
        let r = exec_full("cd '" + this.root_path + "' && " + cmd + " 2>&1")
        for line in split(r.stdout, "\n") { this.output.append(CHANNEL_RUN, line) }
        return r.exit_code
    }

    -- ── Summary ────────────────────────────────

    fn summary() {
        return {
            "root": this.root_path,
            "tabs": this.tabs,
            "active": this.active_tab,
            "open": len(this.buffers),
            "dirty": this.dirty_count(),
            "breakpoints": len(this.debugger.breakpoints),
            "debugger_state": this.debugger.state,
            "branch": this.git.branch
        }
    }
}

fn _ext(path) {
    let parts = split(path, ".")
    if len(parts) <= 1 { return "" }
    return parts[len(parts) - 1]
}

fn ide(root) { return Ide(root) }
