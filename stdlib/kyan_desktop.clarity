-- KyanDesktop — a real, composed desktop shell (rebrand phase K3).
--
-- The audit's #1 architectural gap was that no desktop composed
-- outside a test: DesktopSession built plain-dict "windows" that the
-- real Compositor can't blit, and only ever ran against a stub. This
-- module builds the shell on the *solid* foundation instead — the
-- real Compositor + Window + WindowManager — and paints it in the
-- Kyan identity using the K2 renderer primitives (gradients, glow,
-- glass, shadows, scalable text).
--
-- Layering, composed top-down in compose():
--   wallpaper   — obsidian + aurora glows, painted onto the screen
--   app windows — real Windows in the Compositor, Kyan glass chrome,
--                 each dropped with a soft shadow so it floats
--   dock        — a floating glass pill of app icons
--   launcher    — a full-screen scrim + search + icon grid (optional)
--
-- The WindowManager attaches to the same Compositor, so real mouse
-- events drive focus / drag / resize — the input path the old
-- DisplayServer got wrong.

from "compositor.clarity" import compositor
from "window.clarity" import window
from "window_manager.clarity" import window_manager
from "graphics.clarity" import framebuffer, rgba
from "draw.clarity" import fill_rect, rounded_rect, rounded_rect_blend, drop_shadow, linear_gradient, fill_rect_blend, line, blit_rounded, blit_rounded_alpha, frosted_panel, blit_scaled_alpha, radial_glow, circle
from "font.clarity" import builtin_font, draw_text, measure_text, draw_text_scaled, measure_text_scaled
from "atlas_font.clarity" import shared_atlas, draw_atlas_text, measure_atlas_text
from "branding_kyan.clarity" import paint_kyan_icon
from "kyan_apps.clarity" import app_painters, prism_play_rect, new_prism, prism_hit, paint_prism, new_calc, calc_press, calc_key_at, paint_calc, new_prefs, paint_settings, settings_hit, new_files, paint_files, files_click, new_monitor, monitor_tick, paint_monitor
from "kyan_game.clarity" import new_voidrunner, voidrunner_update, voidrunner_paint
from "terminal_emulator.clarity" import Terminal
from "pty.clarity" import pty_spawn_shell, pty_supported
from "theme_kyan.clarity" import kyan_obsidian, kyan_quartz, kyan_gradient_stops

let TITLE_H = 32
let WIN_RADIUS = 12       -- rounded window corners (MacOS-style float)
let WIN_GLASS_ALPHA = 184  -- window opacity over the frosted base (~72%); the rest is blurred aurora
let WIN_GLASS_TINT = 0x30281E46  -- faint violet-ink tint so the glass reads even over darker aurora
let WIN_GLASS_BLUR = 9    -- box-blur radius for the glass behind a window
let DOCK_ICON = 44
let DOCK_GAP = 12
let DOCK_PAD = 12
let DOCK_MARGIN = 16

let WIN_ANIM_MS = 220.0        -- window open: scale + fade
let LAUNCHER_ANIM_MS = 190.0   -- launcher: scrim fade + content settle

let DEFAULT_PINNED = ["prism", "terminal", "files", "editor", "monitor", "settings", "calc"]

-- Easing. ease_out_cubic settles smoothly to 1; ease_out_back overshoots
-- just past 1 then settles — the little spring pop on a window opening.
fn _ease_out_cubic(t) {
    let u = 1.0 - t
    return 1.0 - u * u * u
}
fn _ease_out_back(t) {
    let c1 = 1.70158
    let c3 = c1 + 1.0
    let u = t - 1.0
    return 1.0 + c3 * u * u * u + c1 * u * u
}

let APP_TITLES = {
    "prism":    "Prism",
    "terminal": "Terminal",
    "files":    "Files",
    "editor":   "Editor",
    "monitor":  "System Monitor",
    "settings": "Settings",
    "calc":     "Calculator",
    "viewer":   "Image Viewer"
}

class KyanDesktop {
    fn init(width, height, theme) {
        this.width = width
        this.height = height
        this.theme = theme ?? kyan_obsidian()
        this.comp = compositor(width, height)
        this.comp.set_background(this.theme["background"])
        this.wm = window_manager(this.comp)
        this.font = builtin_font()
        this._atlas = shared_atlas()   -- anti-aliased UI type (shared decode cache)
        this.pinned = DEFAULT_PINNED
        this.windows = {}          -- app_id -> Window
        this.painters = app_painters()   -- app_id -> content painter
        this.launcher_open = false
        this.frames = 0
        this._wallpaper = null     -- painted once, then fast-blitted each frame
        this.app_state = {}        -- app_id -> per-app live state (games)
        this.keys = {}             -- key name -> down? (browser/native fed)
        this._last_tick = null
        this._icon_cache = {}      -- "app:size:bg" -> pre-rendered icon fb
        this._win_sig = {}         -- app_id -> last-painted chrome signature
        this._dirty = true         -- recompose only when state changed (frost is costly)
        this._anim = {}            -- app_id -> open-anim start ms (-1 = pending stamp)
        this._launcher_t0 = -1.0   -- launcher open-anim start ms (-1 = pending / closed)
        this._launcher_query = ""  -- live search text in the launcher
        this._terminals = {}       -- app_id -> {term, pty, dead}: live PTY-backed shells
        this._app_ui = {}          -- app_id -> interactive UI state (calc, etc.); redraws on click, not every frame
        this.prefs = new_prefs()   -- desktop preferences the Settings app drives (theme, frosted, animations, dock labels)
    }

    -- Resolve a theme id (Settings swatch) to a full theme dict. Meadow /
    -- Midnight are Obsidian with a different accent family, so every theme
    -- carries the complete key set the shell needs.
    fn _theme_for(id) {
        if id == "quartz" { return kyan_quartz() }
        if id == "meadow" {
            return merge(kyan_obsidian(), {"accent": 0xFF34D399, "accent_secondary": 0xFF0EA5E9, "accent_tertiary": rgba(52, 211, 153, 40)})
        }
        if id == "midnight" {
            return merge(kyan_obsidian(), {"accent": 0xFF818CF8, "accent_secondary": 0xFF4F46E5, "accent_tertiary": rgba(129, 140, 248, 40), "background": 0xFF070A14})
        }
        return kyan_obsidian()
    }

    -- Switch the desktop theme live (Settings swatch click).
    fn set_theme_by_id(id) {
        this.prefs["theme"] = id
        this.theme = this._theme_for(id)
        this.comp.set_background(this.theme["background"])
        this._wallpaper = null       -- re-cache the aurora in the new palette
        this._icon_cache = {}        -- icons are accent-tinted → invalidate
        this._win_sig = {}           -- window chrome uses the theme → repaint
        this._dirty = true
        return true
    }

    -- Whether the next frame needs a fresh compose. A discrete change
    -- (input, open/close/focus, launcher) sets the dirty flag; a live app
    -- (a running game) forces a redraw every frame. When neither holds the
    -- host loop can skip compose entirely and just re-present the last
    -- frame — so an idle desktop costs nothing even with frosted glass.
    fn needs_redraw() {
        if this._dirty { return true }
        if len(keys(this.app_state)) > 0 { return true }
        -- a window open-animation still in flight (pending stamp, or within
        -- its duration). Expired entries are swept on the next compose.
        for kv in entries(this._anim) {
            if kv[1] < 0.0 { return true }
            if this._last_tick != null and this._last_tick - kv[1] < WIN_ANIM_MS { return true }
        }
        if this.launcher_open and this._launcher_t0 >= 0.0 and this._last_tick != null
           and this._last_tick - this._launcher_t0 < LAUNCHER_ANIM_MS { return true }
        return false
    }

    -- Reverse-lookup the app id owning a window (or null).
    fn _app_of(win) {
        for kv in entries(this.windows) {
            if kv[1] == win { return kv[0] }
        }
        return null
    }

    -- Anti-aliased icons are supersampled (expensive), so render each
    -- once over its backing colour and cache it; later frames just blit.
    fn _icon(app, size, bg) {
        let key = app + ":" + str(size) + ":" + str(bg)
        if not has(this._icon_cache, key) {
            let f = framebuffer(size, size)
            f.clear(bg)
            paint_kyan_icon(f, app, 0, 0, size, this.theme)
            this._icon_cache[key] = f
        }
        return this._icon_cache[key]
    }

    fn boot(pinned) {
        if pinned != null { this.pinned = pinned }
        return true
    }

    -- ── App windows ─────────────────────────────────

    fn open(app_id, x, y, w, h) {
        this._dirty = true
        if has(this.windows, app_id) {
            let win = this.windows[app_id]
            win.set_visible(true)
            win.restore_from_min()
            this.comp.focus(win)
            return win
        }
        let title = if has(APP_TITLES, app_id) { APP_TITLES[app_id] } else { app_id }
        let win = window(title, x, y, w, h)
        win.title_h = TITLE_H
        win.border_w = 0
        this.windows[app_id] = win
        this.comp.add(win)
        this.comp.focus(win)
        this._anim[app_id] = -1.0   -- spring the new window in (start stamped on next tick)
        -- live apps get their state seeded to the content size
        if app_id == "voidrunner" {
            let cr = win.content_rect()
            this.app_state["voidrunner"] = new_voidrunner(cr[2], cr[3])
        }
        -- the System Monitor is a live app: its readings drift each frame
        if app_id == "monitor" {
            this.app_state["monitor"] = new_monitor()
        }
        -- Prism keeps view state (library ⇄ game detail)
        if app_id == "prism" and not has(this._app_ui, "prism") {
            this._app_ui["prism"] = new_prism()
        }
        -- a real Terminal spawns a shell on a PTY where the host supports it;
        -- otherwise (e.g. the browser build) it falls back to the mockup painter
        if app_id == "terminal" and pty_supported() and not has(this._terminals, "terminal") {
            let cr = win.content_rect()
            let cols = int(cr[2] / 8)
            let rows = int(cr[3] / 16)
            this._terminals["terminal"] = {
                "term": Terminal(cols, rows),
                "pty": pty_spawn_shell(cols, rows),
                "dead": false
            }
        }
        -- interactive apps get a fresh UI state
        if app_id == "calc" and not has(this._app_ui, "calc") {
            this._app_ui["calc"] = new_calc()
        }
        if app_id == "files" and not has(this._app_ui, "files") {
            this._app_ui["files"] = new_files()
        }
        return win
    }

    fn close(app_id) {
        this._dirty = true
        if not has(this.windows, app_id) { return false }
        this.comp.remove(this.windows[app_id])
        mut next = {}
        for kv in entries(this.windows) {
            if kv[0] != app_id { next[kv[0]] = kv[1] }
        }
        this.windows = next
        if has(this._win_sig, app_id) {
            mut nsig = {}
            for kv in entries(this._win_sig) { if kv[0] != app_id { nsig[kv[0]] = kv[1] } }
            this._win_sig = nsig
        }
        if has(this.app_state, app_id) {
            mut ns = {}
            for kv in entries(this.app_state) { if kv[0] != app_id { ns[kv[0]] = kv[1] } }
            this.app_state = ns
        }
        if has(this._terminals, app_id) {
            this._terminals[app_id]["pty"].close()
            mut nt = {}
            for kv in entries(this._terminals) { if kv[0] != app_id { nt[kv[0]] = kv[1] } }
            this._terminals = nt
        }
        if has(this._app_ui, app_id) {
            mut nu = {}
            for kv in entries(this._app_ui) { if kv[0] != app_id { nu[kv[0]] = kv[1] } }
            this._app_ui = nu
        }
        return true
    }

    fn focus(app_id) {
        if not has(this.windows, app_id) { return false }
        this.comp.focus(this.windows[app_id])
        this._dirty = true
        return true
    }

    fn running() { return keys(this.windows) }

    -- ── Input (real WindowManager path) ─────────────

    -- Route a mouse event. The shell claims clicks on the dock and the
    -- launcher; everything else goes to the WindowManager (focus/drag).
    fn handle_mouse(me) {
        this._dirty = true
        if this.launcher_open {
            if me.is_press { return this._launcher_click(me.x, me.y) }
            return true
        }
        if me.is_press {
            let hit = this._dock_hit(me.x, me.y)
            if hit != null { this._activate(hit); return true }
            if this._titlebar_click(me.x, me.y) { return true }
            if this._content_click(me.x, me.y) { return true }
        }
        return this.wm.handle_mouse(me)
    }

    -- Clicks inside an app's content that the shell handles: the Prism
    -- "Play" button, and interactive apps (Calculator keys, etc.).
    fn _content_click(px, py) {
        let top = this.comp.top_window()
        if top == null { return false }
        mut app_id = null
        for kv in entries(this.windows) {
            if kv[1] == top { app_id = kv[0] }
        }
        if app_id == null { return false }
        let cr = top.content_rect()
        let ax = top.x + cr[0]
        let ay = top.y + cr[1]
        let aw = cr[2]
        let ah = cr[3]

        if app_id == "prism" and has(this._app_ui, "prism") {
            let st = this._app_ui["prism"]
            let hit = prism_hit(st, ax, ay, aw, ah, px, py)
            if hit != null {
                if hit["kind"] == "play" { this._activate("voidrunner"); return true }
                if hit["kind"] == "open" { st["view"] = "detail"; st["sel"] = hit["idx"]; this._dirty = true; return true }
                if hit["kind"] == "back" { st["view"] = "library"; this._dirty = true; return true }
            }
            return false
        }
        if app_id == "calc" and has(this._app_ui, "calc") {
            let key = calc_key_at(ax, ay, aw, ah, px, py, this._app_ui["calc"])
            if key != null {
                calc_press(this._app_ui["calc"], key)
                this._dirty = true
                return true
            }
        }
        if app_id == "settings" {
            let hit = settings_hit(ax, ay, aw, ah, px, py, this.prefs)
            if hit != null {
                if hit["kind"] == "theme" {
                    this.set_theme_by_id(hit["id"])
                } elif hit["kind"] == "section" {
                    this.prefs["section"] = hit["id"]
                    this._dirty = true
                } else {
                    this.prefs[hit["key"]] = not this.prefs[hit["key"]]
                    this._dirty = true
                }
                return true
            }
        }
        if app_id == "files" and has(this._app_ui, "files") {
            if files_click(this._app_ui["files"], ax, ay, aw, ah, px, py) {
                this._dirty = true
                return true
            }
        }
        return false
    }

    fn handle_key(ke) { return this.wm.handle_key(ke) }

    -- Track key state by name (browser feeds e.key; native feeds the
    -- same). Live apps read this each tick.
    fn set_key(name, down) { this.keys[name] = down; this._dirty = true }

    -- Send raw input to the live terminal's shell (a typed line, a
    -- keystroke). Returns false when there's no PTY-backed terminal.
    fn terminal_input(text) {
        if not has(this._terminals, "terminal") { return false }
        this._terminals["terminal"]["pty"].write(text)
        this._dirty = true
        return true
    }

    -- The live terminal session for an app id, or null (for tests/hosts).
    fn terminal_session(app_id) {
        if has(this._terminals, app_id) { return this._terminals[app_id] }
        return null
    }

    -- Advance time-based apps one frame. The host loop calls this with a
    -- monotonic ms clock before compose(); dt is derived here.
    fn tick(now_ms) {
        if this._last_tick != null {
            let dt = now_ms - this._last_tick
            if has(this.windows, "voidrunner") and has(this.app_state, "voidrunner") {
                voidrunner_update(this.app_state["voidrunner"], dt, this.keys)
            }
            if has(this.windows, "monitor") and has(this.app_state, "monitor") {
                monitor_tick(this.app_state["monitor"], dt)
            }
        }
        -- pump live PTY terminals: reflow on a window resize (SIGWINCH),
        -- then drain any new output into their emulator
        for kv in entries(this._terminals) {
            let app_id = kv[0]
            let sess = kv[1]
            if has(this.windows, app_id) {
                let cr = this.windows[app_id].content_rect()
                let cols = int(cr[2] / 8)
                let rows = int(cr[3] / 16)
                if cols >= 1 and rows >= 1 and (cols != sess["term"].cols or rows != sess["term"].rows) {
                    sess["term"].resize(cols, rows)
                    sess["pty"].resize(cols, rows)
                    this._dirty = true
                }
            }
            let out = sess["pty"].read()
            if out == null {
                sess["dead"] = true
            } elif len(out) > 0 {
                sess["term"].feed(out)
                this._dirty = true
            }
        }
        -- stamp pending animation starts against the real clock
        for kv in entries(this._anim) {
            if kv[1] < 0.0 { this._anim[kv[0]] = now_ms }
        }
        if this.launcher_open and this._launcher_t0 < 0.0 { this._launcher_t0 = now_ms }
        this._last_tick = now_ms
        return true
    }

    fn toggle_launcher() {
        this.launcher_open = not this.launcher_open
        this._launcher_t0 = -1.0   -- (re)stamp the open animation on next tick
        this._launcher_query = ""  -- always open with an empty search
        this._dirty = true
        return this.launcher_open
    }

    -- Pinned apps whose title/id matches the current search query.
    fn _filtered_apps() {
        let q = lower(this._launcher_query)
        if len(q) == 0 { return this.pinned }
        mut out = []
        for app in this.pinned {
            let title = if has(APP_TITLES, app) { APP_TITLES[app] } else { app }
            if contains(lower(title), q) or contains(lower(app), q) { push(out, app) }
        }
        return out
    }

    -- Launcher text input (only meaningful while the launcher is open).
    fn launcher_type(text) {
        if not this.launcher_open { return false }
        this._launcher_query = this._launcher_query + text
        this._dirty = true
        return true
    }

    fn launcher_backspace() {
        if not this.launcher_open { return false }
        let n = len(this._launcher_query)
        if n > 0 { this._launcher_query = substring(this._launcher_query, 0, n - 1) }
        this._dirty = true
        return true
    }

    -- Enter: open the top match and dismiss the launcher.
    fn launcher_submit() {
        if not this.launcher_open { return false }
        let matches = this._filtered_apps()
        if len(matches) > 0 {
            this.launcher_open = false
            this._activate(matches[0])
            return true
        }
        return false
    }

    -- Resize the whole desktop to a new resolution (a live host-window
    -- resize). Re-allocates the compositor screen and drops the cached
    -- wallpaper so the aurora repaints to fit; the next compose is full.
    fn resize(w, h) {
        mut nw = w
        mut nh = h
        if nw < 320 { nw = 320 }
        if nh < 240 { nh = 240 }
        if nw == this.width and nh == this.height { return false }
        this.width = nw
        this.height = nh
        this.comp.resize(nw, nh)
        this._wallpaper = null
        this._dirty = true
        return true
    }

    -- Open-animation state for a window: {active, scale, alpha}. Finished
    -- or clock-less (native one-shot render) animations report inactive, so
    -- the window draws at rest. Removes an animation once it completes.
    fn _anim_state(app_id) {
        -- Settings can disable window animations / enable reduce-motion, in
        -- which case windows always draw at rest.
        if not this.prefs["animations"] or this.prefs["reduce_motion"] {
            return {"active": false, "scale": 1.0, "alpha": 255}
        }
        if app_id == null or not has(this._anim, app_id) or this._last_tick == null {
            return {"active": false, "scale": 1.0, "alpha": 255}
        }
        let start = this._anim[app_id]
        if start < 0.0 { return {"active": false, "scale": 1.0, "alpha": 255} }
        let p = (this._last_tick - start) / WIN_ANIM_MS
        if p >= 1.0 {
            mut next = {}
            for kv in entries(this._anim) { if kv[0] != app_id { next[kv[0]] = kv[1] } }
            this._anim = next
            return {"active": false, "scale": 1.0, "alpha": 255}
        }
        let scale = 0.92 + 0.08 * _ease_out_back(p)
        let alpha = int(255.0 * _ease_out_cubic(p))
        return {"active": true, "scale": scale, "alpha": alpha}
    }

    -- Open (or focus) an app by id at a cascaded default position.
    fn _activate(app_id) {
        if has(this.windows, app_id) {
            let win = this.windows[app_id]
            win.restore_from_min()      -- a dock click on a minimized app brings it back
            this.comp.focus(win)
            return win
        }
        let b = this._default_bounds(app_id)
        return this.open(app_id, b[0], b[1], b[2], b[3])
    }

    fn _default_bounds(app_id) {
        let idx = len(keys(this.windows))
        let bx = int(this.width * 0.12) + (idx % 5) * 40
        let by = int(this.height * 0.14) + (idx % 5) * 30
        if app_id == "prism"      { return [bx, by, 680, 460] }
        if app_id == "files"      { return [bx, by, 420, 320] }
        if app_id == "terminal"   { return [bx, by, 460, 280] }
        if app_id == "voidrunner" { return [bx, by, 560, 440] }
        return [bx, by, 500, 340]
    }

    fn _in(px, py, x, y, w, h) {
        return px >= x and px < x + w and py >= y and py < y + h
    }

    -- Dock geometry — shared by the painter and hit-testing so they
    -- can never drift.
    fn _dock_layout() {
        let n = len(this.pinned)
        if n == 0 { return null }
        let dw = n * DOCK_ICON + (n - 1) * DOCK_GAP + 2 * DOCK_PAD
        let dh = DOCK_ICON + 2 * DOCK_PAD
        let dx = int(this.width / 2) - int(dw / 2)
        let dy = this.height - dh - DOCK_MARGIN
        mut icons = []
        mut ix = dx + DOCK_PAD
        for app in this.pinned {
            push(icons, {"app": app, "x": ix, "y": dy + DOCK_PAD, "size": DOCK_ICON})
            ix = ix + DOCK_ICON + DOCK_GAP
        }
        return {"x": dx, "y": dy, "w": dw, "h": dh, "icons": icons}
    }

    fn _dock_hit(px, py) {
        let layout = this._dock_layout()
        if layout == null { return null }
        for ic in layout["icons"] {
            if this._in(px, py, ic["x"], ic["y"], ic["size"], ic["size"]) { return ic["app"] }
        }
        return null
    }

    fn _circle_hit(px, py, cx, cy, r) {
        let dx = px - cx
        let dy = py - cy
        return dx * dx + dy * dy <= r * r
    }

    -- Traffic-light buttons in a window's title bar. Returns true if a
    -- button (close / minimize / zoom) was clicked; a plain title-bar click
    -- returns false so the WindowManager still gets it for focus/drag.
    -- Geometry mirrors _paint_chrome: round lights at local x 19/37/55,
    -- centred on the title bar.
    fn _titlebar_click(px, py) {
        mut i = len(this.comp.windows) - 1
        while i >= 0 {
            let win = this.comp.windows[i]
            if win.visible and not win.minimized
               and px >= win.x and px <= win.x + win.width
               and py >= win.y and py <= win.y + win.title_h {
                let cyc = win.y + int(win.title_h / 2)
                let app_id = this._app_of(win)
                if this._circle_hit(px, py, win.x + 19, cyc, 9) {
                    if app_id != null { this.close(app_id) }
                    return true
                }
                if this._circle_hit(px, py, win.x + 37, cyc, 9) {
                    win.minimize()
                    this._dirty = true
                    return true
                }
                if this._circle_hit(px, py, win.x + 55, cyc, 9) {
                    if win.maximized { win.unmaximize() } else { win.maximize(this.width, this.height) }
                    this._dirty = true
                    return true
                }
                -- a click elsewhere on this title bar: leave it to the WM
                return false
            }
            i -= 1
        }
        return false
    }

    -- ── Composition ─────────────────────────────────

    -- Paint the whole desktop onto the compositor's screen framebuffer
    -- and return it. This is the "a real desktop actually paints" path
    -- the audit found missing.
    fn compose() {
        let s = this.comp.screen
        -- wallpaper: painted once (the aurora glows are expensive), then
        -- fast-blitted every frame
        if this._wallpaper == null {
            this._wallpaper = framebuffer(this.width, this.height)
            this._paint_wallpaper(this._wallpaper)
        }
        s.blit(this._wallpaper, 0, 0, 0, 0, this.width, this.height)
        -- app windows, bottom-to-top, each floated with a soft shadow.
        -- Anti-aliased text is not cheap, so a window's chrome+content is
        -- painted into its own framebuffer only when it actually changes
        -- (focus/size). Live apps (their own state) always repaint. Static
        -- windows keep their retained buffer and just re-blit — this is what
        -- keeps the atlas font affordable per frame.
        for win in this.comp.windows {
            if not win.visible or win.minimized { continue }
            let app_id = this._app_of(win)
            -- "live" windows repaint their content every compose: real-time
            -- apps (games) plus the interactive apps whose UI reflects click
            -- state (calc/files in _app_ui, settings in prefs). compose only
            -- runs on dirty frames, so this is paid only when something moved.
            let live = app_id != null and (has(this.app_state, app_id)
                       or has(this._app_ui, app_id) or app_id == "settings")
            let sig = str(win.focused) + ":" + str(win.width) + ":" + str(win.height)
            let cached = app_id != null and has(this._win_sig, app_id) and this._win_sig[app_id] == sig
            if live or not cached {
                this._paint_chrome(win)
                if app_id != null { this._win_sig[app_id] = sig }
            }
            let anim = this._anim_state(app_id)
            if anim["active"] {
                -- scale + fade in around the window's centre (spring pop)
                let cx = win.x + int(win.width / 2)
                let cy = win.y + int(win.height / 2)
                let dw = int(win.width * anim["scale"])
                let dh = int(win.height * anim["scale"])
                let dx = cx - int(dw / 2)
                let dy = cy - int(dh / 2)
                let sh_a = int(150 * anim["alpha"] / 255)
                drop_shadow(s, dx, dy, dw, dh, WIN_RADIUS, rgba(0, 0, 0, sh_a), 7)
                blit_scaled_alpha(s, win.framebuffer, dx, dy, dw, dh, anim["alpha"])
            } else {
                drop_shadow(s, win.x, win.y, win.width, win.height, WIN_RADIUS, rgba(0, 0, 0, 150), 7)
                if this.prefs["frosted"] {
                    -- frosted glass: blur the aurora (and any window below)
                    -- behind this window, tint it, then ride the window's
                    -- chrome over it at <100% so the blur glows through.
                    frosted_panel(s, win.x, win.y, win.width, win.height, WIN_RADIUS, WIN_GLASS_TINT, WIN_GLASS_BLUR)
                    blit_rounded_alpha(s, win.framebuffer, win.x, win.y, win.width, win.height, WIN_RADIUS, WIN_GLASS_ALPHA)
                } else {
                    blit_rounded(s, win.framebuffer, win.x, win.y, win.width, win.height, WIN_RADIUS)
                }
            }
        }
        this._paint_dock(s)
        if this.launcher_open { this._paint_launcher(s) }
        this.frames = this.frames + 1
        this._dirty = false
        return s
    }

    fn screenshot(path) {
        this.compose()
        this.comp.screen.save_bmp(path)
        return path
    }

    -- ── Painters ────────────────────────────────────

    fn _paint_wallpaper(fb) {
        let t = this.theme
        -- Aurora Glass wallpaper. Two layers of depth:
        --  1. a diagonal base wash — deep violet at the top-left fading
        --     to a teal-black at the bottom — so the canvas is never a
        --     dead flat black.
        --  2. three soft radial "aurora" blooms (violet, cyan, blue)
        --     placed off the corners so the light feels like it spills
        --     in from beyond the frame.
        -- The whole thing is drawn at quarter resolution and then
        -- bilinear-upscaled: the blooms are smooth gradients, so the
        -- upscale is invisible, and the per-pixel glow cost drops ~16x
        -- (keeps the one-time paint cheap even off the compiled path).
        let sc = 4
        let sw = int(this.width / sc)
        let sh = int(this.height / sc)
        let small = framebuffer(sw, sh)
        linear_gradient(small, 0, 0, sw, sh, [
            {"t": 0.0,  "color": rgba(26, 12, 51, 255)},    -- #1A0C33 deep violet
            {"t": 0.42, "color": rgba(10, 10, 28, 255)},    -- #0A0A1C ink
            {"t": 1.0,  "color": rgba(6, 26, 32, 255)}      -- #061A20 teal-black
        ], "v")
        radial_glow(small, int(sw * 0.14), int(sh * 0.08), int(sw * 0.52), rgba(163, 116, 249, 150))  -- violet, top-left
        radial_glow(small, int(sw * 0.90), int(sh * 0.16), int(sw * 0.42), rgba(53, 231, 225, 105))   -- cyan, top-right
        radial_glow(small, int(sw * 0.66), int(sh * 1.04), int(sw * 0.60), rgba(79, 157, 255, 120))   -- blue, rising from bottom
        radial_glow(small, int(sw * 0.42), int(sh * 0.40), int(sw * 0.56), rgba(140, 82, 222, 78))    -- violet centre wash (backdrop for window glass)
        radial_glow(small, int(sw * 0.62), int(sh * 0.64), int(sw * 0.44), rgba(72, 122, 232, 66))    -- blue mid (glows through window bodies)
        fb.clear(t["background"])
        blit_scaled_alpha(fb, small, 0, 0, this.width, this.height, 255)
    }

    -- Paint Kyan glass chrome + a content placeholder into a window's
    -- own framebuffer. Focused windows get the signature gradient rail.
    fn _paint_chrome(win) {
        let fb = win.framebuffer
        let t = this.theme
        let w = win.width
        let h = win.height
        let th = win.title_h
        -- opaque surface (square window — the compositor blit is opaque)
        fb.clear(t["surface"])
        -- title bar: a subtle vertical gradient (raised → surface) so it
        -- reads as a distinct glass strip rather than a flat band
        linear_gradient(fb, 0, 0, w, th, [
            {"t": 0.0, "color": t["surface_elevated"]},
            {"t": 1.0, "color": t["surface"]}
        ], "v")
        -- rim-light: a 1px highlight along the very top edge catches the
        -- light like a bevelled glass pane. Brighter when focused.
        let rim_a = if win.focused { 40 } else { 22 }
        fill_rect_blend(fb, 0, 0, w, 1, rgba(255, 255, 255, rim_a))
        -- top rail: signature gradient when focused, hairline otherwise
        if win.focused {
            linear_gradient(fb, 0, 1, w, 2, kyan_gradient_stops(), "h")
        } else {
            fill_rect(fb, 0, 1, w, 2, t["border"])
        }
        -- traffic lights (round)
        let cy = int(th / 2)
        circle(fb, 19, cy, 6, 0xFFFB7185)
        circle(fb, 37, cy, 6, 0xFFFBBF24)
        circle(fb, 55, cy, 6, 0xFF34D399)
        -- title, centred (anti-aliased proportional type)
        let tw = measure_atlas_text(this._atlas, win.title, 15, 0)[0]
        let tx = int(w / 2) - int(tw / 2)
        let tcol = if win.focused { t["foreground"] } else { t["foreground_muted"] }
        draw_atlas_text(fb, tx, int((th - 15) / 2), win.title, this._atlas, tcol, {"size": 15})
        -- hairline under the title bar
        fill_rect(fb, 0, th - 1, w, 1, t["border"])
        -- app content in the area below the title bar
        this._paint_content(win)
    }

    -- Draw the app's content into its content rect. Uses a registered
    -- painter for the window's app when one exists; otherwise a neutral
    -- placeholder so an unskinned app still reads as a window.
    fn _paint_content(win) {
        let fb = win.framebuffer
        let t = this.theme
        let cr = win.content_rect()
        let cx = cr[0]
        let cy = cr[1]
        let cw = cr[2]
        let ch = cr[3]
        if cw <= 0 or ch <= 0 { return null }
        -- reverse-lookup the app id for this window
        mut app_id = null
        for kv in entries(this.windows) {
            if kv[1] == win { app_id = kv[0] }
        }
        -- live (stateful) apps paint from their own state
        if app_id == "voidrunner" and has(this.app_state, "voidrunner") {
            voidrunner_paint(fb, cx, cy, cw, ch, t, this.app_state["voidrunner"])
            return null
        }
        if app_id == "monitor" and has(this.app_state, "monitor") {
            paint_monitor(fb, cx, cy, cw, ch, t, this.app_state["monitor"])
            return null
        }
        -- Prism paints its current view (library or a game's detail)
        if app_id == "prism" and has(this._app_ui, "prism") {
            paint_prism(fb, cx, cy, cw, ch, t, this._app_ui["prism"])
            return null
        }
        -- a live PTY terminal renders its real character grid; without a
        -- session (unsupported host) it falls through to the mockup painter
        if app_id == "terminal" and has(this._terminals, "terminal") {
            this._render_terminal(fb, cx, cy, cw, ch, this._terminals["terminal"])
            return null
        }
        -- interactive Calculator paints from its live state
        if app_id == "calc" and has(this._app_ui, "calc") {
            paint_calc(fb, cx, cy, cw, ch, t, this._app_ui["calc"])
            return null
        }
        -- Settings paints from the live desktop preferences
        if app_id == "settings" {
            paint_settings(fb, cx, cy, cw, ch, t, this.prefs)
            return null
        }
        -- Files paints its current directory from live navigation state
        if app_id == "files" and has(this._app_ui, "files") {
            paint_files(fb, cx, cy, cw, ch, t, this._app_ui["files"])
            return null
        }
        if app_id != null and has(this.painters, app_id) {
            (this.painters[app_id])(fb, cx, cy, cw, ch, t, win.focused)
            return null
        }
        -- placeholder rows
        mut i = 0
        while i < 5 {
            let ry = cy + 12 + i * 22
            if ry < cy + ch - 8 {
                fill_rect(fb, cx + 20, ry, int((cw - 40) * (0.8 - i * 0.1)), 8, t["border"])
            }
            i = i + 1
        }
    }

    -- Render a live terminal's character grid in classic monospace: an
    -- 8×16 cell grid drawn with the bitmap font, per-cell fg/bg from the
    -- emulator, and the signature cursor. Repainted only on new output.
    fn _render_terminal(fb, x, y, w, h, sess) {
        let term = sess["term"]
        fill_rect(fb, x, y, w, h, 0xFF05060A)
        let cw = 8
        let chh = 16
        mut r = 0
        while r < term.rows {
            mut c = 0
            while c < term.cols {
                let cell = term.cell_at(r, c)
                if cell != null {
                    let gx = x + c * cw
                    let gy = y + r * chh
                    if gx + cw <= x + w and gy + chh <= y + h {
                        if cell.bg != 0xFF1A1A1A { fill_rect(fb, gx, gy, cw, chh, cell.bg) }
                        if cell.ch != " " { draw_text(fb, gx, gy + 4, cell.ch, this.font, cell.fg) }
                    }
                }
                c = c + 1
            }
            r = r + 1
        }
        if term._scroll_offset == 0 {
            let curx = x + term.cursor_col * cw
            let cury = y + term.cursor_row * chh
            if curx + cw <= x + w and cury + chh <= y + h {
                fill_rect(fb, curx, cury + chh - 2, cw, 2, this.theme["accent"])
            }
        }
    }

    fn _paint_dock(fb) {
        let layout = this._dock_layout()
        if layout == null { return null }
        let dx = layout["x"]
        let dy = layout["y"]
        let dw = layout["w"]
        let dh = layout["h"]
        -- floating pill with a soft shadow. Frosted glass (blur what's
        -- behind it) when enabled in Settings; otherwise a plain glass tint.
        drop_shadow(fb, dx, dy, dw, dh, 18, rgba(0, 0, 0, 120), 7)
        if this.prefs["frosted"] {
            frosted_panel(fb, dx, dy, dw, dh, 18, rgba(13, 17, 26, 150), 6)
        } else {
            rounded_rect_blend(fb, dx, dy, dw, dh, 18, rgba(13, 17, 26, 225))
        }
        -- icons (cached, AA) + running indicators + optional labels
        for ic in layout["icons"] {
            let bg = fb.get_pixel(ic["x"], ic["y"])   -- the glass under this icon
            fb.blit(this._icon(ic["app"], ic["size"], bg), 0, 0, ic["x"], ic["y"], ic["size"], ic["size"])
            if has(this.windows, ic["app"]) {
                -- running indicator: accent for a live window, dimmed when minimized
                let dotcol = if this.windows[ic["app"]].minimized { this.theme["foreground_muted"] } else { this.theme["accent"] }
                fill_rect(fb, ic["x"] + int(ic["size"] / 2) - 2, dy + dh - 5, 4, 4, dotcol)
            }
            if this.prefs["dock_labels"] {
                let label = if has(APP_TITLES, ic["app"]) { APP_TITLES[ic["app"]] } else { ic["app"] }
                let lw = measure_atlas_text(this._atlas, label, 11, 0)[0]
                draw_atlas_text(fb, ic["x"] + int(ic["size"] / 2) - int(lw / 2), dy + dh + 3, label, this._atlas, this.theme["foreground_muted"], {"size": 11})
            }
        }
    }

    fn _paint_launcher(fb) {
        let t = this.theme
        -- open animation: scrim fades in, content settles down with a slight
        -- overshoot. At rest (or on the clock-less native render) p == 1.
        mut p = 1.0
        if this._launcher_t0 >= 0.0 and this._last_tick != null {
            p = (this._last_tick - this._launcher_t0) / LAUNCHER_ANIM_MS
            if p > 1.0 { p = 1.0 }
        }
        let off = int((1.0 - _ease_out_back(p)) * -14.0)   -- start ~14px high, settle
        let scrim_a = int(170 * _ease_out_cubic(p))
        -- dim scrim over everything
        fill_rect_blend(fb, 0, 0, this.width, this.height, rgba(5, 6, 10, scrim_a))
        -- search bar
        let bw = int(this.width * 0.5)
        let bx = int(this.width / 2) - int(bw / 2)
        let by = int(this.height * 0.24) + off
        drop_shadow(fb, bx, by, bw, 44, 12, rgba(0, 0, 0, 140), 8)
        frosted_panel(fb, bx, by, bw, 44, 12, rgba(13, 17, 26, 205), 7)
        linear_gradient(fb, bx, by, bw, 3, kyan_gradient_stops(), "h")
        -- live query text (or a muted placeholder), with a caret
        if len(this._launcher_query) > 0 {
            draw_atlas_text(fb, bx + 18, by + 13, this._launcher_query, this._atlas, t["foreground"], {"size": 18})
            let qw = measure_atlas_text(this._atlas, this._launcher_query, 18, 0)[0]
            fill_rect(fb, bx + 20 + qw, by + 12, 2, 20, t["accent"])
        } else {
            draw_atlas_text(fb, bx + 18, by + 13, "Search apps, files, commands", this._atlas, t["foreground_muted"], {"size": 18})
        }
        -- filtered icon grid (geometry shared with hit-testing)
        let layout = this._launcher_layout()
        let cell = layout["cell"]
        let gy = layout["gy"] + off
        if len(layout["cells"]) == 0 {
            let msg = "No results for \"" + this._launcher_query + "\""
            let mw = measure_atlas_text(this._atlas, msg, 16, 0)[0]
            draw_atlas_text(fb, int(this.width / 2) - int(mw / 2), gy + 20, msg, this._atlas, t["foreground_muted"], {"size": 16})
        }
        mut idx = 0
        for c in layout["cells"] {
            let ix = c["x"] + int((cell - 52) / 2)
            let bg = fb.get_pixel(ix, gy)
            -- highlight the top match (what Enter opens)
            if idx == 0 and len(this._launcher_query) > 0 {
                rounded_rect_blend(fb, c["x"] + 6, gy - 6, cell - 12, 76, 12, rgba(124, 58, 237, 60))
            }
            fb.blit(this._icon(c["app"], 52, bg), 0, 0, ix, gy, 52, 52)
            let label = if has(APP_TITLES, c["app"]) { APP_TITLES[c["app"]] } else { c["app"] }
            let lw = measure_atlas_text(this._atlas, label, 14, 0)[0]
            draw_atlas_text(fb, c["x"] + int((cell - lw) / 2), gy + 58, label, this._atlas, t["foreground"], {"size": 14})
            idx = idx + 1
        }
    }

    fn _launcher_layout() {
        let apps = this._filtered_apps()
        let cols = len(apps)
        let cell = 84
        let gw = cols * cell
        let gx = int(this.width / 2) - int(gw / 2)
        let by = int(this.height * 0.24)
        let gy = by + 92
        mut cells = []
        mut cx = gx
        for app in apps {
            push(cells, {"app": app, "x": cx, "y": gy - 6, "w": cell, "h": 80})
            cx = cx + cell
        }
        return {"by": by, "gy": gy, "gx": gx, "cell": cell, "cells": cells}
    }

    fn _launcher_click(px, py) {
        let layout = this._launcher_layout()
        for c in layout["cells"] {
            if this._in(px, py, c["x"], c["y"], c["w"], c["h"]) {
                this.launcher_open = false
                this._activate(c["app"])
                return true
            }
        }
        -- clicking outside a cell dismisses the launcher
        this.launcher_open = false
        return true
    }
}

fn kyan_desktop(width, height, ...rest) {
    let theme = if len(rest) > 0 { rest[0] } else { kyan_obsidian() }
    return KyanDesktop(width, height, theme)
}
