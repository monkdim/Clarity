-- Spring themes — Meadow (default), Bloom, Watercolor.
--
-- Phase 76 design refresh. Replaces Aurora as the flagship; Aurora
-- is preserved as the "Midnight" option in theme_registry.clarity
-- so users who want a dark theme still have it.
--
-- Three principles:
--   1. Bright, familiar canvas — cream / eggshell / parchment, never
--      pure white (too clinical).
--   2. Spring palette — sage greens, daffodil yellow, blossom pink,
--      sky blue. Saturated but desaturated; alive without shouting.
--   3. Soft elevation — color-tinted shadows + frosted backdrop on
--      chrome (no hairline borders, no harsh black drop shadows).
--
--     let theme = meadow()
--     theme["primary"]              -- 0xFF6BAA75 (leaf green)
--     theme["accent_gradient"]      -- callable: gradient(t) -> color
--     theme["radius"]["window"]     -- 14
--
-- Themes are plain dicts so any widget that already takes a theme
-- (Phase 60+) accepts them without code changes.

-- ── Shared design tokens (same shape across all spring variants) ──

let _RADIUS = {
    "window":  14,
    "card":    12,
    "control": 10,
    "pill":    9999,
    "tag":     6
}

let _SPACING = {
    "xs":  4, "sm":  8, "md":  12, "lg":  16, "xl":  24, "xxl":  40
}

let _TYPE = {
    "display": 48, "title": 28, "h1": 24, "h2": 20,
    "h3": 16, "body": 14, "caption": 12, "micro": 10
}

let _MOTION = {
    "fast_ms":   140,
    "base_ms":   200,
    "slow_ms":   320,
    "easing":    "ease_out_cubic"
}

let _BASE_SHARED = {
    "radius":      _RADIUS,
    "spacing":     _SPACING,
    "typography":  _TYPE,
    "motion":      _MOTION,
    "border_width": 1,
    "shadow_blur":  18,
    "shadow_dy":    4
}

fn _merge(a, b) {
    mut out = {}
    for kv in entries(a) { out[kv[0]] = kv[1] }
    for kv in entries(b) { out[kv[0]] = kv[1] }
    return out
}

-- ── Meadow palette (default) ────────────────────

let MEADOW_CANVAS    = 0xFFF4F1EA
let MEADOW_SURFACE   = 0xFFFFFFFF
let MEADOW_SURFACE_2 = 0xFFFAF7F0
let MEADOW_INK       = 0xFF2B3A2E
let MEADOW_INK_SOFT  = 0xFF425646
let MEADOW_PRIMARY   = 0xFF6BAA75
let MEADOW_PRIMARY_D = 0xFF3D6E4B
let MEADOW_SECONDARY = 0xFFF5C16C
let MEADOW_TERTIARY  = 0xFFE8A4B4
let MEADOW_SKY       = 0xFFA0C6DC
let MEADOW_SKY_D     = 0xFF6CA0BC
let MEADOW_MUTED     = 0xFF8B958B
let MEADOW_BORDER    = 0xFFDCD7C8
let MEADOW_SHADOW    = 0x402B3A2E      -- 25% deep moss (color-tinted, not pure black)

fn meadow() {
    return _merge(_BASE_SHARED, {
        "name":              "Meadow",
        "id":                "meadow",
        "background":        MEADOW_CANVAS,
        "surface":           MEADOW_SURFACE,
        "surface_elevated":  MEADOW_SURFACE_2,
        "border":            MEADOW_BORDER,
        "foreground":        MEADOW_INK,
        "foreground_muted":  MEADOW_MUTED,
        "ink_soft":          MEADOW_INK_SOFT,
        "primary":           MEADOW_PRIMARY,
        "primary_dark":      MEADOW_PRIMARY_D,
        "accent":            MEADOW_PRIMARY,
        "accent_secondary":  MEADOW_SECONDARY,
        "accent_tertiary":   MEADOW_TERTIARY,
        "highlight":         MEADOW_SKY,
        "selection":         0x406BAA75,
        "danger":            0xFFD96A6A,
        "warning":           MEADOW_SECONDARY,
        "success":           MEADOW_PRIMARY,
        "focus_ring":        MEADOW_PRIMARY,
        "disabled":          0xFFC2BFB6,
        "shadow":            MEADOW_SHADOW,
        "scheme":            "light"
    })
}

-- ── Bloom palette (mint sky + apricot peach + coral) ──

