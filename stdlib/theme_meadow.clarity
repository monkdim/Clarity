let BLOOM_BORDER     = 0xFFE4E0D0
let BLOOM_SHADOW     = 0x4031708E

fn bloom() {
    return _merge(_BASE_SHARED, {
        "name":              "Bloom",
        "id":                "bloom",
        "background":        BLOOM_CANVAS,
        "surface":           BLOOM_SURFACE,
        "surface_elevated":  BLOOM_SURFACE_2,
        "border":            BLOOM_BORDER,
        "foreground":        BLOOM_INK,
        "foreground_muted":  BLOOM_MUTED,
        "ink_soft":          0xFF374151,
        "primary":           BLOOM_PRIMARY,
        "primary_dark":      BLOOM_PRIMARY_D,
        "accent":            BLOOM_PRIMARY,
        "accent_secondary":  BLOOM_SECONDARY,
        "accent_tertiary":   BLOOM_TERTIARY,
        "highlight":         BLOOM_HIGHLIGHT,
        "selection":         0x405BC0BE,
        "danger":            BLOOM_TERTIARY,
        "warning":           BLOOM_HIGHLIGHT,
        "success":           BLOOM_PRIMARY,
        "focus_ring":        BLOOM_PRIMARY,
        "disabled":          0xFFCBD2D9,
        "shadow":            BLOOM_SHADOW,
        "scheme":            "light"
    })
}

-- ── Watercolor palette (parchment + dreamy pastels) ──

let WC_CANVAS    = 0xFFFBF7F0
let WC_SURFACE   = 0xFFFFFFFF
let WC_SURFACE_2 = 0xFFF5EFE0
let WC_INK       = 0xFF3D405B
let WC_PRIMARY   = 0xFFB8C5A6
let WC_PRIMARY_D = 0xFF7E8C6A
let WC_SECONDARY = 0xFFF2C4C2
let WC_TERTIARY  = 0xFFC8DDE9
let WC_HIGHLIGHT = 0xFFF1E3B6
let WC_MUTED     = 0xFFB0A8B9
let WC_BORDER    = 0xFFE5DFCE
let WC_SHADOW    = 0x4045485E

fn watercolor() {
    return _merge(_BASE_SHARED, {
        "name":              "Watercolor",
        "id":                "watercolor",
        "background":        WC_CANVAS,
        "surface":           WC_SURFACE,
        "surface_elevated":  WC_SURFACE_2,
        "border":            WC_BORDER,
        "foreground":        WC_INK,
        "foreground_muted":  WC_MUTED,
        "ink_soft":          0xFF55587A,
        "primary":           WC_PRIMARY,
        "primary_dark":      WC_PRIMARY_D,
        "accent":            WC_PRIMARY,
        "accent_secondary":  WC_SECONDARY,
        "accent_tertiary":   WC_TERTIARY,
        "highlight":         WC_HIGHLIGHT,
        "selection":         0x40B8C5A6,
        "danger":            0xFFE5A0A0,
        "warning":           WC_HIGHLIGHT,
        "success":           WC_PRIMARY_D,
        "focus_ring":        WC_PRIMARY_D,
        "disabled":          0xFFD0CCD8,
        "shadow":            WC_SHADOW,
        "scheme":            "light"
    })
}

-- ── Brand gradient sampler ─────────────────────

-- Spring brand spine: sky → primary → secondary. Used by focus
-- rings, dock accent stripe, progress bar fills, splash spinner.
fn brand_gradient(theme, t) {
    mut clamped = t
    if clamped < 0.0 { clamped = 0.0 }
    if clamped > 1.0 { clamped = 1.0 }
    let stops = [
        {"t": 0.0, "color": theme["highlight"]},
        {"t": 0.5, "color": theme["primary"]},
        {"t": 1.0, "color": theme["accent_secondary"]}
    ]
    return _lerp_along(stops, clamped)
}

fn warm_gradient(theme, t) {
    mut clamped = t
    if clamped < 0.0 { clamped = 0.0 }
    if clamped > 1.0 { clamped = 1.0 }
    let stops = [
        {"t": 0.0, "color": theme["accent_secondary"]},
        {"t": 0.5, "color": theme["accent_tertiary"]},
        {"t": 1.0, "color": theme["highlight"]}
    ]
    return _lerp_along(stops, clamped)
}

fn _lerp_along(stops, t) {
    mut i = 0
    while i < len(stops) - 1 {
        let a = stops[i]
        let b = stops[i + 1]
        if t >= a["t"] and t <= b["t"] {
            let span = b["t"] - a["t"]
            let local = if span == 0.0 { 0.0 } else { (t - a["t"]) / span }
            return _lerp_color(a["color"], b["color"], local)
        }
        i = i + 1
    }
    return stops[len(stops) - 1]["color"]
}

fn _lerp_color(a, b, t) {
    -- Unpack via division so the high byte of 0xFF...... ARGB
    -- constants doesn't get sign-extended (Clarity's `>> 24`
    -- treats the value as int32).
    let aa = int(a / 16777216) & 0xFF
    let ar = int(a / 65536) & 0xFF
    let ag = int(a / 256) & 0xFF
    let ab = a & 0xFF
    let ba = int(b / 16777216) & 0xFF
    let br = int(b / 65536) & 0xFF
    let bg = int(b / 256) & 0xFF
    let bb = b & 0xFF
    let oa = int(aa + (ba - aa) * t)
    let or_ = int(ar + (br - ar) * t)
    let og = int(ag + (bg - ag) * t)
    let ob = int(ab + (bb - ab) * t)
    return oa * 16777216 + or_ * 65536 + og * 256 + ob
}

fn default_spring_theme() { return meadow() }

fn spring_palettes() {
    return [meadow(), bloom(), watercolor()]
}
