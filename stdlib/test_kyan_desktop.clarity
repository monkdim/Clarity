-- KyanDesktop tests — rebrand phase K3.
--
-- Proves a real desktop composes and paints outside a test harness:
-- wallpaper + real Compositor app windows with Kyan glass chrome +
-- floating dock, and that mouse events drive the real WindowManager
-- (the input path the old DisplayServer got wrong).

from "kyan_desktop.clarity" import kyan_desktop, KyanDesktop
from "theme_kyan.clarity" import kyan_obsidian
from "graphics.clarity" import framebuffer
from "mouse.clarity" import MouseEvent
from "kyan_apps.clarity" import _calc_layout, _settings_layout, _files_layout

mut PASSED = 0
mut FAILED = 0

fn assert(val, msg) {
    if val { PASSED += 1 } else { FAILED += 1; show "  FAIL: " + msg }
}
fn assert_eq(actual, expected, msg) {
    if actual == expected { PASSED += 1 }
    else { FAILED += 1; show "  FAIL: {msg} (expected {expected}, got {actual})" }
}

fn mk_mouse(x, y, kind, button) {
    let m = MouseEvent()
    m.x = x
    m.y = y
    m.button = button
    if kind == "press" { m.is_press = true }
    if kind == "release" { m.is_release = true }
    if kind == "motion" { m.is_motion = true }
    return m
}

let theme = kyan_obsidian()

-- ── Construction & app windows are real Windows ──

show "-- KyanDesktop: windows are real --"

let d = kyan_desktop(1000, 640, theme)
d.boot(null)
assert_eq(len(d.running()), 0, "no apps at boot")

let term = d.open("terminal", 120, 90, 360, 240)
-- a real Window, not a dict: has a framebuffer and methods
assert(term.framebuffer != null, "app window owns a framebuffer")
assert_eq(term.width, 360, "window width")
assert(term.focused, "opened window is focused")
assert_eq(len(d.running()), 1, "one app running")

let files = d.open("files", 260, 160, 380, 260)
assert(files.focused, "newly opened window focused")
assert(not term.focused, "previous window blurred")
-- z-order: top window is the most-recently focused
assert_eq(d.comp.top_window(), files, "files on top")

-- focus switches z-order through the real compositor
d.focus("terminal")
assert_eq(d.comp.top_window(), term, "focus brings terminal to top")
assert(term.focused, "terminal focused")

-- hit-testing goes through the compositor
assert_eq(d.comp.window_at(300, 200), term, "window_at returns top window under point")
assert(d.comp.window_at(5, 5) == null, "empty desktop area hits nothing")

-- ── Composition actually paints ──────────────────

show "-- KyanDesktop: composition paints --"

let screen = d.compose()
assert_eq(screen.width, 1000, "screen width")
assert_eq(screen.height, 640, "screen height")

-- wallpaper: the aurora glow tints the background away from pure void
let void = theme["background"]
let glow_px = screen.get_pixel(850, 520)
assert(glow_px != void, "wallpaper glow tints the canvas")

-- an app window composited: terminal is on top at (120,90); its round
-- red traffic light is centred at window-local (19, title_h/2)=(19,16).
-- The window rides at <100% over a frosted-glass base, so the dot is the
-- source red composited through the glass — assert it's red-dominant (the
-- chrome landed on screen) rather than an exact source colour.
let dot = screen.get_pixel(120 + 19, 90 + 16)
let dot_r = int(dot / 65536) & 0xFF
let dot_g = int(dot / 256) & 0xFF
let dot_b = dot & 0xFF
assert(dot_r > 150 and dot_r > dot_g + 60 and dot_r > dot_b + 40, "focused window's traffic dot painted on screen (red through glass)")

-- focused window shows the signature rail (not the plain border) on top
let rail = screen.get_pixel(120 + 180, 90 + 1)
assert(rail != theme["border"], "focused window has a signature top rail")

-- dock: the glass pill sits centred along the bottom; sample its band
let dock_y = 640 - (44 + 24) - 16 + 20
let dock_px = screen.get_pixel(500, dock_y)
assert(dock_px != void, "dock band painted over the wallpaper")

-- ── Mouse drives the real WindowManager ──────────

show "-- KyanDesktop: input → WindowManager --"

-- fresh desktop, single window so it's unambiguously on top
let d2 = kyan_desktop(1000, 640, theme)
d2.boot(null)
let w = d2.open("editor", 200, 150, 300, 200)
assert_eq(w.x, 200, "window starts at x=200")

-- press on the title bar, then drag +60,+40
d2.handle_mouse(mk_mouse(240, 160, "press", 1))     -- title bar (ly=10 < 32)
assert(d2.wm.is_dragging(), "press on title starts a drag")
d2.handle_mouse(mk_mouse(300, 200, "motion", 0))     -- dx=60, dy=40
assert_eq(w.x, 260, "drag moved window x by 60")
assert_eq(w.y, 190, "drag moved window y by 40")
d2.handle_mouse(mk_mouse(300, 200, "release", 0))
assert(not d2.wm.is_dragging(), "release ends the drag")

-- a press in empty space doesn't start a drag
d2.handle_mouse(mk_mouse(5, 5, "press", 1))
assert(not d2.wm.is_dragging(), "press on empty desktop starts no drag")

-- ── Dock clicks launch apps ──────────────────────

show "-- KyanDesktop: dock is interactive --"

let d3 = kyan_desktop(1000, 640, theme)
d3.boot(null)
assert_eq(len(d3.running()), 0, "nothing running yet")
-- the dock layout tells us where the first icon (prism) sits
let dl = d3._dock_layout()
let ic0 = dl["icons"][0]
let cxp = ic0["x"] + int(ic0["size"] / 2)
let cyp = ic0["y"] + int(ic0["size"] / 2)
-- clicking it opens that app
d3.handle_mouse(mk_mouse(cxp, cyp, "press", 1))
d3.handle_mouse(mk_mouse(cxp, cyp, "release", 0))
assert(contains(d3.running(), ic0["app"]), "clicking a dock icon opened its app")
assert_eq(len(d3.running()), 1, "one app running after dock click")
-- clicking the same icon again just focuses (no duplicate window)
d3.handle_mouse(mk_mouse(cxp, cyp, "press", 1))
assert_eq(len(d3.running()), 1, "re-clicking dock icon does not duplicate")
-- a click on empty dock area (below the pill) starts no drag and opens nothing
assert(d3._dock_hit(5, 5) == null, "dock hit-test misses empty space")

-- ── Launcher overlay ─────────────────────────────

show "-- KyanDesktop: launcher overlay --"

assert(not d.launcher_open, "launcher starts closed")
d.toggle_launcher()
assert(d.launcher_open, "toggle opens launcher")
let sc2 = d.compose()
-- the scrim darkens a previously-bright glow pixel
let scrimmed = sc2.get_pixel(850, 520)
assert(scrimmed != glow_px, "launcher scrim changes the composited canvas")
d.toggle_launcher()
assert(not d.launcher_open, "toggle closes launcher")

-- clicking a launcher cell opens that app and dismisses the launcher
let d4 = kyan_desktop(1000, 640, theme)
d4.boot(null)
d4.toggle_launcher()
let ll = d4._launcher_layout()
let cell0 = ll["cells"][0]
d4.handle_mouse(mk_mouse(cell0["x"] + 40, cell0["y"] + 30, "press", 1))
assert(not d4.launcher_open, "picking a launcher app closes the launcher")
assert(contains(d4.running(), cell0["app"]), "launcher pick opened the app")
-- opening the launcher and clicking empty space just dismisses it
d4.toggle_launcher()
assert(d4.launcher_open, "launcher reopened")
d4.handle_mouse(mk_mouse(2, 2, "press", 1))
assert(not d4.launcher_open, "click outside dismisses launcher")

-- ── Launcher search: type to filter, Enter opens the top match ──
let ds = kyan_desktop(1000, 640, theme)
ds.boot(null)
-- typing while closed is a no-op
assert(not ds.launcher_type("x"), "typing does nothing while launcher is closed")
ds.toggle_launcher()
assert_eq(len(ds._filtered_apps()), len(ds.pinned), "empty query shows every pinned app")
-- "cal" narrows to Calculator only
ds.launcher_type("c")
ds.launcher_type("a")
ds.launcher_type("l")
let hits = ds._filtered_apps()
assert_eq(len(hits), 1, "query 'cal' matches one app")
assert_eq(hits[0], "calc", "query 'cal' matches the Calculator")
-- the filtered launcher still composes without crashing
let scq = ds.compose()
assert(scq != null, "launcher composes with an active query")
-- backspace widens the match set again
ds.launcher_backspace()
ds.launcher_backspace()
ds.launcher_backspace()
assert_eq(len(ds._filtered_apps()), len(ds.pinned), "backspacing to empty restores all apps")
-- Enter opens the top match and dismisses the launcher
ds.launcher_type("t")
ds.launcher_type("e")
ds.launcher_type("r")
assert(ds.launcher_submit(), "submit succeeds when a match exists")
assert(not ds.launcher_open, "submit closes the launcher")
assert(contains(ds.running(), "terminal"), "submit opened the matched Terminal")
-- a query that matches nothing: submit is a safe no-op
ds.toggle_launcher()
ds.launcher_type("z")
ds.launcher_type("z")
ds.launcher_type("z")
assert_eq(len(ds._filtered_apps()), 0, "nonsense query matches nothing")
assert(not ds.launcher_submit(), "submit on no matches returns false")
assert(ds.launcher_open, "launcher stays open when submit finds nothing")
-- reopening always clears the previous query
ds.toggle_launcher()
ds.toggle_launcher()
assert_eq(len(ds._filtered_apps()), len(ds.pinned), "reopening the launcher clears the query")

-- ── Voidrunner: launch, tick, Prism Play button ──

show "-- KyanDesktop: game integration --"

let dg = kyan_desktop(1000, 640, theme)
dg.boot(null)
-- opening voidrunner seeds live state
let vw = dg.open("voidrunner", 100, 100, 560, 440)
assert(has(dg.app_state, "voidrunner"), "voidrunner state seeded on open")
assert(not dg.app_state["voidrunner"]["dead"], "game starts alive")
-- keys + tick advance the game
dg.set_key("ArrowRight", true)
let sx0 = dg.app_state["voidrunner"]["ship_x"]
dg.tick(0)
dg.tick(16)
dg.tick(32)
assert(dg.app_state["voidrunner"]["ship_x"] > sx0, "tick + key state moves the ship")
-- closing clears the state
dg.close("voidrunner")
assert(not has(dg.app_state, "voidrunner"), "close clears game state")

-- ── System Monitor: live app seeds + drifts ──

let dm = kyan_desktop(1000, 640, theme)
dm.boot(null)
dm.open("monitor", 120, 90, 520, 420)
assert(has(dm.app_state, "monitor"), "monitor state seeded on open")
let mcpu0 = dm.app_state["monitor"]["cpu"]
dm.tick(0)
dm.tick(16)
dm.tick(32)
assert(dm.app_state["monitor"]["cpu"] != mcpu0, "tick drives the monitor's live readings")
assert(dm.needs_redraw(), "an open monitor keeps the desktop live")
dm.close("monitor")
assert(not has(dm.app_state, "monitor"), "close clears monitor state")

-- Prism's Play button launches Voidrunner
let dp = kyan_desktop(1000, 640, theme)
dp.boot(null)
let pw = dp.open("prism", 120, 80, 680, 460)
let cr = pw.content_rect()
-- click the centre of the play pill (see prism_play_rect: content + [168,104,90,24])
dp.handle_mouse(mk_mouse(pw.x + cr[0] + 168 + 45, pw.y + cr[1] + 104 + 12, "press", 1))
assert(contains(dp.running(), "voidrunner"), "Prism Play button launched Voidrunner")

-- ── open animation drives redraw, then settles ───

let da = kyan_desktop(1000, 640, theme)
da.boot(null)
da.tick(1000.0)
da.open("files", 120, 90, 400, 300)
da.tick(1040.0)                                   -- 40ms into a 220ms open
let mid = da._anim_state("files")
assert(mid["active"], "window reports an active open animation")
assert(mid["alpha"] < 255, "opening window is still fading in")
da.compose()                                      -- the host loop composes each dirty frame
assert(da.needs_redraw(), "mid-animation still asks for a redraw")
da.tick(1300.0)                                   -- past the animation
da.compose()                                      -- sweeps the finished animation, clears dirty
assert(not da._anim_state("files")["active"], "animation cleared once complete")
assert(not da.needs_redraw(), "settled desktop is idle (no redraw)")

-- ── Calculator: clicking keys computes on the desktop ──

fn _key_center(cells, k) {
    for cell in cells {
        if cell["key"] == k { return [cell["x"] + int(cell["w"] / 2), cell["y"] + int(cell["h"] / 2)] }
    }
    return null
}

let dc = kyan_desktop(1000, 640, theme)
dc.boot(null)
let cwin = dc.open("calc", 100, 80, 300, 420)
assert(dc._app_ui["calc"] != null, "opening calc seeds its UI state")
let ccr = cwin.content_rect()
let cells = _calc_layout(cwin.x + ccr[0], cwin.y + ccr[1], ccr[2], ccr[3])
for k in ["7", "*", "8", "="] {
    let ctr = _key_center(cells, k)
    dc.handle_mouse(mk_mouse(ctr[0], ctr[1], "press", 1))
}
assert_eq(dc._app_ui["calc"]["display"], "56", "clicking 7 * 8 = shows 56 on the desktop")
-- closing the calc frees its UI state
dc.close("calc")
assert(not has(dc._app_ui, "calc"), "closing calc frees its UI state")

-- ── Settings: toggles flip prefs, swatches switch the theme ──
let ds = kyan_desktop(1000, 640, theme)
ds.boot(null)
let swin = ds.open("settings", 60, 50, 640, 400)
let scr = swin.content_rect()
let SL = _settings_layout(swin.x + scr[0], swin.y + scr[1], scr[2], scr[3])
-- click the first toggle (frosted glass) → pref flips
let tg0 = SL["toggles"][0]
let was_frosted = ds.prefs["frosted"]
ds.handle_mouse(mk_mouse(tg0["x"] + int(tg0["w"] / 2), tg0["y"] + int(tg0["h"] / 2), "press", 1))
assert(ds.prefs["frosted"] != was_frosted, "clicking a toggle flips its preference")
-- click the Quartz swatch (index 1) → theme switches live
let sw1 = SL["swatches"][1]
ds.handle_mouse(mk_mouse(sw1["x"] + int(sw1["w"] / 2), sw1["y"] + int(sw1["h"] / 2), "press", 1))
assert_eq(ds.prefs["theme"], "quartz", "clicking a swatch sets the active theme id")
assert(ds.theme["background"] != theme["background"], "the desktop theme actually changed (Quartz ≠ Obsidian)")
-- animations pref gates the open animation
ds.prefs["animations"] = false
assert(not ds._anim_state("prism")["active"], "disabling animations makes windows draw at rest")

-- ── Files: clicking a folder row navigates into it ──
let df = kyan_desktop(1000, 640, theme)
df.boot(null)
let fwin = df.open("files", 80, 60, 420, 340)
assert(df._app_ui["files"] != null, "opening files seeds its navigation state")
assert_eq(len(df._app_ui["files"]["path"]), 0, "files opens at the Home root")
let fcr = fwin.content_rect()
let FL = _files_layout(df._app_ui["files"], fwin.x + fcr[0], fwin.y + fcr[1], fcr[2], fcr[3])
-- the first row is a folder; clicking it descends
let frow = FL["rows"][0]
df.handle_mouse(mk_mouse(frow["x"] + 20, frow["y"] + 8, "press", 1))
assert_eq(len(df._app_ui["files"]["path"]), 1, "clicking a folder row descends into it")
-- clicking the Home breadcrumb returns to the root
let FL2 = _files_layout(df._app_ui["files"], fwin.x + fcr[0], fwin.y + fcr[1], fcr[2], fcr[3])
let hc = FL2["crumbs"][0]
df.handle_mouse(mk_mouse(hc["x"] + 4, hc["y"] + 4, "press", 1))
assert_eq(len(df._app_ui["files"]["path"]), 0, "clicking the Home crumb returns to the root")
-- closing files frees its navigation state
df.close("files")
assert(not has(df._app_ui, "files"), "closing files frees its navigation state")

-- ── close ────────────────────────────────────────

assert(d.close("terminal"), "close terminal")
assert_eq(len(d.running()), 1, "one app left after close")
assert(not d.close("terminal"), "closing again is a no-op")

-- ── Summary ──────────────────────────────────────

show ""
show "KyanDesktop: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " kyan desktop test(s) failed" }
