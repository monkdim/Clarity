-- Profiler Tests — exercise the self-hosted profiler.clarity API.
-- Records calls/lines on a Profiler instance and inspects the resulting stats.

from "profiler.clarity" import Profiler
from "lexer.clarity" import tokenize
from "parser.clarity" import parse

mut PASSED = 0
mut FAILED = 0

fn assert(val, msg) {
    if val {
        PASSED += 1
    } else {
        FAILED += 1
        show "  FAIL: " + msg
    }
}

fn assert_eq(actual, expected, msg) {
    if actual == expected {
        PASSED += 1
    } else {
        FAILED += 1
        show "  FAIL: " + msg + " (expected " + str(expected) + ", got " + str(actual) + ")"
    }
}

-- The Profiler reads its source file in init(), so write a tiny one to /tmp.
let _PROF_SRC = "/tmp/_profiler_test_src.clarity"
write(_PROF_SRC, "let x = 1\nshow x\n")

-- ── Initialization ──────────────────────────────────────

show "-- Profiler: Init --"

let prof = Profiler(_PROF_SRC)
assert(prof != null, "profiler creates")
assert_eq(prof.source_path, _PROF_SRC, "stores source path")
assert_eq(type(prof.function_stats), "map", "function_stats is a map")
assert_eq(type(prof.line_stats), "map", "line_stats is a map")
assert_eq(len(keys(prof.function_stats)), 0, "function_stats starts empty")
assert_eq(len(keys(prof.line_stats)), 0, "line_stats starts empty")

-- ── Time formatting ─────────────────────────────────────

show "-- Profiler: Time Formatting --"

assert(ends(prof.fmt_time(0.0000005), "us"), "microseconds suffix")
assert(ends(prof.fmt_time(0.005), "ms"), "milliseconds suffix")
assert(ends(prof.fmt_time(1.5), "s"), "seconds suffix")

-- ── Heat bar ────────────────────────────────────────────

show "-- Profiler: Heat Bar --"

let bar_full = prof.heat_bar(1.0, 1.0)
assert(len(bar_full) > 0, "full heat bar non-empty")
let bar_half = prof.heat_bar(0.5, 1.0)
assert(len(bar_half) > 0, "half heat bar non-empty")
let bar_zero_max = prof.heat_bar(0.0, 0.0)
assert_eq(bar_zero_max, "", "heat bar with zero max returns empty")

-- ── Call recording ──────────────────────────────────────

show "-- Profiler: Recording --"

prof.record_call("foo", "<main>", 0.001)
prof.record_call("foo", "<main>", 0.002)
prof.record_call("bar", "<main>", 0.005)

assert(has(prof.function_stats, "foo"), "foo recorded")
assert(has(prof.function_stats, "bar"), "bar recorded")
assert_eq(prof.function_stats["foo"]["calls"], 2, "foo called twice")
assert_eq(prof.function_stats["bar"]["calls"], 1, "bar called once")

-- ── Caller tracking ─────────────────────────────────────

show "-- Profiler: Callers --"

let prof3 = Profiler(_PROF_SRC)
prof3.record_call("inner", "outer", 0.001)
prof3.record_call("inner", "outer", 0.001)
prof3.record_call("inner", "main", 0.001)

assert_eq(prof3.function_stats["inner"]["calls"], 3, "caller tracking total calls")
assert_eq(prof3.function_stats["inner"]["callers"]["outer"], 2, "outer caller count")
assert_eq(prof3.function_stats["inner"]["callers"]["main"], 1, "main caller count")

-- ── Line recording ──────────────────────────────────────

show "-- Profiler: Lines --"

let prof4 = Profiler(_PROF_SRC)
prof4.record_line(5, 0.001)
prof4.record_line(5, 0.002)
prof4.record_line(10, 0.003)

assert_eq(prof4.line_stats["5"]["hits"], 2, "line 5 hits")
assert_eq(prof4.line_stats["10"]["hits"], 1, "line 10 hits")

-- ── Real execution path (regression: execute_stmt → execute) ──
-- profile_stmts must actually run each statement through the interpreter.
-- This is the path that was silently broken: it called a nonexistent
-- Interpreter.execute_stmt(), so every `clarity profile` died with an
-- empty "Runtime error: {}" and recorded nothing past the first line.

show "-- Profiler: real execution --"

let _RUN_SRC = "/tmp/_profiler_run_src.clarity"
write(_RUN_SRC, "let a = 2 + 3\nlet b = a * 4\nshow b\n")
let prun = Profiler(_RUN_SRC)
let toks = tokenize(prun.source, prun.source_path)
let tree = parse(toks, prun.source)
-- must not throw, and must actually execute (defining a, then b from a)
prun.profile_stmts(tree.body, "<main>")
assert(len(keys(prun.line_stats)) >= 3, "profiler records a hit for every executed line")
assert(has(prun.line_stats, "2"), "line 2 (let b = a * 4) executed — depends on line 1's binding")
-- the interpreter actually evaluated the program: b == 20 lives in its env
assert_eq(prun.interp.global_env.get("b", 0), 20, "statements really ran through the interpreter (b = 20)")
exec("rm -f " + _RUN_SRC)

-- ── get_stats snapshot ──────────────────────────────────

show "-- Profiler: get_stats --"

let snapshot = prof.get_stats()
assert(has(snapshot, "wall_time"), "snapshot has wall_time")
assert(has(snapshot, "functions"), "snapshot has functions")
assert(has(snapshot, "lines"), "snapshot has lines")

-- ── Cleanup ─────────────────────────────────────────────

exec("rm -f " + _PROF_SRC)

-- ── Summary ─────────────────────────────────────────────

show ""
show "Profiler: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " profiler test(s) failed" }
