-- KyanOS app content painter tests — rebrand phase K4.

from "kyan_apps.clarity" import new_editor, editor_input, editor_click, paint_editor, _editor_layout, paint_prism, new_prism, prism_hit, paint_terminal_content, new_shell, shell_input, paint_shell, paint_files_content, paint_monitor_content, paint_monitor, new_monitor, monitor_tick, paint_settings_content, paint_settings, settings_hit, new_prefs, paint_calc_content, paint_calc, app_painters, new_calc, calc_press, calc_key_at, new_files, files_entries, files_nav, files_up, files_goto, files_click, files_hit, _files_layout, paint_files, _file_kind
from "theme_kyan.clarity" import kyan_obsidian
from "graphics.clarity" import framebuffer

mut PASSED = 0
mut FAILED = 0

fn assert(val, msg) {
    if val { PASSED += 1 } else { FAILED += 1; show "  FAIL: " + msg }
}
fn assert_eq(actual, expected, msg) {
    if actual == expected { PASSED += 1 }
    else { FAILED += 1; show "  FAIL: {msg} (expected {expected}, got {actual})" }
}

fn painted(fb, bg) {
    mut y = 0
    while y < fb.height {
        mut x = 0
        while x < fb.width {
            if fb.get_pixel(x, y) != bg { return true }
            x = x + 4
        }
        y = y + 4
    }
    return false
}

let t = kyan_obsidian()

-- ── registry ──
show "-- Kyan apps: registry --"
let reg = app_painters()
assert(has(reg, "prism"), "prism painter registered")
assert(has(reg, "terminal"), "terminal painter registered")
assert(has(reg, "files"), "files painter registered")

-- ── Prism ──
show "-- Kyan apps: prism --"
let pstate = new_prism()
assert_eq(pstate["view"], "library", "prism starts in the library view")
let fp = framebuffer(680, 420)
fp.clear(0xFF000000)
paint_prism(fp, 0, 0, 680, 420, t, pstate)
assert(painted(fp, 0xFF000000), "prism paints content")
-- sidebar band on the left uses the elevated surface
assert_eq(fp.get_pixel(40, 200), t["surface_elevated"], "prism sidebar painted")
-- the featured card region (right of the sidebar) is not empty
assert(fp.get_pixel(400, 60) != 0xFF000000, "prism featured card painted")
-- a tiny content area is a no-op, not a crash
let tiny = framebuffer(60, 60)
tiny.clear(0xFF000000)
paint_prism(tiny, 0, 0, 60, 60, t, new_prism())
assert(true, "prism tolerates a tiny content rect")

-- the featured Play pill launches the game
let hplay = prism_hit(pstate, 0, 0, 680, 420, 168 + 45, 104 + 12)
assert(hplay != null and hplay["kind"] == "play", "clicking the featured Play pill launches the game")
-- clicking a grid tile opens that game's detail view
let hgrid = prism_hit(pstate, 0, 0, 680, 420, 220, 200)
assert(hgrid != null and hgrid["kind"] == "open", "clicking a library tile opens a detail view")
assert(hgrid["idx"] >= 1, "the opened tile maps to a catalogue game")
-- drive the state into the detail view and paint it
pstate["view"] = "detail"
pstate["sel"] = hgrid["idx"]
let fp2 = framebuffer(680, 420)
fp2.clear(0xFF000000)
paint_prism(fp2, 0, 0, 680, 420, t, pstate)
assert(painted(fp2, 0xFF000000), "prism paints the detail view")
-- in detail view, the back affordance returns to the library
let hback = prism_hit(pstate, 0, 0, 680, 420, 150, 20)
assert(hback != null and hback["kind"] == "back", "the detail view has a working Back affordance")
-- and its Play button launches the game
let hdplay = prism_hit(pstate, 0, 0, 680, 420, 150 + 20, 44 + 150 + 74 + 16)
assert(hdplay != null and hdplay["kind"] == "play", "the detail view's Play button launches the game")

-- ── Terminal ──
show "-- Kyan apps: terminal --"
let ft = framebuffer(360, 200)
ft.clear(0xFF112233)
paint_terminal_content(ft, 0, 0, 360, 200, t, true)
-- terminal fills its own void-black background
assert_eq(ft.get_pixel(2, 2), 0xFF05060A, "terminal fills void background")
assert(painted(ft, 0xFF05060A), "terminal draws prompt text over the void")

-- ── Terminal echo shell ──
show "-- Kyan apps: shell --"
fn has_line(lines, s) {
    mut i = 0
    while i < len(lines) {
        if lines[i] == s { return true }
        i = i + 1
    }
    return false
}
let sh = new_shell()
assert(has_line(sh["lines"], "KyanOS shell - type 'help' for commands"), "shell shows a banner")
-- typing appends to the input line without running
shell_input(sh, "he")
assert_eq(sh["input"], "he", "typed chars accumulate in the input")
-- backspace deletes the last char (host feeds DEL, code 127)
shell_input(sh, from_char_code(127))
assert_eq(sh["input"], "h", "backspace removes the last typed char")
-- an escape/arrow sequence is swallowed, not pasted into the prompt
shell_input(sh, from_char_code(27) + "[A")
assert_eq(sh["input"], "h", "arrow-key CSI sequences are swallowed")
-- finishing the word and pressing Enter runs `help`
shell_input(sh, "elp\n")
assert_eq(sh["input"], "", "Enter clears the input line")
assert(has_line(sh["lines"], "kyan > help"), "the command is echoed with a prompt")
assert(has_line(sh["lines"], "commands: help  ls  clarity  echo <text>  neofetch  clear"), "help lists the commands")
-- echo prints its argument verbatim
shell_input(sh, "echo hi there\n")
assert(has_line(sh["lines"], "hi there"), "echo prints its argument")
-- an unknown command reports not found
shell_input(sh, "bogus\n")
assert(has_line(sh["lines"], "command not found: bogus"), "unknown commands report not found")
-- clear empties the scrollback
shell_input(sh, "clear\n")
assert_eq(len(sh["lines"]), 0, "clear empties the scrollback")
-- and the shell paints over its own void background
let fsh = framebuffer(360, 200)
fsh.clear(0xFF112233)
paint_shell(fsh, 0, 0, 360, 200, t, new_shell())
assert_eq(fsh.get_pixel(2, 2), 0xFF05060A, "shell fills the void background")
assert(painted(fsh, 0xFF05060A), "shell paints the banner and prompt")

-- ── Text editor ──
show "-- Kyan apps: editor --"
let ed = new_editor()
let ed_lines0 = len(ed["lines"])
assert(ed_lines0 > 0, "a new editor has a starter buffer")
assert_eq(ed["cy"], 0, "the cursor starts on the first line")
assert_eq(ed["cx"], 0, "the cursor starts at column 0")
-- typing inserts at the cursor
editor_input(ed, "X")
assert_eq(ed["cx"], 1, "typing advances the cursor")
assert_eq(substring(ed["lines"][0], 0, 1), "X", "the typed char lands at the cursor")
-- backspace removes it again (host feeds DEL, code 127)
editor_input(ed, from_char_code(127))
assert_eq(ed["cx"], 0, "backspace pulls the cursor back")
-- Enter splits the current line in two
let ed2 = new_editor()
editor_input(ed2, "ab")           -- line 0 -> "ab" + rest of the welcome line
let joinpt = ed2["cx"]            -- the split column (2), where a merge rejoins
editor_input(ed2, "\n")
assert_eq(ed2["cy"], 1, "Enter moves the cursor to the new line")
assert_eq(ed2["cx"], 0, "Enter puts the cursor at the start of the new line")
assert_eq(len(ed2["lines"]), ed_lines0 + 1, "Enter adds a line to the buffer")
-- backspace at column 0 merges the line back into the previous one
editor_input(ed2, from_char_code(127))
assert_eq(len(ed2["lines"]), ed_lines0, "backspace at col 0 merges lines back")
assert_eq(ed2["cy"], 0, "the merge moves the cursor up a line")
assert_eq(ed2["cx"], joinpt, "the merge places the cursor at the join point")
-- arrow keys move the cursor without editing (ESC CSI sequences)
let ed3 = new_editor()
let ESC = from_char_code(27)
editor_input(ed3, ESC + "[B")     -- down
assert_eq(ed3["cy"], 1, "the Down arrow moves the cursor down a line")
editor_input(ed3, ESC + "[C")     -- right
assert_eq(ed3["cx"], 1, "the Right arrow moves the cursor right")
editor_input(ed3, ESC + "[D")     -- left
assert_eq(ed3["cx"], 0, "the Left arrow moves the cursor left")
editor_input(ed3, ESC + "[A")     -- up
assert_eq(ed3["cy"], 0, "the Up arrow moves the cursor up a line")
-- a click places the cursor on the clicked line
let ed4 = new_editor()
let L4 = _editor_layout(ed4, 0, 0, 480, 320)
assert(editor_click(ed4, 0, 0, 480, 320, L4["text_x"] + 1, L4["text_y"] + 2 * L4["line_h"] + 1), "a body click reports handled")
assert_eq(ed4["cy"], 2, "clicking the third row puts the cursor there")
-- a click in the status bar is not a text-body click
assert(not editor_click(ed4, 0, 0, 480, 320, 40, 320 - 4), "a status-bar click is not a body click")
-- the editor paints its buffer over the surface
let fed = framebuffer(480, 320)
fed.clear(0xFF000000)
paint_editor(fed, 0, 0, 480, 320, t, new_editor(), true)
assert_eq(fed.get_pixel(4, 40), t["surface_elevated"], "the editor draws a line-number gutter")
assert(painted(fed, 0xFF000000), "the editor paints its text buffer")

-- ── Files ──
show "-- Kyan apps: files --"
let ff = framebuffer(380, 240)
ff.clear(0xFF000000)
paint_files_content(ff, 0, 0, 380, 240, t, true)
-- left is the folder-tree sidebar (elevated); the main pane has a
-- breadcrumb header (elevated) over a surface body
assert_eq(ff.get_pixel(2, 120), t["surface_elevated"], "files draws the folder-tree sidebar")
assert_eq(ff.get_pixel(200, 2), t["surface_elevated"], "files draws the breadcrumb header")
assert_eq(ff.get_pixel(163, 120), t["surface"], "files fills the main pane below the header")
assert(painted(ff, 0xFF000000), "files draws rows")

-- ── System Monitor ──
show "-- Kyan apps: monitor --"
assert(has(reg, "monitor"), "monitor painter registered")
let fm = framebuffer(500, 420)
fm.clear(0xFF000000)
paint_monitor_content(fm, 0, 0, 500, 420, t, true)
assert_eq(fm.get_pixel(2, 2), t["surface"], "monitor fills the surface")
assert(painted(fm, 0xFF000000), "monitor draws cards / bars / processes")

-- live monitor: seeded state + a deterministic drift
let mon = new_monitor()
assert(mon["cpu"] > 0.0 and mon["cpu"] < 1.0, "monitor seeds a CPU load in range")
assert_eq(len(mon["cores"]), 8, "monitor has eight cores")
assert_eq(len(mon["procs"]), 5, "monitor lists processes")
-- a tick moves the readings but keeps them in range
let cpu0 = mon["cpu"]
monitor_tick(mon, 16.0)
assert(mon["cpu"] != cpu0, "a tick nudges the CPU load")
assert(mon["cpu"] >= 0.03 and mon["cpu"] <= 0.99, "CPU load stays clamped")
for c in mon["cores"] { assert(c >= 0.04 and c <= 0.99, "each core stays clamped") }
for p in mon["procs"] { assert(p["cpu"] >= 0.1 and p["cpu"] <= 60.0, "each process CPU stays clamped") }
-- the drift is deterministic from the seed: two fresh monitors ticked the
-- same number of times land on the same CPU load
let ma = new_monitor()
let mb = new_monitor()
mut _mi = 0
while _mi < 20 { monitor_tick(ma, 16.0); monitor_tick(mb, 16.0); _mi += 1 }
assert_eq(ma["cpu"], mb["cpu"], "monitor drift is deterministic from the seed")
assert(ma["cpu"] >= 0.03 and ma["cpu"] <= 0.99, "CPU load holds range over many ticks")
-- the live painter renders the ticked state onto a real buffer
let fm2 = framebuffer(500, 420)
fm2.clear(0xFF000000)
paint_monitor(fm2, 0, 0, 500, 420, t, ma)
assert(painted(fm2, 0xFF000000), "live monitor paints from its state")

-- ── Settings ──
show "-- Kyan apps: settings --"
assert(has(reg, "settings"), "settings painter registered")
let fs = framebuffer(560, 380)
fs.clear(0xFF000000)
paint_settings_content(fs, 0, 0, 560, 380, t, true)
assert_eq(fs.get_pixel(2, 2), t["surface_elevated"], "settings fills the sidebar")
assert(painted(fs, 0xFF000000), "settings draws swatches / toggles")

-- multi-pane settings: the sidebar switches panes
let sp = new_prefs()
assert_eq(sp["section"], "appearance", "settings starts on the Appearance pane")
let h_about = settings_hit(0, 0, 560, 380, 60, 140, sp)
assert(h_about != null and h_about["kind"] == "section" and h_about["id"] == "about", "clicking the About sidebar row selects that section")
let h_disp = settings_hit(0, 0, 560, 380, 60, 43, sp)
assert_eq(h_disp["id"], "display", "clicking the Display sidebar row selects it")
-- the Appearance controls are live only while Appearance is showing
let h_theme = settings_hit(0, 0, 560, 380, 200, 80, sp)
assert(h_theme != null and h_theme["kind"] == "theme", "a swatch click picks a theme on the Appearance pane")
sp["section"] = "about"
let h_inert = settings_hit(0, 0, 560, 380, 200, 80, sp)
assert(h_inert == null, "Appearance controls are inert on other panes")
-- every pane paints without error
for sec in ["appearance", "display", "network", "sound", "about"] {
    let pf = new_prefs()
    pf["section"] = sec
    let pfb = framebuffer(560, 380)
    pfb.clear(0xFF000000)
    paint_settings(pfb, 0, 0, 560, 380, t, pf)
    assert(painted(pfb, 0xFF000000), "settings paints the " + sec + " pane")
}

-- ── Calculator ──
show "-- Kyan apps: calc --"
assert(has(reg, "calc"), "calc painter registered")
let fc = framebuffer(300, 400)
fc.clear(0xFF000000)
paint_calc_content(fc, 0, 0, 300, 400, t, true)
assert(painted(fc, 0xFF000000), "calc draws display + keypad")
-- a small window must not crash the painters (clip guards)
paint_monitor_content(fc, 0, 0, 30, 20, t, true)
paint_settings_content(fc, 0, 0, 30, 20, t, true)
paint_calc_content(fc, 0, 0, 30, 20, t, true)
assert(true, "painters survive a tiny content rect")

-- ── Calculator logic ──
show "-- Kyan apps: calculator --"
fn calc_seq(keys) {
    let s = new_calc()
    for k in keys { calc_press(s, k) }
    return s["display"]
}
assert_eq(calc_seq(["8", "*", "8", "="]), "64", "8 * 8 = 64")
assert_eq(calc_seq(["1", "2", "+", "3", "0", "="]), "42", "12 + 30 = 42")
assert_eq(calc_seq(["1", "0", "0", "/", "4", "="]), "25", "100 / 4 = 25")
assert_eq(calc_seq(["7", "-", "9", "="]), "-2", "7 - 9 = -2")
assert_eq(calc_seq(["2", "+", "3", "*", "4", "="]), "20", "chained ops evaluate left-to-right")
assert_eq(calc_seq(["1", ".", "5", "+", "2", ".", "5", "="]), "4", "decimals: 1.5 + 2.5 = 4")
assert_eq(calc_seq(["9", "9", "C"]), "0", "C clears to 0")
assert_eq(calc_seq(["5", "+/-"]), "-5", "+/- negates")
assert_eq(calc_seq(["5", "0", "%"]), "0.5", "% divides by 100")
-- divide by zero is safe (no crash)
assert_eq(calc_seq(["5", "/", "0", "="]), "0", "divide by zero returns 0, no crash")
-- hit-test finds keys inside the keypad and nothing outside it
let hk = calc_key_at(0, 0, 300, 400, 40, 120)
assert(hk != null, "calc_key_at finds a key inside the pad")
assert_eq(calc_key_at(0, 0, 300, 400, -5, -5), null, "calc_key_at misses outside the pad")

-- ── Calculator: scientific mode ──
show "-- Kyan apps: scientific calculator --"
fn approx(a, b) { mut d = a - b; if d < 0.0 { d = 0.0 - d } return d < 0.0001 }
-- the mode pill toggles basic ⇄ scientific
let cm = new_calc()
assert(not cm["sci"], "calc starts in basic mode")
calc_press(cm, "mode")
assert(cm["sci"], "mode pill switches to scientific")
calc_press(cm, "mode")
assert(not cm["sci"], "mode pill switches back to basic")
-- unary functions apply immediately to the current value
assert_eq(calc_seq(["9", "sqrt"]), "3", "√9 = 3")
assert_eq(calc_seq(["5", "x^2"]), "25", "5² = 25")
assert_eq(calc_seq(["4", "1/x"]), "0.25", "1/4 = 0.25")
assert_eq(calc_seq(["0", "sin"]), "0", "sin(0) = 0")
assert_eq(calc_seq(["0", "cos"]), "1", "cos(0) = 1")
assert(approx(float(calc_seq(["1", "0", "0", "log"])), 2.0), "log10(100) ≈ 2")
-- power is a binary op like the others
assert_eq(calc_seq(["2", "^", "1", "0", "="]), "1024", "2 ^ 10 = 1024")
-- constants
assert(approx(float(calc_seq(["pi"])), 3.14159), "π key sets pi")
-- memory: M+ accumulates, MR recalls, M- subtracts, MC clears
let cmem = new_calc()
calc_press(cmem, "5"); calc_press(cmem, "m+")
calc_press(cmem, "3"); calc_press(cmem, "m+")
calc_press(cmem, "mr")
assert_eq(cmem["display"], "8", "M+ accumulates and MR recalls (5+3=8)")
calc_press(cmem, "2"); calc_press(cmem, "m-")
calc_press(cmem, "mr")
assert_eq(cmem["display"], "6", "M- subtracts from memory (8-2=6)")
calc_press(cmem, "mc")
assert_eq(cmem["mem"], 0.0, "MC clears memory")
-- scientific hit-testing (state selects the 6-wide layout) + the mode pill
let csci = new_calc(); csci["sci"] = true
assert(calc_key_at(0, 0, 320, 420, 30, 130, csci) != null, "calc_key_at finds a key in the scientific layout")
assert_eq(calc_key_at(0, 0, 320, 420, 24, 20, csci), "mode", "top-left of the display hits the mode pill")
-- scientific keypad paints without error onto a real buffer
let fsci_fb = framebuffer(320, 420)
paint_calc(fsci_fb, 0, 0, 320, 420, t, csci)
assert(painted(fsci_fb, 0xFF000000), "scientific calc paints display + expanded keypad")

-- ── Files navigation ──
show "-- Kyan apps: files navigation --"
fn names_of(entries) {
    mut out = []
    for e in entries { push(out, e["name"]) }
    return out
}
let fst = new_files()
assert_eq(len(fst["path"]), 0, "files start at the Home root")
let root = files_entries(fst)
-- folders sort ahead of files
assert_eq(root[0]["dir"], true, "first entry is a folder")
assert(contains(names_of(root), "Projects"), "root shows Projects")
assert(contains(names_of(root), "notes.txt"), "root shows a file")
-- a folder's meta is its item count
assert_eq(root[0]["dir"] and root[0]["name"] == "Projects", true, "Projects is the first folder")
-- descend into Projects → clarity → stdlib
files_nav(fst, "Projects")
assert_eq(len(fst["path"]), 1, "navigating into Projects deepens the path")
assert(contains(names_of(files_entries(fst)), "clarity"), "Projects contains clarity")
files_nav(fst, "clarity")
files_nav(fst, "stdlib")
assert_eq(len(fst["path"]), 3, "three levels deep")
assert(contains(names_of(files_entries(fst)), "kyan_apps.clarity"), "stdlib lists its files")
-- navigating into a file is a no-op
files_nav(fst, "kyan_apps.clarity")
assert_eq(len(fst["path"]), 3, "clicking a file does not change the directory")
-- back pops one level
files_up(fst)
assert_eq(len(fst["path"]), 2, "up pops one level")
assert(contains(names_of(files_entries(fst)), "stdlib"), "back returns to clarity")
-- breadcrumb jump goes straight to the root
files_goto(fst, 0)
assert_eq(len(fst["path"]), 0, "breadcrumb crumb 0 jumps to Home")

-- click-driven navigation via the shared layout / hit-test
let fc2 = new_files()
let lay = files_hit(fc2, 0, 0, 400, 300, -50, -50)
assert_eq(lay, null, "a click in dead space hits nothing")
-- click the first row (a folder) and confirm it descends
let l0 = _files_layout(fc2, 0, 0, 400, 300)
let row0 = l0["rows"][0]
let moved = files_click(fc2, 0, 0, 400, 300, row0["x"] + 20, row0["y"] + 8)
assert(moved, "clicking a folder row navigates")
assert_eq(len(fc2["path"]), 1, "click descended one level")
-- click the Home crumb to go back
let l1 = _files_layout(fc2, 0, 0, 400, 300)
let home_crumb = l1["crumbs"][0]
files_click(fc2, 0, 0, 400, 300, home_crumb["x"] + 4, home_crumb["y"] + 4)
assert_eq(len(fc2["path"]), 0, "clicking the Home crumb returns to root")

-- ── Files: tree-view sidebar ──
show "-- Kyan apps: files tree sidebar --"
fn tree_row(lay, name) {
    for tr in lay["tree"] { if tr["name"] == name { return tr } }
    return null
}
let ftree = new_files()
assert(has(ftree["expanded"], "/"), "the Home root starts expanded")
let tl = _files_layout(ftree, 0, 0, 480, 320)
assert(has(tl, "tree"), "layout exposes a sidebar tree")
mut tnames = []
for tr in tl["tree"] { push(tnames, tr["name"]) }
assert(contains(tnames, "Home"), "tree shows the Home root")
assert(contains(tnames, "Projects"), "tree shows the top-level Projects folder")
assert(contains(tnames, "Music"), "tree shows the top-level Music folder")
assert(not contains(tnames, "clarity"), "a collapsed folder hides its subfolders")
-- click Projects' disclosure triangle to expand it
let prow = tree_row(tl, "Projects")
assert(prow != null, "Projects appears in the tree")
assert(files_click(ftree, 0, 0, 480, 320, prow["tri_x"] + 2, prow["y"] + 6), "clicking the triangle toggles expansion")
let tl2 = _files_layout(ftree, 0, 0, 480, 320)
mut tnames2 = []
for tr in tl2["tree"] { push(tnames2, tr["name"]) }
assert(contains(tnames2, "clarity"), "expanding Projects reveals its subfolders")
-- click the 'clarity' row's name (past the triangle) to navigate into it
let crow = tree_row(tl2, "clarity")
files_click(ftree, 0, 0, 480, 320, crow["x"] + crow["w"] - 20, crow["y"] + 6)
assert_eq(len(ftree["path"]), 2, "clicking a tree folder navigates to its path")
assert(contains(names_of(files_entries(ftree)), "stdlib"), "the main pane now lists clarity's contents")
-- the current folder reads as selected in the tree
let tl3 = _files_layout(ftree, 0, 0, 480, 320)
assert(tree_row(tl3, "clarity")["selected"], "the current folder is highlighted in the tree")
-- a main-pane folder click also reveals + selects in the sidebar
let ftree2 = new_files()
let l0b = _files_layout(ftree2, 0, 0, 480, 320)
let prow0 = l0b["rows"][0]
files_click(ftree2, 0, 0, 480, 320, prow0["x"] + 20, prow0["y"] + 8)
assert(len(ftree2["path"]) == 1, "clicking a folder in the main pane descends into it")
-- paint the whole Files app (sidebar + main pane) onto a real buffer
let ftfb = framebuffer(480, 320)
paint_files(ftfb, 0, 0, 480, 320, t, ftree)
assert(painted(ftfb, 0xFF000000), "files app paints the sidebar tree + main pane")

-- ── Files: details / preview pane ──
show "-- Kyan apps: files details pane --"
fn first_file_row(lay) { for r in lay["rows"] { if not r["dir"] { return r } } return null }
fn first_folder_row(lay) { for r in lay["rows"] { if r["dir"] { return r } } return null }
let fd = new_files()
assert(fd["selected"] == null, "no file selected initially")
-- the details pane only appears when the window is wide enough
let wide = _files_layout(fd, 0, 0, 600, 360)
assert(wide["details_w"] > 0, "a wide Files window shows the details pane")
assert_eq(_files_layout(fd, 0, 0, 400, 300)["details_w"], 0, "a narrow window hides the details pane")
-- clicking a file row selects it
let frow = first_file_row(wide)
assert(frow != null, "root has a file row")
files_click(fd, 0, 0, 600, 360, frow["x"] + 20, frow["y"] + 8)
assert_eq(fd["selected"], frow["name"], "clicking a file selects it for the details pane")
-- navigating into a folder clears the selection
let dfrow = first_folder_row(_files_layout(fd, 0, 0, 600, 360))
files_click(fd, 0, 0, 600, 360, dfrow["x"] + 20, dfrow["y"] + 8)
assert(fd["selected"] == null, "descending into a folder clears the selection")
assert_eq(len(fd["path"]), 1, "and navigates into it")
-- file-kind classification from extensions
assert_eq(_file_kind("game.clarity", false), "Clarity source", "kind of a .clarity file")
assert_eq(_file_kind("notes.txt", false), "Text", "kind of a .txt file")
assert_eq(_file_kind("shot.png", false), "PNG image", "kind of a .png file")
assert_eq(_file_kind("Projects", true), "Folder", "kind of a folder")
-- paint the wide Files with a file selected (exercises the details pane)
let fd2 = new_files()
let w2 = _files_layout(fd2, 0, 0, 600, 360)
let fr2 = first_file_row(w2)
files_click(fd2, 0, 0, 600, 360, fr2["x"] + 20, fr2["y"] + 8)
let dfb = framebuffer(600, 360)
dfb.clear(0xFF000000)
paint_files(dfb, 0, 0, 600, 360, t, fd2)
assert(painted(dfb, 0xFF000000), "files paints the details pane with a selection")

-- ── Summary ──
show ""
show "Kyan apps: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " kyan apps test(s) failed" }
