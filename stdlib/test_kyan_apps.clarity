-- KyanOS app content painter tests — rebrand phase K4.

from "kyan_apps.clarity" import paint_prism, paint_terminal_content, paint_files_content, paint_monitor_content, paint_settings_content, paint_calc_content, app_painters, new_calc, calc_press, calc_key_at, new_files, files_entries, files_nav, files_up, files_goto, files_click, files_hit, _files_layout
from "theme_kyan.clarity" import kyan_obsidian
from "graphics.clarity" import framebuffer

mut PASSED = 0
mut FAILED = 0

fn assert(val, msg) {
    if val { PASSED += 1 } else { FAILED += 1; show "  FAIL: " + msg }
}
fn assert_eq(actual, expected, msg) {
    if actual == expected { PASSED += 1 }
    else { FAILED += 1; show "  FAIL: {msg} (expected {expected}, got {actual})" }
}

fn painted(fb, bg) {
    mut y = 0
    while y < fb.height {
        mut x = 0
        while x < fb.width {
            if fb.get_pixel(x, y) != bg { return true }
            x = x + 4
        }
        y = y + 4
    }
    return false
}

let t = kyan_obsidian()

-- ── registry ──
show "-- Kyan apps: registry --"
let reg = app_painters()
assert(has(reg, "prism"), "prism painter registered")
assert(has(reg, "terminal"), "terminal painter registered")
assert(has(reg, "files"), "files painter registered")

-- ── Prism ──
show "-- Kyan apps: prism --"
let fp = framebuffer(680, 420)
fp.clear(0xFF000000)
paint_prism(fp, 0, 0, 680, 420, t, true)
assert(painted(fp, 0xFF000000), "prism paints content")
-- sidebar band on the left uses the elevated surface
assert_eq(fp.get_pixel(40, 200), t["surface_elevated"], "prism sidebar painted")
-- the featured card region (right of the sidebar) is not empty
assert(fp.get_pixel(400, 60) != 0xFF000000, "prism featured card painted")
-- a tiny content area is a no-op, not a crash
let tiny = framebuffer(60, 60)
tiny.clear(0xFF000000)
paint_prism(tiny, 0, 0, 60, 60, t, true)
assert(true, "prism tolerates a tiny content rect")

-- ── Terminal ──
show "-- Kyan apps: terminal --"
let ft = framebuffer(360, 200)
ft.clear(0xFF112233)
paint_terminal_content(ft, 0, 0, 360, 200, t, true)
-- terminal fills its own void-black background
assert_eq(ft.get_pixel(2, 2), 0xFF05060A, "terminal fills void background")
assert(painted(ft, 0xFF05060A), "terminal draws prompt text over the void")

-- ── Files ──
show "-- Kyan apps: files --"
let ff = framebuffer(380, 240)
ff.clear(0xFF000000)
paint_files_content(ff, 0, 0, 380, 240, t, true)
-- the top band is the breadcrumb header (elevated), the body is the surface
assert_eq(ff.get_pixel(2, 2), t["surface_elevated"], "files draws the breadcrumb header")
assert_eq(ff.get_pixel(2, 120), t["surface"], "files fills the surface below the header")
assert(painted(ff, 0xFF000000), "files draws rows")

-- ── System Monitor ──
show "-- Kyan apps: monitor --"
assert(has(reg, "monitor"), "monitor painter registered")
let fm = framebuffer(500, 420)
fm.clear(0xFF000000)
paint_monitor_content(fm, 0, 0, 500, 420, t, true)
assert_eq(fm.get_pixel(2, 2), t["surface"], "monitor fills the surface")
assert(painted(fm, 0xFF000000), "monitor draws cards / bars / processes")

-- ── Settings ──
show "-- Kyan apps: settings --"
assert(has(reg, "settings"), "settings painter registered")
let fs = framebuffer(560, 380)
fs.clear(0xFF000000)
paint_settings_content(fs, 0, 0, 560, 380, t, true)
assert_eq(fs.get_pixel(2, 2), t["surface_elevated"], "settings fills the sidebar")
assert(painted(fs, 0xFF000000), "settings draws swatches / toggles")

-- ── Calculator ──
show "-- Kyan apps: calc --"
assert(has(reg, "calc"), "calc painter registered")
let fc = framebuffer(300, 400)
fc.clear(0xFF000000)
paint_calc_content(fc, 0, 0, 300, 400, t, true)
assert(painted(fc, 0xFF000000), "calc draws display + keypad")
-- a small window must not crash the painters (clip guards)
paint_monitor_content(fc, 0, 0, 30, 20, t, true)
paint_settings_content(fc, 0, 0, 30, 20, t, true)
paint_calc_content(fc, 0, 0, 30, 20, t, true)
assert(true, "painters survive a tiny content rect")

-- ── Calculator logic ──
show "-- Kyan apps: calculator --"
fn calc_seq(keys) {
    let s = new_calc()
    for k in keys { calc_press(s, k) }
    return s["display"]
}
assert_eq(calc_seq(["8", "*", "8", "="]), "64", "8 * 8 = 64")
assert_eq(calc_seq(["1", "2", "+", "3", "0", "="]), "42", "12 + 30 = 42")
assert_eq(calc_seq(["1", "0", "0", "/", "4", "="]), "25", "100 / 4 = 25")
assert_eq(calc_seq(["7", "-", "9", "="]), "-2", "7 - 9 = -2")
assert_eq(calc_seq(["2", "+", "3", "*", "4", "="]), "20", "chained ops evaluate left-to-right")
assert_eq(calc_seq(["1", ".", "5", "+", "2", ".", "5", "="]), "4", "decimals: 1.5 + 2.5 = 4")
assert_eq(calc_seq(["9", "9", "C"]), "0", "C clears to 0")
assert_eq(calc_seq(["5", "+/-"]), "-5", "+/- negates")
assert_eq(calc_seq(["5", "0", "%"]), "0.5", "% divides by 100")
-- divide by zero is safe (no crash)
assert_eq(calc_seq(["5", "/", "0", "="]), "0", "divide by zero returns 0, no crash")
-- hit-test finds keys inside the keypad and nothing outside it
let hk = calc_key_at(0, 0, 300, 400, 40, 120)
assert(hk != null, "calc_key_at finds a key inside the pad")
assert_eq(calc_key_at(0, 0, 300, 400, -5, -5), null, "calc_key_at misses outside the pad")

-- ── Files navigation ──
show "-- Kyan apps: files navigation --"
fn names_of(entries) {
    mut out = []
    for e in entries { push(out, e["name"]) }
    return out
}
let fst = new_files()
assert_eq(len(fst["path"]), 0, "files start at the Home root")
let root = files_entries(fst)
-- folders sort ahead of files
assert_eq(root[0]["dir"], true, "first entry is a folder")
assert(contains(names_of(root), "Projects"), "root shows Projects")
assert(contains(names_of(root), "notes.txt"), "root shows a file")
-- a folder's meta is its item count
assert_eq(root[0]["dir"] and root[0]["name"] == "Projects", true, "Projects is the first folder")
-- descend into Projects → clarity → stdlib
files_nav(fst, "Projects")
assert_eq(len(fst["path"]), 1, "navigating into Projects deepens the path")
assert(contains(names_of(files_entries(fst)), "clarity"), "Projects contains clarity")
files_nav(fst, "clarity")
files_nav(fst, "stdlib")
assert_eq(len(fst["path"]), 3, "three levels deep")
assert(contains(names_of(files_entries(fst)), "kyan_apps.clarity"), "stdlib lists its files")
-- navigating into a file is a no-op
files_nav(fst, "kyan_apps.clarity")
assert_eq(len(fst["path"]), 3, "clicking a file does not change the directory")
-- back pops one level
files_up(fst)
assert_eq(len(fst["path"]), 2, "up pops one level")
assert(contains(names_of(files_entries(fst)), "stdlib"), "back returns to clarity")
-- breadcrumb jump goes straight to the root
files_goto(fst, 0)
assert_eq(len(fst["path"]), 0, "breadcrumb crumb 0 jumps to Home")

-- click-driven navigation via the shared layout / hit-test
let fc2 = new_files()
let lay = files_hit(fc2, 0, 0, 400, 300, -50, -50)
assert_eq(lay, null, "a click in dead space hits nothing")
-- click the first row (a folder) and confirm it descends
let l0 = _files_layout(fc2, 0, 0, 400, 300)
let row0 = l0["rows"][0]
let moved = files_click(fc2, 0, 0, 400, 300, row0["x"] + 20, row0["y"] + 8)
assert(moved, "clicking a folder row navigates")
assert_eq(len(fc2["path"]), 1, "click descended one level")
-- click the Home crumb to go back
let l1 = _files_layout(fc2, 0, 0, 400, 300)
let home_crumb = l1["crumbs"][0]
files_click(fc2, 0, 0, 400, 300, home_crumb["x"] + 4, home_crumb["y"] + 4)
assert_eq(len(fc2["path"]), 0, "clicking the Home crumb returns to root")

-- ── Summary ──
show ""
show "Kyan apps: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " kyan apps test(s) failed" }
