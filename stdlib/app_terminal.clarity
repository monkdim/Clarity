-- Terminal app — Phase 63 task 1.
--
-- A character-grid terminal emulator that consumes a stream of bytes
-- from a child process and turns them into cells with attributes.
-- Supports the practical subset of VT100 / xterm escapes:
--   * Control chars: \b backspace, \r CR, \n LF, \t tab (8-col stops)
--   * CSI cursor moves: A B C D H, up/down/right/left/abs-pos
--   * CSI line / screen erase: K, J
--   * CSI SGR (Select Graphic Rendition): bold, fg/bg colors 30-37 +
--     90-97, default reset, 256-color via 38;5;N / 48;5;N, truecolor
--     via 38;2;R;G;B / 48;2;R;G;B
--   * Scrollback buffer with `scroll_back(n)` / `scroll_forward(n)`.
--
-- The PTY plumbing (forkpty / openpty) is not wrapped here — that's
-- libutil/forkpty FFI which is its own scope. For the desktop app the
-- caller pipes a child's stdout into `feed(bytes)`. The terminal works
-- standalone for tests via the same feed() entry point.

from "ui.clarity" import Widget
from "draw.clarity" import fill_rect, rect, line
from "font.clarity" import draw_text, measure_text
from "theme.clarity" import theme_color, theme_font
from "terminal_emulator.clarity" import Terminal

-- Blank-cell background (mirrors terminal_emulator's default).
let _DEFAULT_BG = 0xFF1A1A1A

-- ── Widget ────────────────────────────────────────────

class TerminalApp < Widget {
    fn init(cols, rows) {
        this._setup_widget()
        this.role = "terminal"
        this.focusable = true
        this.cols = cols ?? 80
        this.rows = rows ?? 24
        this.terminal = Terminal(this.cols, this.rows)
        this.cell_w = 8
        this.cell_h = 16
    }

    fn feed(text) { this.terminal.feed(text) }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let f = theme_font(t)
        let cw = this.cell_w
        let ch = this.cell_h
        fill_rect(fb, r[0], r[1], r[2], r[3], _DEFAULT_BG)
        mut row = 0
        while row < this.terminal.rows {
            mut col = 0
            while col < this.terminal.cols {
                let cell = this.terminal.cell_at(row, col)
                let x = r[0] + col * cw
                let y = r[1] + row * ch
                if cell.bg != _DEFAULT_BG {
                    fill_rect(fb, x, y, cw, ch, cell.bg)
                }
                if cell.ch != " " {
                    draw_text(fb, x, y + (ch - f.height) / 2, cell.ch, f, cell.fg)
                }
                col += 1
            }
            row += 1
        }
        -- Caret: only when focused and we're following the live grid
        if this.focused and this.terminal._scroll_offset == 0 {
            let cx = r[0] + this.terminal.cursor_col * cw
            let cy = r[1] + this.terminal.cursor_row * ch
            fill_rect(fb, cx, cy + ch - 2, cw, 2, theme_color(t, "accent"))
        }
    }

    fn _handle(event) {
        let kind = type(event)
        if kind == "MouseEvent" and event.is_press {
            this.focus()
            return true
        }
        if kind == "MouseEvent" and event.is_scroll {
            if event.scroll_y > 0 { this.terminal.scroll_back(3) } else { this.terminal.scroll_forward(3) }
            return true
        }
        return false
    }
}

fn terminal(cols, rows) { return TerminalApp(cols, rows) }
