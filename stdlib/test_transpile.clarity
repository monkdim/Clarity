-- Test: the self-hosted Clarity → JavaScript transpiler.
-- These guard the string-interpolation edge cases where the emitted JS
-- template literals are easy to get subtly wrong.

from "transpile.clarity" import transpile_source

mut passed = 0
mut failed = 0
mut total = 0

fn assert_contains(name, source, needle) {
    total += 1
    let js = transpile_source(source, "<test>")
    if contains(js, needle) {
        show "  [pass] {name}"
        passed += 1
    } else {
        show "  [FAIL] {name} — emitted JS did not contain {needle}"
        show "         got: {js}"
        failed += 1
    }
}

fn assert_absent(name, source, needle) {
    total += 1
    let js = transpile_source(source, "<test>")
    if contains(js, needle) {
        show "  [FAIL] {name} — emitted JS unexpectedly contained {needle}"
        show "         got: {js}"
        failed += 1
    } else {
        show "  [pass] {name}"
        passed += 1
    }
}

show "── Transpiler: string interpolation ──"

-- Plain interpolation becomes a JS template placeholder.
assert_contains("simple interpolation", "let name = \"x\"\nshow \"Hi {name}\"", "${name}")

-- Literal braces produced by concatenation must survive verbatim. This is
-- the shape the interpreter's map display uses: `\{` + value + `\}`. The
-- transpiler must NOT collapse the two adjacent braces into `{{`.
assert_absent("map-style braces are not doubled",
    "let pairs = \"a: 1\"\nshow \"\\{\" + pairs + \"\\}\"",
    "{{")

-- An interpolation wedged directly between escaped braces (`\{{x}\}`) is the
-- anti-pattern that used to render as a literal `{{x}}` because the greedy
-- brace matcher swallowed both. We no longer write it that way, but guard the
-- concatenation form the map display replaced it with.
assert_contains("brace-wrapped value concatenates",
    "let pairs = \"a: 1\"\nshow \"\\{\" + pairs + \"\\}\"",
    "pairs")

-- Embedded JS object braces (a `{` followed by a non-identifier char) stay
-- literal — the transpiler must not treat them as interpolation.
assert_absent("brace before space stays literal",
    "show \"a { 1 } b\"",
    "${")

-- Control characters in a non-interpolated string. A raw newline or carriage
-- return terminates a JS string literal, so emitting one verbatim produces
-- unparseable JS. This is not hypothetical: stdlib/cli.clarity contains
-- split(..., "\n"), and emitting it raw is what stopped the self-hosted
-- transpiler from being able to rebuild the compiler from its own sources.
assert_contains("newline is escaped, not emitted raw",
    "let s = \"a\\nb\"",
    "\"a\\nb\"")
assert_absent("no raw newline inside a JS string literal",
    "let s = \"a\\nb\"",
    "\"a\nb\"")
assert_contains("carriage return is escaped",
    "let s = \"a\\rb\"",
    "\"a\\rb\"")
assert_contains("tab is escaped",
    "let s = \"a\\tb\"",
    "\"a\\tb\"")
assert_contains("backslash is not double-escaped by the control-char pass",
    "let s = \"a\\\\nb\"",
    "\"a\\\\nb\"")

show ""
show "═══════════════════════════════════════"
show "Results: {passed}/{total} passed, {failed} failed"
-- ── A node the emitter has no case for ────────────────────
--
-- The fallback used to write `/* TODO: <node> */` into the output: a
-- statement the emitter did not know silently vanished from the generated
-- JavaScript, leaving a comment as the only trace. Nothing in the standard
-- library hits it (measured over all 158 modules), so it is a hole that
-- only ever appears when a new syntax node lands, which is exactly when a
-- silent drop is most expensive.
from "transpile.clarity" import JSEmitter

total += 1
mut stmt_msg = "no throw"
try {
    let e = JSEmitter("<test>", null)
    e.emit_stmt({"node_type": "MadeUpStatement", "line": 7})
} catch err { stmt_msg = str(err) }
if contains(stmt_msg, "MadeUpStatement") and contains(stmt_msg, "line 7") {
    show "  [pass] an unknown statement node throws and names itself"
    passed += 1
} else {
    show "  [FAIL] unknown statement node: {stmt_msg}"
    failed += 1
}

total += 1
mut expr_msg = "no throw"
try {
    let e2 = JSEmitter("<test>", null)
    e2.emit_expr({"node_type": "MadeUpExpression", "line": 9})
} catch err2 { expr_msg = str(err2) }
if contains(expr_msg, "MadeUpExpression") and contains(expr_msg, "line 9") {
    show "  [pass] an unknown expression node throws and names itself"
    passed += 1
} else {
    show "  [FAIL] unknown expression node: {expr_msg}"
    failed += 1
}

-- And a comment is never what comes out instead.
assert_absent("no TODO comment for a real program", "let x = 1\nshow x", "TODO")

if failed == 0 {
    show "All transpiler tests passed!"
} else {
    show "{failed} test(s) FAILED"
}
-- Fail loudly: without this the runner sees a clean exit and the suite goes
-- green with failing transpiler tests.
if failed > 0 { throw str(failed) + " transpiler test(s) failed" }
