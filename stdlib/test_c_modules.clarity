-- Native import resolution: flattening a program plus its imports into the
-- single C translation unit `clarity cc` emits.
--
-- The interesting cases are the ones where flattening is not just "paste the
-- file in": a module imported twice, a cycle, a name defined in two modules,
-- and a module that is not there at all. Each is asserted here, and the
-- happy path is checked end to end — compile a program that imports a real
-- stdlib module and diff the binary's output against the interpreter.

from "lexer.clarity" import tokenize
from "parser.clarity" import parse
from "c_modules.clarity" import resolve_native_imports
from "c_codegen.clarity" import compile_to_c

mut PASSED = 0
mut FAILED = 0

fn check(name, cond) {
    if cond { PASSED += 1 }
    else { FAILED += 1; show "  FAIL: " + name }
}

fn check_eq(name, actual, expected) {
    if actual == expected { PASSED += 1 }
    else {
        FAILED += 1
        show "  FAIL: " + name
        show "    expected: " + str(expected)
        show "    actual:   " + str(actual)
    }
}

let DIR = "/tmp/_clmod"
exec("rm -rf " + DIR + " && mkdir -p " + DIR)

fn put(name, body) { write(DIR + "/" + name, body) }

fn flatten(name) {
    let path = DIR + "/" + name
    let src = read(path)
    return resolve_native_imports(parse(tokenize(src, name), src), DIR, null, path)
}

fn names_of(tree) {
    mut out = []
    for s in tree.body {
        if s.node_type == "FnStatement" or s.node_type == "ClassStatement" or s.node_type == "LetStatement" {
            push(out, s.name)
        }
    }
    return out
}

fn _find_cc() {
    for cc in ["cc", "gcc", "clang"] {
        let r = exec_full(cc + " --version")
        if len(trim(r.stdout)) > 0 { return cc }
    }
    return null
}
let CC = _find_cc()

-- Compile a scratch program natively and return its trimmed output. Used by
-- the scoping checks below, where what matters is not the shape of the
-- flattened AST but that the binary computes the right thing.
fn run_native(name) {
    let path = DIR + "/" + name
    let src = read(path)
    let tree = resolve_native_imports(parse(tokenize(src, name), src), DIR, null, path)
    write(DIR + "/_run.c", compile_to_c(tree))
    exec_full(CC + " -O2 -w " + DIR + "/_run.c -o " + DIR + "/_run -lm")
    return trim(exec_full(DIR + "/_run").stdout)
}

show "-- native imports: flattening --"

-- A dependency's declarations must land before the importer's, so that the
-- emitted C has them in scope by the time anything refers to them.
put("dep.clarity", "fn dep_fn() { return 1 }\n")
put("uses_dep.clarity", "from \"dep.clarity\" import dep_fn\nfn main_fn() { return dep_fn() }\n")
let flat = flatten("uses_dep.clarity")
check_eq("dependency spliced before importer", names_of(flat), ["dep_fn", "main_fn"])
check("import statement is dropped", not contains(str(names_of(flat)), "ImportStatement"))

-- Imported twice through two different paths: included once, not twice.
put("mid_a.clarity", "from \"dep.clarity\" import dep_fn\nfn a_fn() { return dep_fn() }\n")
put("mid_b.clarity", "from \"dep.clarity\" import dep_fn\nfn b_fn() { return dep_fn() }\n")
put("diamond.clarity", "from \"mid_a.clarity\" import a_fn\nfrom \"mid_b.clarity\" import b_fn\nfn top() { return a_fn() + b_fn() }\n")
check_eq("diamond import includes the shared module once",
    names_of(flatten("diamond.clarity")), ["dep_fn", "a_fn", "b_fn", "top"])

-- A cycle must terminate rather than recurse until the stack gives out.
put("cyc_a.clarity", "from \"cyc_b.clarity\" import b_thing\nfn a_thing() { return b_thing() }\n")
put("cyc_b.clarity", "from \"cyc_a.clarity\" import a_thing\nfn b_thing() { return 2 }\n")
mut cyc_ok = false
try {
    let f = flatten("cyc_a.clarity")
    cyc_ok = contains(str(names_of(f)), "b_thing") and contains(str(names_of(f)), "a_thing")
} catch e { cyc_ok = false }
check("import cycle terminates", cyc_ok)

-- Two modules defining the same top-level name each get their own, so the
-- one C translation unit has one symbol per declaration. This used to be a
-- hard error, which made a native build impossible for any program importing
-- more than a handful of stdlib modules.
put("dup1.clarity", "fn helper() { return 1 }\n")
put("dup2.clarity", "fn helper() { return 2 }\nfn other() { return helper() }\n")
put("collide.clarity", "from \"dup1.clarity\" import helper\nfrom \"dup2.clarity\" import other\nshow helper()\nshow other()\n")
let collided = names_of(flatten("collide.clarity"))
check("colliding names are made module-scoped",
    contains(collided, "dup1__helper") and contains(collided, "dup2__helper"))
check("and the plain name is gone", not contains(collided, "helper"))
if CC != null {
    -- Each module's own `helper` is the one its code calls.
    check_eq("each module keeps its own", run_native("collide.clarity"), "1\n2")
}

-- A name declared in only one module keeps it, so the generated C stays
-- readable and a program that never had a collision compiles to what it
-- always did.
put("uniq1.clarity", "fn only_here() { return 7 }\n")
put("uniq2.clarity", "from \"uniq1.clarity\" import only_here\nshow only_here()\n")
check("a name nothing else declares is left alone",
    contains(names_of(flatten("uniq2.clarity")), "only_here"))

if CC != null {
    -- The importer's reference follows the rename to the module it named,
    -- not to whichever declaration happened to be spliced last. Both modules
    -- declare `pick`; the program imports one of them and must get that one.
    put("pick1.clarity", "fn pick() { return 11 }\nfn from_one() { return pick() }\n")
    put("pick2.clarity", "fn pick() { return 22 }\n")
    put("picker.clarity",
        "from \"pick2.clarity\" import pick\n" +
        "from \"pick1.clarity\" import from_one\n" +
        "show pick()\n" +
        "show from_one()\n")
    check_eq("an import resolves to the module it names", run_native("picker.clarity"), "22\n11")

    -- A local binding shadows the module's declaration and must not be
    -- renamed with it. Without that rule the parameter below would be
    -- rewritten into a reference to the module-scoped function.
    put("shadow_dep.clarity", "fn shadowed() { return 1 }\n")
    put("shadow.clarity",
        "from \"shadow_dep.clarity\" import shadowed\n" +
        "fn use_it(shadowed) { return shadowed + 1 }\n" +
        "fn ours() { return shadowed() }\n" +
        "show use_it(40)\n" +
        "show ours()\n")
    check_eq("a parameter shadows a colliding module name", run_native("shadow.clarity"), "41\n1")

    -- A class whose base class is renamed has to follow it, or it inherits
    -- from something that no longer exists.
    put("base1.clarity", "class Shape {\n    fn kind() { return \"one\" }\n}\n")
    put("base2.clarity",
        "from \"base1.clarity\" import Shape\n" +
        "class Square impl Shape {\n    fn kind() { return \"square of \" + Shape().kind() }\n}\n")
    put("inherit.clarity",
        "from \"base2.clarity\" import Square\n" +
        "class Shape {\n    fn kind() { return \"local\" }\n}\n" +
        "show Square().kind()\n" +
        "show Shape().kind()\n")
    check_eq("a renamed class is followed by its subclass and its callers",
        run_native("inherit.clarity"), "square of one\nlocal")
}

-- A missing module names itself and its importer rather than failing later
-- with an undefined C symbol.
put("missing.clarity", "from \"nope.clarity\" import thing\nshow thing()\n")
mut missing_msg = ""
try { flatten("missing.clarity") } catch e { missing_msg = str(e) }
check("missing module is reported by name", contains(missing_msg, "nope.clarity"))

-- `import math` has no path: it is a runtime builtin, not a file, and must
-- not be treated as a missing module.
put("builtin.clarity", "import math\nfn f() { return 1 }\n")
mut builtin_ok = false
try { builtin_ok = names_of(flatten("builtin.clarity")) == ["f"] } catch e { builtin_ok = false }
check("pathless `import math` is left alone", builtin_ok)

-- Module-level constants come across too, and stay ahead of their users.
put("consts.clarity", "let SCALE = 7\nfn scaled(n) { return n * SCALE }\n")
put("use_consts.clarity", "from \"consts.clarity\" import scaled\nshow scaled(6)\n")
check_eq("module constants are spliced", names_of(flatten("use_consts.clarity")), ["SCALE", "scaled"])

show "-- native imports: end to end --"


if CC == null {
    show "  (no C compiler on PATH — native import check skipped)"
} else {
    -- sha256.clarity itself imports bits.clarity, so this exercises a
    -- transitive import of a real module, not a toy one.
    --
    -- The expected output is the published FIPS 180-4 digest rather than an
    -- interpreter run: the interpreter resolves imports against its own
    -- stdlib search path, not this scratch directory, so running the same
    -- source through it here would fail to find the module. The interpreter
    -- side of these digests is covered by test_sha256.clarity.
    let prog = "from \"sha256.clarity\" import sha256_hex\nshow sha256_hex(\"\")\nshow sha256_hex(\"abc\")\n"
    write(DIR + "/real.clarity", prog)
    let expected = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n" +
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

    -- Where sha256.clarity lives, depending on where the runner was started.
    mut stdlib_dir = null
    for cand in ["stdlib", ".", "../stdlib"] {
        if stdlib_dir == null and exists(cand + "/sha256.clarity") { stdlib_dir = cand }
    }
    if stdlib_dir == null {
        show "  (sha256.clarity not found from here — native import check skipped)"
    } else {
        let tree = resolve_native_imports(parse(tokenize(prog, "<t>"), prog), DIR, stdlib_dir, DIR + "/real.clarity")
        write(DIR + "/real.c", compile_to_c(tree))
        exec_full(CC + " -O2 -w " + DIR + "/real.c -o " + DIR + "/real -lm")
        check_eq("compiled program importing sha256.clarity produces the published digests",
            trim(exec_full(DIR + "/real").stdout), trim(expected))

        -- A second real module, to catch anything specific to how sha256 is
        -- shaped. bytes.clarity is the Track B byte toolkit; the example
        -- scanner used to inline it because imports did not compile.
        let bprog = "from \"bytes.clarity\" import scan, scan_all\n" +
            "let hay = [0x48, 0x8B, 0x05, 0x11, 0x22, 0xE8, 0x00]\n" +
            "show scan(hay, \"48 8B ?? ?? ?? E8\")\nshow scan_all(hay, \"48 8B\")\n"
        write(DIR + "/b.clarity", bprog)
        let btree = resolve_native_imports(parse(tokenize(bprog, "<t>"), bprog), DIR, stdlib_dir, DIR + "/b.clarity")
        write(DIR + "/b.c", compile_to_c(btree))
        exec_full(CC + " -O2 -w " + DIR + "/b.c -o " + DIR + "/b -lm")
        check_eq("compiled program importing bytes.clarity scans correctly",
            trim(exec_full(DIR + "/b").stdout), "0\n[0]")

        -- Two *real* stdlib modules that collide. bits.clarity and
        -- bytes.clarity both declare to_hex, with different arities and
        -- different meanings — before module scoping this pair could not be
        -- imported into one program at all, and it is the case the whole
        -- pass exists for.
        let cprog = "from \"bits.clarity\" import to_hex\n" +
            "from \"bytes.clarity\" import scan\n" +
            "show to_hex(48879, 4)\n" +
            "show scan([0x48, 0x8B, 0x05], \"48 8B\")\n"
        write(DIR + "/coll.clarity", cprog)
        let ctree = resolve_native_imports(parse(tokenize(cprog, "<t>"), cprog), DIR, stdlib_dir, DIR + "/coll.clarity")
        let ccsrc = compile_to_c(ctree)
        write(DIR + "/coll.c", ccsrc)
        check("each colliding stdlib module gets its own to_hex",
            contains(ccsrc, "f_bits__to_hex") and contains(ccsrc, "f_bytes__to_hex"))
        exec_full(CC + " -O2 -w " + DIR + "/coll.c -o " + DIR + "/coll -lm")
        check_eq("and the program calls the one it imported",
            trim(exec_full(DIR + "/coll").stdout), "beef\n0")

        -- http.clarity is the first stdlib module that only exists because
        -- native imports do: it is built on the tcp_* builtins, which the
        -- interpreter does not have, so it can only be reached by compiling.
        --
        -- Client and server in one process. The connect completes against the
        -- listen backlog, so the request can be written before anything
        -- accepts; only then does the server side run, and only then does the
        -- client read. Calling `request()` here instead would deadlock the
        -- process against its own listener, which is why the client half is
        -- split into send_request/read_response.
        let hprog = "from \"http.clarity\" import send_request, read_response, accept_request, send_response, close_connection, text\n" +
            "let srv = tcp_listen(0)\nlet port = tcp_port(srv)\n" +
            "let cli = tcp_connect(\"127.0.0.1\", port)\n" +
            "show send_request(cli, \"127.0.0.1\", \"POST\", \"/echo\", {\"X-Test\": \"yes\"}, \"ping\")\n" +
            "let conn = accept_request(srv)\nlet req = conn[\"request\"]\n" +
            "show req[\"method\"]\nshow req[\"path\"]\nshow req[\"headers\"][\"x-test\"]\nshow text(req[\"body\"])\n" +
            "send_response(conn[\"fd\"], 200, \"text/plain\", \"pong-\" + text(req[\"body\"]))\n" +
            "close_connection(conn[\"fd\"])\n" +
            "let resp = read_response(cli)\n" +
            "show resp[\"status\"]\nshow resp[\"reason\"]\nshow resp[\"headers\"][\"content-type\"]\nshow text(resp[\"body\"])\n" +
            "tcp_close(cli)\ntcp_close(srv)\n"
        write(DIR + "/h.clarity", hprog)
        let htree = resolve_native_imports(parse(tokenize(hprog, "<t>"), hprog), DIR, stdlib_dir, DIR + "/h.clarity")
        write(DIR + "/h.c", compile_to_c(htree))
        exec_full(CC + " -O2 -w " + DIR + "/h.c -o " + DIR + "/h -lm")
        check_eq("compiled HTTP client and server complete a round trip",
            trim(exec_full(DIR + "/h").stdout),
            "true\nPOST\n/echo\nyes\nping\n200\nOK\ntext/plain\npong-ping")
    }
}

exec("rm -rf " + DIR)

show ""
show "Native imports: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " native import test(s) failed" }
