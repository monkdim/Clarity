-- FFI Tests — exercise the Phase 56 binding layer.
-- Calls a few well-known libc functions to confirm dlopen, type
-- marshalling for the simple primitives, and the Library wrapper.

from "ffi.clarity" import bind, open, Library, Pointer, alloc, cstring, wrap_addr, read_cstring, struct, StructDef, StructInstance, StructArray, callback, Callback, array

mut PASSED = 0
mut FAILED = 0

fn assert(val, msg) {
    if val {
        PASSED += 1
    } else {
        FAILED += 1
        show "  FAIL: " + msg
    }
}

fn assert_eq(actual, expected, msg) {
    if actual == expected {
        PASSED += 1
    } else {
        FAILED += 1
        show "  FAIL: " + msg + " (expected " + str(expected) + ", got " + str(actual) + ")"
    }
}

-- ── bind: int return, no args ────────────────────────────

show "-- FFI: bind libc:getpid --"

let getpid = bind("libc", "getpid", [], "int")
let pid = getpid()
assert(type(pid) == "int", "getpid returns an int")
assert(pid > 0, "getpid is positive")
-- Same call twice should return the same pid (we're the same process)
assert_eq(getpid(), pid, "getpid is stable")

-- ── bind: int return with int arg ────────────────────────

show "-- FFI: bind libc:abs --"

let c_abs = bind("libc", "abs", ["int"], "int")
assert_eq(c_abs(-7), 7, "abs(-7)")
assert_eq(c_abs(0), 0, "abs(0)")
assert_eq(c_abs(42), 42, "abs(42)")

-- ── Library: open + call multiple symbols ───────────────

show "-- FFI: Library wrapper --"

let libc = open("libc", {
    getpid: {args: [], returns: "int"},
    getuid: {args: [], returns: "int"}
})

assert(libc != null, "Library opens")
assert(type(libc) == "Library", "open returns a Library instance")

let pid_via_lib = libc.call("getpid", [])
assert_eq(pid_via_lib, pid, "Library.call('getpid') matches bound getpid")

let uid = libc.call("getuid", [])
assert(type(uid) == "int", "getuid returns an int")
assert(uid >= 0, "getuid is non-negative")

-- get() returns a callable for repeat use without dict lookups
let getpid_fn = libc.get("getpid")
assert_eq(getpid_fn(), pid, "Library.get('getpid')() matches")

libc.close()

-- ── alloc + read/write primitives ───────────────────────

show "-- FFI: Pointer alloc + read/write --"

let buf = alloc(32)
assert(type(buf) == "Pointer", "alloc returns a Pointer")
assert_eq(buf.size(), 32, "alloc size matches")

buf.write_i32(0, 42)
buf.write_i32(4, -100)
assert_eq(buf.read_i32(0), 42, "i32 roundtrip positive")
assert_eq(buf.read_i32(4), -100, "i32 roundtrip negative")

buf.write_u8(8, 255)
buf.write_u8(9, 0)
assert_eq(buf.read_u8(8), 255, "u8 max roundtrip")
assert_eq(buf.read_u8(9), 0, "u8 zero roundtrip")

buf.write_f64(16, 3.14159)
let f = buf.read_f64(16)
assert(f > 3.14 and f < 3.142, "f64 roundtrip")

-- read_byte/read_int aliases
buf.write_byte(0, 7)
assert_eq(buf.read_byte(0), 7, "byte alias")

-- Writing through a Pointer we don't own should error
let foreign = wrap_addr(buf.addr())
mut threw = false
try {
    foreign.write_i32(0, 999)
} catch e {
    threw = true
}
assert(threw, "write through non-owned Pointer throws")

-- ── cstring round-trip via libc:strlen ──────────────────

show "-- FFI: cstring + strlen --"

let strlen = bind("libc", "strlen", ["string"], "u64")
assert_eq(strlen("hello"), 5, "strlen('hello')")
assert_eq(strlen(""), 0, "strlen('')")
assert_eq(strlen("a longer string"), 15, "strlen of longer")

-- ── Reading a cstring returned by C (getenv) ────────────

show "-- FFI: getenv + read_cstring --"

let getenv_fn = bind("libc", "getenv", ["string"], "ptr")
let home_addr = getenv_fn("HOME")
let home = read_cstring(home_addr)
assert(home != null and len(home) > 0, "HOME is set and non-empty")
assert(starts(home, "/") or starts(home, "C:"), "HOME looks like a path")

-- A missing variable returns a null pointer; read_cstring should give null
let missing = getenv_fn("ZZZ_DEFINITELY_DOES_NOT_EXIST_ZZZ")
let missing_str = read_cstring(missing)
assert(missing_str == null, "missing env var reads as null")

-- ── alloc cstring + pass as ptr ─────────────────────────

show "-- FFI: alloc cstring buffer --"

let greeting = cstring("hi there")
assert(type(greeting) == "Pointer", "cstring returns a Pointer")
-- 8 chars + 1 null terminator
assert_eq(greeting.size(), 9, "cstring buffer includes terminator")
-- First byte is 'h' (104)
assert_eq(greeting.read_byte(0), 104, "first byte is 'h'")
-- Last byte is null terminator
assert_eq(greeting.read_byte(8), 0, "trailing null terminator")
-- Reading the whole thing as a C string round-trips
assert_eq(greeting.read_string(), "hi there", "cstring read_string roundtrip")

-- ── Struct: simple homogeneous fields ───────────────────

show "-- FFI: struct Point (two f64) --"

let Point = struct("Point", [
    ["x", "f64"],
    ["y", "f64"]
])
assert_eq(Point.size, 16, "Point size = 2 * f64")
assert_eq(Point.alignment, 8, "Point alignment = 8")
assert_eq(Point.offsets["x"], 0, "x at offset 0")
assert_eq(Point.offsets["y"], 8, "y at offset 8")

let p = Point.new()
p.set("x", 3.14)
p.set("y", 2.71)
let xv = p.get("x")
let yv = p.get("y")
assert(xv > 3.13 and xv < 3.15, "Point.x roundtrip")
assert(yv > 2.70 and yv < 2.72, "Point.y roundtrip")

-- ── Struct: mixed types with padding ────────────────────

show "-- FFI: struct mixed types --"

-- Layout: i8 (1), pad (3), i32 (4), i8 (1), pad (7), f64 (8) = 24 bytes
let Mixed = struct("Mixed", [
    ["flag", "i8"],
    ["count", "i32"],
    ["mode", "i8"],
    ["value", "f64"]
])
assert_eq(Mixed.offsets["flag"], 0, "flag at 0")
assert_eq(Mixed.offsets["count"], 4, "count at 4 (after 3 bytes pad)")
assert_eq(Mixed.offsets["mode"], 8, "mode at 8")
assert_eq(Mixed.offsets["value"], 16, "value at 16 (after 7 bytes pad)")
assert_eq(Mixed.size, 24, "total size 24 (rounded to 8-alignment)")

let m = Mixed.new()
m.set("flag", -1)
m.set("count", 12345)
m.set("mode", 7)
m.set("value", 1.5)
assert_eq(m.get("flag"), -1, "i8 negative roundtrip")
assert_eq(m.get("count"), 12345, "i32 roundtrip")
assert_eq(m.get("mode"), 7, "i8 positive roundtrip")
assert_eq(m.get("value"), 1.5, "f64 roundtrip")

-- Wrap an existing pointer as a struct
let m2 = Mixed.from_ptr(m.ptr)
assert_eq(m2.get("count"), 12345, "from_ptr reads same memory")

-- Bool field
let Flags = struct("Flags", [["enabled", "bool"], ["visible", "bool"]])
let f = Flags.new()
f.set("enabled", true)
f.set("visible", false)
assert(f.get("enabled") == true, "bool true roundtrip")
assert(f.get("visible") == false, "bool false roundtrip")

-- Unknown field name should throw
mut threw_field = false
try { f.get("nope") } catch e { threw_field = true }
assert(threw_field, "unknown field throws")

-- Unknown type should throw at struct() time
mut threw_type_def = false
try {
    struct("Bad", [["x", "not-a-type"]])
} catch e {
    threw_type_def = true
}
assert(threw_type_def, "unknown field type throws")

-- ── Callback: qsort with a Clarity comparator ──────────

show "-- FFI: callback (qsort) --"

let qsort = bind("libc", "qsort", ["ptr", "u64", "u64", "ptr"], "void")

mut compare_calls = 0
let cmp = callback(fn(a, b) {
    compare_calls += 1
    return _ffi_read_i32(a, 0) - _ffi_read_i32(b, 0)
}, ["ptr", "ptr"], "i32")

assert(type(cmp) == "Callback", "callback returns a Callback")
assert(cmp.addr() != null, "callback has a non-null addr")

-- Build [5, 2, 4, 1, 3] in a 5*4 = 20-byte buffer
let arr = alloc(20)
arr.write_i32(0, 5)
arr.write_i32(4, 2)
arr.write_i32(8, 4)
arr.write_i32(12, 1)
arr.write_i32(16, 3)

qsort(arr, 5, 4, cmp.addr())

assert_eq(arr.read_i32(0),  1, "qsort[0] = 1")
assert_eq(arr.read_i32(4),  2, "qsort[1] = 2")
assert_eq(arr.read_i32(8),  3, "qsort[2] = 3")
assert_eq(arr.read_i32(12), 4, "qsort[3] = 4")
assert_eq(arr.read_i32(16), 5, "qsort[4] = 5")
assert(compare_calls > 0, "comparator was actually invoked")

cmp.close()

-- ── Bulk arrays ─────────────────────────────────────────

show "-- FFI: bulk arrays --"

-- write_array / read_array round-trip through a raw buffer (f32).
let fbuf = alloc(4 * 4)
fbuf.write_array("f32", [1.5, 2.5, 3.5, 4.5], 0)
let fout = fbuf.read_array("f32", 4, 0)
assert_eq(len(fout), 4, "read_array length")
assert_eq(fout[0], 1.5, "read_array[0]")
assert_eq(fout[3], 4.5, "read_array[3]")

-- i32 round-trip with an offset into the middle of the buffer.
let ibuf = alloc(4 * 5)
ibuf.write_array("i32", [10, 20, 30], 8)
assert_eq(ibuf.read_i32(8), 10, "write_array honours byte offset")
assert_eq(ibuf.read_array("i32", 3, 8), [10, 20, 30], "read_array honours byte offset")

-- ffi.array() convenience: allocate + prefill from a list.
let av = array("f64", [0.25, 0.5, 0.75])
assert_eq(av.read_array("f64", 3, 0), [0.25, 0.5, 0.75], "array(type, list) prefills")
-- ffi.array() with a count allocates zeroed space.
let az = array("i32", 4)
assert_eq(az.read_array("i32", 4, 0), [0, 0, 0, 0], "array(type, count) zeroes")

mut threw_arr_type = false
try { alloc(8).read_array("nope", 1, 0) } catch e { threw_arr_type = true }
assert(threw_arr_type, "read_array throws on unknown element type")

-- ── Struct arrays ───────────────────────────────────────

show "-- FFI: struct arrays --"

let Vec2 = struct("Vec2", [["x", "f32"], ["y", "f32"]])
let vecs = Vec2.array(3)
assert_eq(vecs.size(), Vec2.size * 3, "struct array total size")
vecs.at(0).set("x", 1.0)
vecs.at(0).set("y", 2.0)
vecs.at(2).set("x", 9.0)
-- A fresh view of the same element sees the written value (shared buffer).
assert_eq(vecs.at(0).get("x"), 1.0, "struct array element 0 x")
assert_eq(vecs.at(0).get("y"), 2.0, "struct array element 0 y")
assert_eq(vecs.at(2).get("x"), 9.0, "struct array element 2 x")
-- Element 2 is Vec2.size*2 bytes past the base.
assert_eq(vecs.at(2).addr(), vecs.addr() + Vec2.size * 2, "struct array element addr stride")

mut threw_oob = false
try { vecs.at(3) } catch e { threw_oob = true }
assert(threw_oob, "struct array index out of range throws")

-- ── Nested structs ──────────────────────────────────────

show "-- FFI: nested structs --"

let Line = struct("Line", [["start", Vec2], ["end", Vec2]])
assert_eq(Line.size, Vec2.size * 2, "nested struct size is sum of parts")
let ln = Line.new()
ln.get("start").set("x", 3.0)
ln.get("start").set("y", 4.0)
ln.get("end").set("x", 5.0)
assert_eq(ln.get("start").get("x"), 3.0, "nested struct start.x")
assert_eq(ln.get("start").get("y"), 4.0, "nested struct start.y")
assert_eq(ln.get("end").get("x"), 5.0, "nested struct end.x")
-- The nested view addresses into the parent buffer at the field offset.
assert_eq(ln.get("end").addr(), ln.addr() + Vec2.size, "nested field addr offset")

mut threw_nested_set = false
try { ln.set("start", Vec2.new()) } catch e { threw_nested_set = true }
assert(threw_nested_set, "direct assignment of a nested struct field throws")

-- ── Errors ──────────────────────────────────────────────

show "-- FFI: error paths --"

mut threw = false
try {
    bind("libc", "this_symbol_does_not_exist_anywhere", [], "void")
} catch e {
    threw = true
}
assert(threw, "bind throws on missing symbol")

mut threw_type = false
try {
    bind("libc", "getpid", [], "not-a-real-type")
} catch e {
    threw_type = true
}
assert(threw_type, "bind throws on unknown type name")

-- ── Summary ─────────────────────────────────────────────

show ""
show "FFI: " + str(PASSED) + " passed, " + str(FAILED) + " failed"
if FAILED > 0 { throw str(FAILED) + " ffi test(s) failed" }
