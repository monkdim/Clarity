-- Draw — 2D drawing primitives that operate on a Framebuffer.
--
-- All functions take the target framebuffer as their first argument so
-- they compose cleanly with anything that exposes put_pixel / fill_rect:
--
--     from "graphics.clarity" import framebuffer, RED
--     from "draw.clarity" import line, circle, polygon
--
--     let fb = framebuffer(400, 300)
--     line(fb, 0, 0, 399, 299, RED)
--     circle(fb, 200, 150, 50, RED)
--
-- Algorithms are the textbook integer-only ones (Bresenham for lines,
-- midpoint for circles) — no anti-aliasing yet; that lands as a follow-up
-- once we have a font and can compare against ground-truth output.

-- ── Line: Bresenham's algorithm ──────────────────────────

fn line(fb, x0, y0, x1, y1, color) {
    mut x = x0
    mut y = y0
    let dx = if x1 > x0 { x1 - x0 } else { x0 - x1 }
    let dy = if y1 > y0 { y1 - y0 } else { y0 - y1 }
    let sx = if x0 < x1 { 1 } else { -1 }
    let sy = if y0 < y1 { 1 } else { -1 }
    let nd = -dy
    mut err = dx + nd
    mut done = false
    while not done {
        fb.put_pixel(x, y, color)
        if x == x1 and y == y1 {
            done = true
        } else {
            let e2 = 2 * err
            if e2 >= nd {
                err += nd
                x += sx
            }
            if e2 <= dx {
                err += dx
                y += sy
            }
        }
    }
}

-- Horizontal/vertical lines optimise to a single fill_rect when the
-- caller knows they're axis-aligned — handy inside other primitives.
fn hline(fb, x0, y, x1, color) {
    let xa = if x0 < x1 { x0 } else { x1 }
    let xb = if x0 < x1 { x1 } else { x0 }
    fb.fill_rect(xa, y, xb - xa + 1, 1, color)
}

fn vline(fb, x, y0, y1, color) {
    let ya = if y0 < y1 { y0 } else { y1 }
    let yb = if y0 < y1 { y1 } else { y0 }
    fb.fill_rect(x, ya, 1, yb - ya + 1, color)
}

-- ── Rectangle outline (alias on Framebuffer.stroke_rect) ──

fn rect(fb, x, y, w, h, color) {
    fb.stroke_rect(x, y, w, h, color)
}

fn fill_rect(fb, x, y, w, h, color) {
    fb.fill_rect(x, y, w, h, color)
}

-- ── Circle: midpoint algorithm (outline) ─────────────────

fn circle_outline(fb, cx, cy, r, color) {
    if r < 0 { return null }
    mut x = r
    mut y = 0
    mut err = 0
    while x >= y {
        fb.put_pixel(cx + x, cy + y, color)
        fb.put_pixel(cx + y, cy + x, color)
        fb.put_pixel(cx - y, cy + x, color)
        fb.put_pixel(cx - x, cy + y, color)
        fb.put_pixel(cx - x, cy - y, color)
        fb.put_pixel(cx - y, cy - x, color)
        fb.put_pixel(cx + y, cy - x, color)
        fb.put_pixel(cx + x, cy - y, color)
        y += 1
        if err <= 0 {
            err += 2 * y + 1
        }
        if err > 0 {
            x -= 1
            err -= 2 * x + 1
        }
    }
}

-- ── Circle: filled (horizontal scanlines) ───────────────

fn circle(fb, cx, cy, r, color) {
    if r < 0 { return null }
    let r2 = r * r
    mut dy = 0 - r
    while dy <= r {
        -- floor(sqrt(r^2 - dy^2)) using integer search avoids a math import
        mut dx = 0
        while (dx + 1) * (dx + 1) + dy * dy <= r2 {
            dx += 1
        }
        hline(fb, cx - dx, cy + dy, cx + dx, color)
        dy += 1
    }
}

-- ── Rounded rectangle (filled, anti-aliased) ────────────

-- Paint the four quarter-round corners with per-pixel coverage. The
-- caller has already filled the straight interior; each corner box is an
-- r×r square whose arc-centre sits at its inner join. Coverage
-- (distance from that centre, softened over one pixel) scales the
-- colour's alpha and composites over whatever's already there — so the
-- diagonal edge is a smooth ramp instead of a staircase, and it works on
-- an opaque panel or against a live background alike.
fn _aa_corners(fb, x, y, w, h, r, color) {
    let base_a = int(color / 16777216) & 0xFF
    let rgb = color & 0xFFFFFF
    -- each quad: [box_x, box_y, centre_x, centre_y]
    let quads = [
        [x,         y,         x + r,     y + r],
        [x + w - r, y,         x + w - r, y + r],
        [x,         y + h - r, x + r,     y + h - r],
        [x + w - r, y + h - r, x + w - r, y + h - r]
    ]
    for q in quads {
        let bx = q[0]
        let by = q[1]
        let ccx = q[2]
        let ccy = q[3]
        mut yy = 0
        while yy < r {
            mut xx = 0
            while xx < r {
                let px = bx + xx
                let py = by + yy
                let ex = px + 0.5 - ccx
                let ey = py + 0.5 - ccy
                let d = sqrt(ex * ex + ey * ey)
                mut cov = r + 0.5 - d
                if cov > 1.0 { cov = 1.0 }
                if cov > 0.0 {
                    let a = int(base_a * cov)
                    if a > 0 { blend_pixel(fb, px, py, a * 16777216 + rgb) }
                }
                xx = xx + 1
            }
            yy = yy + 1
        }
    }
}

fn rounded_rect(fb, x, y, w, h, radius, color) {
    let r0 = if radius * 2 > w { int(w / 2) } else { radius }
    let r = if r0 * 2 > h { int(h / 2) } else { r0 }
    if r <= 0 {
        fb.fill_rect(x, y, w, h, color)
        return null
    }
    -- Straight interior: centre column full height, side bars between arcs.
    fb.fill_rect(x + r, y, w - 2 * r, h, color)
    fb.fill_rect(x, y + r, r, h - 2 * r, color)
    fb.fill_rect(x + w - r, y + r, r, h - 2 * r, color)
    -- Anti-aliased quarter-round corners.
    _aa_corners(fb, x, y, w, h, r, color)
}

-- ── Arc: angular slice of a circle outline ──────────────
-- Angles are in degrees, 0° = +X axis, 90° = +Y (down).

fn arc(fb, cx, cy, r, start_deg, end_deg, color) {
    if r < 0 { return null }
    -- Normalise so we sweep CCW from start to end
    mut s = start_deg % 360
    mut e = end_deg % 360
    if s < 0 { s += 360 }
    if e < 0 { e += 360 }
    if e < s { e += 360 }
    -- Sample enough steps that adjacent points are always within 1 pixel
    let steps = if r * 6 < 32 { 32 } else { r * 6 }
    let span = e - s
    mut i = 0
    while i <= steps {
        let frac = (i * 1.0) / steps
        let theta = (s + span * frac) * 3.14159265358979 / 180.0
        let dx = round(cos(theta) * r)
        let dy = round(sin(theta) * r)
        fb.put_pixel(cx + dx, cy + dy, color)
        i += 1
    }
}

-- ── Polygon: connect points with straight segments ──────
-- `points` is a list of [x, y] pairs.

fn polygon(fb, points, color) {
    let n = len(points)
    if n < 2 { return null }
    mut i = 0
    while i < n {
        let a = points[i]
        let b = points[(i + 1) % n]
        line(fb, a[0], a[1], b[0], b[1], color)
        i += 1
    }
}

-- ── Polygon: filled (scanline, even-odd rule) ───────────
-- Fills the area enclosed by `points` (a list of [x, y] pairs,
-- auto-closed). Works for convex and simple concave polygons.
-- Integer scanlines; pair up edge crossings left-to-right.
fn fill_polygon(fb, points, color) {
    let n = len(points)
    if n < 3 { return null }
    -- vertical extent
    mut min_y = points[0][1]
    mut max_y = points[0][1]
    mut i = 1
    while i < n {
        let py = points[i][1]
        if py < min_y { min_y = py }
        if py > max_y { max_y = py }
        i += 1
    }
    if min_y < 0 { min_y = 0 }
    if max_y > fb.height - 1 { max_y = fb.height - 1 }

    mut y = min_y
    while y <= max_y {
        -- collect x-crossings of all edges at this scanline
        mut xs = []
        mut e = 0
        while e < n {
            let a = points[e]
            let b = points[(e + 1) % n]
            let ay = a[1]
            let by = b[1]
            -- edge straddles the scanline (half-open to avoid double-count)
            if (ay <= y and by > y) or (by <= y and ay > y) {
                let t = (y - ay) / (by - ay)
                let x = a[0] + (b[0] - a[0]) * t
                push(xs, x)
            }
            e += 1
        }
        -- sort crossings ascending (small n — insertion sort)
        mut a2 = 1
        while a2 < len(xs) {
            let key = xs[a2]
            mut b2 = a2 - 1
            while b2 >= 0 and xs[b2] > key { xs[b2 + 1] = xs[b2]; b2 -= 1 }
            xs[b2 + 1] = key
            a2 += 1
        }
        -- fill spans between crossing pairs
        mut p = 0
        while p + 1 < len(xs) {
            let x0 = int(xs[p])
            let x1 = int(xs[p + 1])
            if x1 >= x0 { fill_rect(fb, x0, y, x1 - x0 + 1, 1, color) }
            p += 2
        }
        y += 1
    }
}

-- Open polyline (no closing segment).
fn polyline(fb, points, color) {
    let n = len(points)
    if n < 2 { return null }
    mut i = 0
    while i < n - 1 {
        let a = points[i]
        let b = points[i + 1]
        line(fb, a[0], a[1], b[0], b[1], color)
        i += 1
    }
}

-- ── Alpha compositing (source-over) ─────────────────────
-- Colors are 0xAARRGGBB. Channels are unpacked by division (not `>>`)
-- so the 0xFF alpha byte never sign-extends. The destination is
-- treated as opaque, so results are opaque — exactly what a screen
-- framebuffer wants.

-- Composite `src` (possibly translucent) over an opaque `dst`.
fn blend_over(dst, src) {
    let sa = int(src / 16777216) & 0xFF
    if sa == 255 { return src }
    if sa == 0 { return dst }
    let sr = int(src / 65536) & 0xFF
    let sg = int(src / 256) & 0xFF
    let sb = src & 0xFF
    let dr = int(dst / 65536) & 0xFF
    let dg = int(dst / 256) & 0xFF
    let db = dst & 0xFF
    let ia = 255 - sa
    let orr = int((sr * sa + dr * ia) / 255)
    let og  = int((sg * sa + dg * ia) / 255)
    let ob  = int((sb * sa + db * ia) / 255)
    return 255 * 16777216 + orr * 65536 + og * 256 + ob
}

-- Blend one translucent pixel onto the framebuffer.
fn blend_pixel(fb, x, y, color) {
    let sa = int(color / 16777216) & 0xFF
    if sa == 255 { fb.put_pixel(x, y, color); return null }
    if sa == 0 { return null }
    fb.put_pixel(x, y, blend_over(fb.get_pixel(x, y), color))
}

-- Alpha-aware rectangle fill. Opaque colors take the fast FFI path;
-- translucent colors composite per pixel (translucent panels, glass,
-- scrims, soft shadows).
fn fill_rect_blend(fb, x, y, w, h, color) {
    let sa = int(color / 16777216) & 0xFF
    if sa == 0 { return null }
    if sa == 255 { fb.fill_rect(x, y, w, h, color); return null }
    fb.blend_rect(x, y, w, h, color)
}

-- ── Gradients ───────────────────────────────────────────
-- Interpolate two 0xAARRGGBB colors (alpha included) at t in [0,1].
fn lerp_rgba(a, b, t) {
    let aa = int(a / 16777216) & 0xFF
    let ar = int(a / 65536) & 0xFF
    let ag = int(a / 256) & 0xFF
    let ab = a & 0xFF
    let ba = int(b / 16777216) & 0xFF
    let br = int(b / 65536) & 0xFF
    let bg = int(b / 256) & 0xFF
    let bb = b & 0xFF
    let oa = int(aa + (ba - aa) * t)
    let orr = int(ar + (br - ar) * t)
    let og = int(ag + (bg - ag) * t)
    let ob = int(ab + (bb - ab) * t)
    return oa * 16777216 + orr * 65536 + og * 256 + ob
}

-- Sample a stop list [{"t": f, "color": c}, ...] (ascending t) at t.
fn sample_stops(stops, t) {
    mut clamped = t
    if clamped < 0.0 { clamped = 0.0 }
    if clamped > 1.0 { clamped = 1.0 }
    mut i = 0
    while i < len(stops) - 1 {
        let s0 = stops[i]
        let s1 = stops[i + 1]
        if clamped >= s0["t"] and clamped <= s1["t"] {
            let span = s1["t"] - s0["t"]
            let local = if span == 0.0 { 0.0 } else { (clamped - s0["t"]) / span }
            return lerp_rgba(s0["color"], s1["color"], local)
        }
        i += 1
    }
    return stops[len(stops) - 1]["color"]
}

-- Fill a rect with a linear gradient across `stops`. dir "h"
-- (left→right) or "v" (top→bottom). Alpha-aware: translucent stops
-- composite, opaque stops take the fast per-line fill.
fn linear_gradient(fb, x, y, w, h, stops, dir) {
    if w <= 0 or h <= 0 { return null }
    if dir == "v" {
        mut yy = 0
        while yy < h {
            let t = if h <= 1 { 0.0 } else { yy / (h - 1) }
            let c = sample_stops(stops, t)
            fill_rect_blend(fb, x, y + yy, w, 1, c)
            yy += 1
        }
    } else {
        mut xx = 0
        while xx < w {
            let t = if w <= 1 { 0.0 } else { xx / (w - 1) }
            let c = sample_stops(stops, t)
            fill_rect_blend(fb, x + xx, y, 1, h, c)
            xx += 1
        }
    }
}

-- Soft radial glow: `color`'s alpha is the peak at the centre, easing
-- to zero at `radius` (squared falloff — no sqrt). The neon halo.
fn radial_glow(fb, cx, cy, radius, color) {
    if radius <= 0 { return null }
    let peak = int(color / 16777216) & 0xFF
    let rgb = color & 0xFFFFFF
    let r2 = radius * radius
    mut yy = cy - radius
    while yy <= cy + radius {
        mut xx = cx - radius
        while xx <= cx + radius {
            let dx = xx - cx
            let dy = yy - cy
            let d2 = dx * dx + dy * dy
            if d2 <= r2 {
                let falloff = 1.0 - (d2 / r2)
                let a = int(peak * falloff)
                if a > 0 { blend_pixel(fb, xx, yy, a * 16777216 + rgb) }
            }
            xx += 1
        }
        yy += 1
    }
}

-- ── Glass panels & soft shadows ─────────────────────────
-- Blend a single horizontal span (helper for the rounded fill).
fn _hline_blend(fb, x0, y, x1, color) {
    if x1 < x0 { return null }
    fb.blend_rect(x0, y, x1 - x0 + 1, 1, color)
}

-- Alpha-aware rounded rectangle — a translucent glass panel. Opaque
-- colours fall through to the fast rounded_rect. The straight interior
-- composites once; the corners use the same coverage-based AA as the
-- opaque path, with coverage folded into the source alpha so a
-- translucent panel keeps a smooth edge.
fn rounded_rect_blend(fb, x, y, w, h, radius, color) {
    let sa = int(color / 16777216) & 0xFF
    if sa == 0 { return null }
    if sa == 255 { rounded_rect(fb, x, y, w, h, radius, color); return null }
    let r0 = if radius * 2 > w { int(w / 2) } else { radius }
    let r = if r0 * 2 > h { int(h / 2) } else { r0 }
    if r <= 0 { fill_rect_blend(fb, x, y, w, h, color); return null }
    fill_rect_blend(fb, x + r, y, w - 2 * r, h, color)
    fill_rect_blend(fb, x, y + r, r, h - 2 * r, color)
    fill_rect_blend(fb, x + w - r, y + r, r, h - 2 * r, color)
    -- corners: reuse _aa_corners (it already folds coverage into alpha
    -- and composites via blend_pixel, so a translucent colour stays glassy)
    _aa_corners(fb, x, y, w, h, r, color)
}

-- Soft drop shadow beneath a panel: `blur` translucent rounded rects,
-- each larger and drawn underneath the next, so alpha accumulates near
-- the panel edge and fades outward. `color`'s alpha is the total the
-- shadow builds to. Slightly offset downward. Draw before the panel.
fn drop_shadow(fb, x, y, w, h, radius, color, blur) {
    if blur <= 0 { return null }
    let a = int(color / 16777216) & 0xFF
    let rgb = color & 0xFFFFFF
    let per = if a < blur { 1 } else { int(a / blur) }
    let off = int(blur / 2)
    mut i = blur
    while i >= 1 {
        rounded_rect_blend(fb, x - i, y - i + off, w + 2 * i, h + 2 * i, radius + i, per * 16777216 + rgb)
        i -= 1
    }
}

-- ── Rounded compositing (rounded window corners) ────────
-- One rounded corner of a source→destination copy. The r×r box lives in
-- `dst` coordinates; `cx,cy` is the arc centre; the matching source pixel
-- is (px - ox, py - oy). Interior pixels copy straight; the diagonal edge
-- composites the source over the destination background at fractional
-- coverage, so the corner is smooth against whatever it floats over.
fn _blit_corner(dst, src, ox, oy, box_x, box_y, cx, cy, r) {
    mut yy = 0
    while yy < r {
        mut xx = 0
        while xx < r {
            let px = box_x + xx
            let py = box_y + yy
            let ex = px + 0.5 - cx
            let ey = py + 0.5 - cy
            let d = sqrt(ex * ex + ey * ey)
            mut cov = r + 0.5 - d
            if cov > 1.0 { cov = 1.0 }
            if cov > 0.0 {
                let sp = src.get_pixel(px - ox, py - oy)
                if cov >= 1.0 {
                    dst.put_pixel(px, py, sp)
                } else {
                    let a = int(255 * cov)
                    blend_pixel(dst, px, py, a * 16777216 + (sp & 0xFFFFFF))
                }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

-- Blit `src` onto `dst` at (dx,dy) with anti-aliased rounded corners —
-- the copy a window compositor wants so its panels float with soft edges
-- instead of hard rectangles. The straight interior takes the fast row
-- copy (blit); only the four corner boxes are composited per pixel.
fn blit_rounded(dst, src, dx, dy, w, h, radius) {
    let r0 = if radius * 2 > w { int(w / 2) } else { radius }
    let r = if r0 * 2 > h { int(h / 2) } else { r0 }
    if r <= 0 { dst.blit(src, 0, 0, dx, dy, w, h); return null }
    -- fast interior: centre column + side bars (skips the corner boxes)
    dst.blit(src, r, 0, dx + r, dy, w - 2 * r, h)
    dst.blit(src, 0, r, dx, dy + r, r, h - 2 * r)
    dst.blit(src, w - r, r, dx + w - r, dy + r, r, h - 2 * r)
    -- four anti-aliased corners
    _blit_corner(dst, src, dx, dy, dx,         dy,         dx + r,     dy + r,     r)
    _blit_corner(dst, src, dx, dy, dx + w - r, dy,         dx + w - r, dy + r,     r)
    _blit_corner(dst, src, dx, dy, dx,         dy + h - r, dx + r,     dy + h - r, r)
    _blit_corner(dst, src, dx, dy, dx + w - r, dy + h - r, dx + w - r, dy + h - r, r)
}
