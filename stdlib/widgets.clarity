-- Widgets — concrete subclasses of `Widget`.
--
-- Each widget provides three things:
--   * its own state fields (text, checked, value, ...)
--   * a `_paint(fb)` override that draws via graphics/draw/font
--   * a `_handle(event)` override for any local behaviour
--
-- All widgets pull colours/fonts from the active theme via
-- `this.theme()` so dropping the root's theme swaps the look.

from "ui.clarity" import Widget
from "theme.clarity" import theme_color, theme_font, theme_spacing
from "graphics.clarity" import rgb, rgba
from "draw.clarity" import line, hline, vline, fill_rect, rect, circle, circle_outline
from "font.clarity" import draw_text, measure_text

-- ── Label — non-interactive text ───────────────────────

class Label < Widget {
    fn init(text) {
        this._setup_widget()
        this.role = "label"
        this.text = text ?? ""
        this.color_key = "foreground"
        this.align = "start"      -- start | center | end
    }

    fn preferred_size() {
        let f = theme_font(this.theme())
        let m = measure_text(f, this.text)
        return [m[0], m[1]]
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let f = theme_font(t)
        let color = theme_color(t, this.color_key)
        let m = measure_text(f, this.text)
        mut tx = r[0]
        if this.align == "center" { tx = r[0] + (r[2] - m[0]) / 2 }
        elif this.align == "end" { tx = r[0] + r[2] - m[0] }
        let ty = r[1] + (r[3] - m[1]) / 2
        draw_text(fb, tx, ty, this.text, f, color)
    }
}

fn label(text) { return Label(text) }

-- ── Button ─────────────────────────────────────────────

class Button < Widget {
    fn init(text) {
        this._setup_widget()
        this.role = "button"
        this.text = text ?? ""
        this.focusable = true
        this.pressed = false
        this.padding_x = 12
        this.padding_y = 6
    }

    fn preferred_size() {
        let f = theme_font(this.theme())
        let m = measure_text(f, this.text)
        return [m[0] + this.padding_x * 2, m[1] + this.padding_y * 2]
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let bg = if not this.enabled {
            theme_color(t, "disabled")
        } else { if this.pressed { theme_color(t, "accent_muted") } else { theme_color(t, "accent") } }
        let fg = theme_color(t, "foreground")
        fill_rect(fb, r[0], r[1], r[2], r[3], bg)
        if this.focused {
            rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "focus_ring"))
        } else {
            rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "border"))
        }
        let f = theme_font(t)
        let m = measure_text(f, this.text)
        draw_text(fb, r[0] + (r[2] - m[0]) / 2, r[1] + (r[3] - m[1]) / 2, this.text, f, fg)
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        if kind == "mouse" {
            if event.is_press {
                this.pressed = true
                this.focus()
                return true
            }
            if event.is_release {
                let was_pressed = this.pressed
                this.pressed = false
                if was_pressed and this._click_handler != null {
                    this._click_handler(event)
                }
                return true
            }
        }
        if kind == "key" and this.focused and event.is_press {
            if event.name == "Enter" or event.name == " " {
                if this._click_handler != null { this._click_handler(event) }
                return true
            }
        }
        return false
    }
}

fn button(text) { return Button(text) }

-- ── Checkbox ───────────────────────────────────────────

class Checkbox < Widget {
    fn init(label_text) {
        this._setup_widget()
        this.role = "checkbox"
        this.label = label_text ?? ""
        this.checked = false
        this.focusable = true
        this.box_size = 16
        this.gap = 8
    }

    fn preferred_size() {
        let f = theme_font(this.theme())
        let m = measure_text(f, this.label)
        let h = if m[1] > this.box_size { m[1] } else { this.box_size }
        return [this.box_size + this.gap + m[0], h]
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let by = r[1] + (r[3] - this.box_size) / 2
        let border_color = if this.focused { theme_color(t, "focus_ring") } else { theme_color(t, "border") }
        let bg = if this.checked { theme_color(t, "accent") } else { theme_color(t, "surface") }
        fill_rect(fb, r[0], by, this.box_size, this.box_size, bg)
        rect(fb, r[0], by, this.box_size, this.box_size, border_color)
        if this.checked {
            -- Two-line checkmark: from lower-left up to upper-right
            let cx = r[0]
            let cy = by
            let s = this.box_size
            let fg = theme_color(t, "foreground")
            line(fb, cx + 3, cy + s / 2,     cx + s / 2 - 1, cy + s - 4, fg)
            line(fb, cx + s / 2 - 1, cy + s - 4, cx + s - 3, cy + 3,         fg)
        }
        let f = theme_font(t)
        let m = measure_text(f, this.label)
        draw_text(fb, r[0] + this.box_size + this.gap, r[1] + (r[3] - m[1]) / 2, this.label, f, theme_color(t, "foreground"))
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        if kind == "mouse" and event.is_press {
            this.checked = not this.checked
            this.focus()
            if this._click_handler != null { this._click_handler(event) }
            return true
        }
        if kind == "key" and this.focused and event.is_press and (event.name == " " or event.name == "Enter") {
            this.checked = not this.checked
            if this._click_handler != null { this._click_handler(event) }
            return true
        }
        return false
    }

    fn toggle() { this.checked = not this.checked }
}

fn checkbox(label_text) { return Checkbox(label_text) }

-- ── ProgressBar ────────────────────────────────────────

class ProgressBar < Widget {
    fn init() {
        this._setup_widget()
        this.role = "progressbar"
        this.value = 0.0          -- 0.0 .. 1.0
        this.indeterminate = false
    }

    fn set_value(v) {
        if v < 0.0 { v = 0.0 }
        if v > 1.0 { v = 1.0 }
        this.value = v
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        fill_rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "surface"))
        rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "border"))
        if not this.indeterminate {
            let inner_w = int(r[2] * this.value)
            if inner_w > 0 {
                fill_rect(fb, r[0] + 1, r[1] + 1, inner_w - 1, r[3] - 2, theme_color(t, "accent"))
            }
        }
    }
}

fn progress_bar() { return ProgressBar() }

-- ── Slider ─────────────────────────────────────────────

class Slider < Widget {
    fn init(min_v, max_v) {
        this._setup_widget()
        this.role = "slider"
        this.focusable = true
        this.min = min_v ?? 0
        this.max = max_v ?? 100
        this.value = this.min
        this.step = 1
        this._dragging = false
    }

    fn set_value(v) {
        if v < this.min { v = this.min }
        if v > this.max { v = this.max }
        this.value = v
        if this._click_handler != null { this._click_handler(this) }
    }

    fn _track_y(r) { return r[1] + r[3] / 2 - 1 }
    fn _knob_radius() { return 6 }

    fn _value_to_x(r) {
        let kr = this._knob_radius()
        let span = r[2] - kr * 2
        if this.max == this.min { return r[0] + kr }
        let frac = (this.value - this.min) * 1.0 / (this.max - this.min)
        return int(r[0] + kr + frac * span)
    }

    fn _x_to_value(r, sx) {
        let kr = this._knob_radius()
        let span = r[2] - kr * 2
        if span <= 0 { return this.min }
        mut frac = (sx - r[0] - kr) * 1.0 / span
        if frac < 0 { frac = 0 }
        if frac > 1 { frac = 1 }
        let raw = this.min + frac * (this.max - this.min)
        return int(raw / this.step) * this.step
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let track_y = this._track_y(r)
        fill_rect(fb, r[0], track_y, r[2], 3, theme_color(t, "border"))
        -- Filled portion of the track
        let knob_x = this._value_to_x(r)
        fill_rect(fb, r[0], track_y, knob_x - r[0], 3, theme_color(t, "accent"))
        -- Knob
        let kr = this._knob_radius()
        circle(fb, knob_x, r[1] + r[3] / 2, kr, theme_color(t, "accent"))
        if this.focused {
            rect(fb, knob_x - kr - 1, r[1] + r[3] / 2 - kr - 1, kr * 2 + 2, kr * 2 + 2, theme_color(t, "focus_ring"))
        }
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        let r = this.screen_rect()
        if kind == "mouse" {
            if event.is_press {
                this._dragging = true
                this.focus()
                this.set_value(this._x_to_value(r, event.x))
                return true
            }
            if event.is_release and this._dragging {
                this._dragging = false
                return true
            }
            if event.is_motion and this._dragging {
                this.set_value(this._x_to_value(r, event.x))
                return true
            }
        }
        if kind == "key" and this.focused and event.is_press {
            if event.name == "Left"  { this.set_value(this.value - this.step); return true }
            if event.name == "Right" { this.set_value(this.value + this.step); return true }
            if event.name == "Home"  { this.set_value(this.min); return true }
            if event.name == "End"   { this.set_value(this.max); return true }
        }
        return false
    }
}

fn slider(min_v, max_v) { return Slider(min_v, max_v) }

-- ── TextInput ──────────────────────────────────────────
-- Single-line editable text. Supports Backspace, arrow keys, Home, End,
-- Delete, and printable characters from KeyEvent.char.

class TextInput < Widget {
    fn init() {
        this._setup_widget()
        this.role = "textbox"
        this.focusable = true
        this.text = ""
        this.cursor = 0
        this.placeholder = ""
        this.padding_x = 6
        this.padding_y = 4
    }

    fn preferred_size() {
        let f = theme_font(this.theme())
        return [120, f.height + this.padding_y * 2]
    }

    fn set_text(s) {
        this.text = s ?? ""
        if this.cursor > len(this.text) { this.cursor = len(this.text) }
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let f = theme_font(t)
        fill_rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "surface"))
        let border_c = if this.focused { theme_color(t, "focus_ring") } else { theme_color(t, "border") }
        rect(fb, r[0], r[1], r[2], r[3], border_c)
        let display = this.text
        let fg = theme_color(t, "foreground")
        if len(display) == 0 {
            display = this.placeholder
            fg = theme_color(t, "foreground_muted")
        }
        draw_text(fb, r[0] + this.padding_x, r[1] + this.padding_y, display, f, fg)
        if this.focused and len(this.text) > 0 {
            let prefix = substring(this.text, 0, this.cursor)
            let m = measure_text(f, prefix)
            let cx = r[0] + this.padding_x + m[0]
            line(fb, cx, r[1] + this.padding_y, cx, r[1] + r[3] - this.padding_y, theme_color(t, "foreground"))
        } elif this.focused {
            let cx = r[0] + this.padding_x
            line(fb, cx, r[1] + this.padding_y, cx, r[1] + r[3] - this.padding_y, theme_color(t, "foreground"))
        }
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        if kind == "mouse" and event.is_press {
            this.focus()
            return true
        }
        if kind != "key" or not this.focused or not event.is_press { return false }
        let n = len(this.text)
        if event.name == "Backspace" {
            if this.cursor > 0 {
                this.text = substring(this.text, 0, this.cursor - 1) + substring(this.text, this.cursor, n)
                this.cursor -= 1
            }
            return true
        }
        if event.name == "Delete" {
            if this.cursor < n {
                this.text = substring(this.text, 0, this.cursor) + substring(this.text, this.cursor + 1, n)
            }
            return true
        }
        if event.name == "Left"  { if this.cursor > 0 { this.cursor -= 1 }; return true }
        if event.name == "Right" { if this.cursor < n { this.cursor += 1 }; return true }
        if event.name == "Home"  { this.cursor = 0; return true }
        if event.name == "End"   { this.cursor = n; return true }
        if event.char != null {
            this.text = substring(this.text, 0, this.cursor) + event.char + substring(this.text, this.cursor, n)
            this.cursor += 1
            if this._click_handler != null { this._click_handler(this) }
            return true
        }
        return false
    }
}

fn text_input() { return TextInput() }

-- ── ScrollView ─────────────────────────────────────────
-- Single scrollable child, with vertical scroll bar. The child reports
-- its preferred size; if larger than the viewport, scrolling kicks in.

class ScrollView < Widget {
    fn init() {
        this._setup_widget()
        this.role = "scrollview"
        this.focusable = true
        this.scroll_y = 0
        this.scroll_step = 32
    }

    fn set_content(child) {
        for c in this.children { this.remove(c) }
        this.add(child)
    }

    fn _content() {
        if len(this.children) == 0 { return null }
        return this.children[0]
    }

    fn _content_h() {
        let c = this._content()
        if c == null { return 0 }
        let p = c.preferred_size()
        return p[1]
    }

    fn _max_scroll() {
        let ch = this._content_h()
        if ch <= this.height { return 0 }
        return ch - this.height
    }

    fn relayout() {
        let c = this._content()
        if c != null {
            let p = c.preferred_size()
            -- Lay the child out at its full preferred height, offset by
            -- the scroll position.
            c.set_bounds(0, 0 - this.scroll_y, this.width, p[1])
            c.relayout()
        }
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        fill_rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "background"))
        -- Vertical scroll-bar track + thumb (only when needed)
        let max = this._max_scroll()
        if max > 0 {
            let bar_w = 6
            let bar_x = r[0] + r[2] - bar_w - 2
            fill_rect(fb, bar_x, r[1] + 2, bar_w, r[3] - 4, theme_color(t, "border"))
            let content_h = this._content_h()
            let thumb_h = (r[3] - 4) * r[3] / content_h
            if thumb_h < 16 { thumb_h = 16 }
            let scroll_range = r[3] - 4 - thumb_h
            let thumb_y = r[1] + 2 + int(scroll_range * this.scroll_y / max)
            fill_rect(fb, bar_x, thumb_y, bar_w, thumb_h, theme_color(t, "accent"))
        }
    }

    fn scroll_by(dy) {
        let max = this._max_scroll()
        this.scroll_y += dy
        if this.scroll_y < 0 { this.scroll_y = 0 }
        if this.scroll_y > max { this.scroll_y = max }
        this.relayout()
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        if kind == "mouse" and event.is_scroll {
            -- One scroll notch = scroll_step px in the opposite direction
            this.scroll_by(0 - event.scroll_y * this.scroll_step)
            return true
        }
        if kind == "key" and this.focused and event.is_press {
            if event.name == "Down" or event.name == "PageDown" {
                let step = if event.name == "PageDown" { this.height } else { this.scroll_step }
                this.scroll_by(step); return true
            }
            if event.name == "Up" or event.name == "PageUp" {
                let step = if event.name == "PageUp" { this.height } else { this.scroll_step }
                this.scroll_by(0 - step); return true
            }
            if event.name == "Home" { this.scroll_by(0 - this.scroll_y); return true }
            if event.name == "End"  { this.scroll_by(this._max_scroll()); return true }
        }
        return false
    }
}

fn scroll_view() { return ScrollView() }

-- ── ListView ───────────────────────────────────────────
-- A simple vertical list of selectable string items.

class ListView < Widget {
    fn init(items) {
        this._setup_widget()
        this.role = "listbox"
        this.focusable = true
        this.items = items ?? []
        this.selected = -1
        this.row_height = 24
    }

    fn set_items(items) {
        this.items = items
        if this.selected >= len(items) { this.selected = -1 }
    }

    fn preferred_size() {
        return [120, len(this.items) * this.row_height]
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let f = theme_font(t)
        fill_rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "surface"))
        let border_c = if this.focused { theme_color(t, "focus_ring") } else { theme_color(t, "border") }
        rect(fb, r[0], r[1], r[2], r[3], border_c)
        mut i = 0
        while i < len(this.items) {
            let row_y = r[1] + i * this.row_height
            if row_y >= r[1] + r[3] { break }
            if i == this.selected {
                fill_rect(fb, r[0] + 1, row_y, r[2] - 2, this.row_height, theme_color(t, "accent"))
            }
            let m = measure_text(f, this.items[i])
            draw_text(fb, r[0] + 8, row_y + (this.row_height - m[1]) / 2, this.items[i], f, theme_color(t, "foreground"))
            i += 1
        }
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        let r = this.screen_rect()
        if kind == "mouse" and event.is_press {
            this.focus()
            let local_y = event.y - r[1]
            let idx = int(local_y / this.row_height)
            if idx >= 0 and idx < len(this.items) {
                this.selected = idx
                if this._click_handler != null { this._click_handler(this) }
            }
            return true
        }
        if kind == "key" and this.focused and event.is_press {
            if event.name == "Down" {
                if this.selected < len(this.items) - 1 { this.selected += 1 }
                if this._click_handler != null { this._click_handler(this) }
                return true
            }
            if event.name == "Up" {
                if this.selected > 0 { this.selected -= 1 }
                if this._click_handler != null { this._click_handler(this) }
                return true
            }
        }
        return false
    }
}

fn list_view(items) { return ListView(items) }

-- ── Toggle — a pill switch (on/off) ────────────────────
-- The rounded-pill counterpart to Checkbox: same on/off semantics, the
-- control Settings panels reach for. Track fills with the accent when on;
-- the knob slides between the two ends.

class Toggle < Widget {
    fn init(on) {
        this._setup_widget()
        this.role = "switch"
        this.focusable = true
        this.on = on ?? false
        this.track_w = 40
        this.track_h = 22
    }

    fn preferred_size() { return [this.track_w, this.track_h] }

    fn set_on(v) {
        this.on = v
        if this._click_handler != null { this._click_handler(this) }
    }
    fn toggle() { this.set_on(not this.on) }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let th = this.track_h
        let ty = r[1] + (r[3] - th) / 2
        let rad = th / 2
        let track = if this.on { theme_color(t, "accent") } else { theme_color(t, "border") }
        -- rounded track: two end caps + the bar between them
        circle(fb, r[0] + rad, ty + rad, rad, track)
        circle(fb, r[0] + this.track_w - rad, ty + rad, rad, track)
        fill_rect(fb, r[0] + rad, ty, this.track_w - th, th, track)
        -- knob slides to the lit end when on
        let kx = if this.on { r[0] + this.track_w - rad } else { r[0] + rad }
        circle(fb, kx, ty + rad, rad - 3, theme_color(t, "foreground"))
        if this.focused {
            rect(fb, r[0] - 1, ty - 1, this.track_w + 2, th + 2, theme_color(t, "focus_ring"))
        }
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        if kind == "mouse" and event.is_press {
            this.focus()
            this.toggle()
            return true
        }
        if kind == "key" and this.focused and event.is_press and (event.name == " " or event.name == "Enter") {
            this.toggle()
            return true
        }
        return false
    }
}

fn toggle(on) { return Toggle(on) }

-- ── RadioButton + RadioGroup — single-choice ───────────
-- A RadioButton is a labelled ring with a filled centre when selected.
-- RadioGroup wires a set together so selecting one clears the rest.

class RadioButton < Widget {
    fn init(label_text) {
        this._setup_widget()
        this.role = "radio"
        this.focusable = true
        this.label = label_text ?? ""
        this.selected = false
        this._group = null
        this.dot_size = 16
        this.gap = 8
    }

    fn preferred_size() {
        let f = theme_font(this.theme())
        let m = measure_text(f, this.label)
        let h = if m[1] > this.dot_size { m[1] } else { this.dot_size }
        return [this.dot_size + this.gap + m[0], h]
    }

    fn select() {
        if this._group != null { this._group.select(this) } else { this.selected = true }
        if this._click_handler != null { this._click_handler(this) }
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let s = this.dot_size
        let cx = r[0] + s / 2
        let cy = r[1] + (r[3] - s) / 2 + s / 2
        let ring = if this.focused { theme_color(t, "focus_ring") } else { theme_color(t, "border") }
        circle_outline(fb, cx, cy, s / 2, ring)
        if this.selected {
            circle(fb, cx, cy, s / 2 - 4, theme_color(t, "accent"))
        }
        let f = theme_font(t)
        let m = measure_text(f, this.label)
        draw_text(fb, r[0] + s + this.gap, r[1] + (r[3] - m[1]) / 2, this.label, f, theme_color(t, "foreground"))
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        if kind == "mouse" and event.is_press {
            this.focus()
            this.select()
            return true
        }
        if kind == "key" and this.focused and event.is_press and (event.name == " " or event.name == "Enter") {
            this.select()
            return true
        }
        return false
    }
}

fn radio_button(label_text) { return RadioButton(label_text) }

-- Groups a set of RadioButtons so at most one is selected. Not a Widget —
-- a plain coordinator the app holds onto; lay the buttons out normally.
class RadioGroup {
    fn init() {
        this.buttons = []
        this._change_handler = null
    }
    fn add(b) {
        b._group = this
        push(this.buttons, b)
        return b
    }
    fn select(b) {
        for x in this.buttons { x.selected = (x == b) }
        if this._change_handler != null { this._change_handler(b) }
    }
    fn selected() {
        for x in this.buttons { if x.selected { return x } }
        return null
    }
    fn on_change(h) { this._change_handler = h }
}

fn radio_group() { return RadioGroup() }

-- ── Tabs — a horizontal tab strip ──────────────────────
-- Selects one of several titled sections. Self-contained: the strip draws
-- and hit-tests entirely within its own rect; the app swaps content on
-- the selection change. The accent underline marks the active tab.

class Tabs < Widget {
    fn init(titles) {
        this._setup_widget()
        this.role = "tablist"
        this.focusable = true
        this.titles = titles ?? []
        this.selected = 0
        this.tab_h = 32
        this.pad_x = 14
    }

    fn set_titles(titles) {
        this.titles = titles
        if this.selected >= len(titles) { this.selected = if len(titles) > 0 { 0 } else { -1 } }
    }

    fn preferred_size() {
        let f = theme_font(this.theme())
        mut w = 0
        for title in this.titles {
            let m = measure_text(f, title)
            w = w + m[0] + this.pad_x * 2
        }
        return [w, this.tab_h]
    }

    fn set_selected(i) {
        if i >= 0 and i < len(this.titles) {
            this.selected = i
            if this._click_handler != null { this._click_handler(this) }
        }
    }

    -- [x, w] screen rect of each tab, laid left to right.
    fn _tab_bounds() {
        let r = this.screen_rect()
        let f = theme_font(this.theme())
        mut out = []
        mut x = r[0]
        for title in this.titles {
            let m = measure_text(f, title)
            let w = m[0] + this.pad_x * 2
            push(out, [x, w])
            x = x + w
        }
        return out
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let f = theme_font(t)
        -- baseline hairline under the whole strip
        fill_rect(fb, r[0], r[1] + this.tab_h - 1, r[2], 1, theme_color(t, "border"))
        let bounds = this._tab_bounds()
        mut i = 0
        while i < len(this.titles) {
            let b = bounds[i]
            let active = (i == this.selected)
            let col = if active { theme_color(t, "foreground") } else { theme_color(t, "foreground_muted") }
            let m = measure_text(f, this.titles[i])
            draw_text(fb, b[0] + this.pad_x, r[1] + (this.tab_h - m[1]) / 2, this.titles[i], f, col)
            if active {
                fill_rect(fb, b[0], r[1] + this.tab_h - 2, b[1], 2, theme_color(t, "accent"))
            }
            i += 1
        }
        if this.focused {
            rect(fb, r[0], r[1], r[2], this.tab_h, theme_color(t, "focus_ring"))
        }
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        if kind == "mouse" and event.is_press {
            this.focus()
            let bounds = this._tab_bounds()
            mut i = 0
            while i < len(bounds) {
                let b = bounds[i]
                if event.x >= b[0] and event.x < b[0] + b[1] {
                    this.set_selected(i)
                    return true
                }
                i += 1
            }
            return true
        }
        if kind == "key" and this.focused and event.is_press {
            if event.name == "Left"  { this.set_selected(this.selected - 1); return true }
            if event.name == "Right" { this.set_selected(this.selected + 1); return true }
        }
        return false
    }
}

fn tabs(titles) { return Tabs(titles) }

-- ── TreeView — a collapsible hierarchy ─────────────────
-- A generic retained-mode tree: nodes are {"label", "children"} dicts
-- (a leaf omits children or gives []). Rows indent by depth, folders get
-- a disclosure chevron, and one row is selectable. The reusable sibling of
-- the Files app's own sidebar tree.

-- Flatten the currently-visible rows, depth-first, honouring expansion.
-- Each node's key is its positional path ("0", "0.1", …) so expansion is
-- stable regardless of labels.
fn _tv_rows(tree, nodes, keypfx, depth) {
    mut out = []
    mut i = 0
    for n in nodes {
        let key = if keypfx == "" { str(i) } else { keypfx + "." + str(i) }
        let kids = if has(n, "children") { n["children"] } else { [] }
        let has_kids = len(kids) > 0
        let exp = has(tree.expanded, key) and tree.expanded[key]
        push(out, {"label": n["label"], "depth": depth, "has_kids": has_kids, "expanded": exp, "key": key})
        if exp and has_kids {
            for r in _tv_rows(tree, kids, key, depth + 1) { push(out, r) }
        }
        i += 1
    }
    return out
}

class TreeView < Widget {
    fn init(roots) {
        this._setup_widget()
        this.role = "tree"
        this.focusable = true
        this.roots = roots ?? []
        this.expanded = {}
        this.selected = -1
        this.row_height = 24
        this.indent = 14
    }

    fn set_roots(roots) { this.roots = roots; this.selected = -1 }
    fn visible_rows() { return _tv_rows(this, this.roots, "", 0) }
    fn toggle(key) {
        let cur = has(this.expanded, key) and this.expanded[key]
        this.expanded[key] = not cur
    }
    fn selected_label() {
        let rows = this.visible_rows()
        if this.selected >= 0 and this.selected < len(rows) { return rows[this.selected]["label"] }
        return ""
    }

    fn preferred_size() { return [180, len(this.visible_rows()) * this.row_height] }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let f = theme_font(t)
        fill_rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "surface"))
        let border_c = if this.focused { theme_color(t, "focus_ring") } else { theme_color(t, "border") }
        rect(fb, r[0], r[1], r[2], r[3], border_c)
        let rows = this.visible_rows()
        mut i = 0
        while i < len(rows) {
            let row = rows[i]
            let ry = r[1] + i * this.row_height
            if ry >= r[1] + r[3] { break }
            if i == this.selected {
                fill_rect(fb, r[0] + 1, ry, r[2] - 2, this.row_height, theme_color(t, "selection"))
            }
            let tx = r[0] + 8 + row["depth"] * this.indent
            let midy = ry + this.row_height / 2
            if row["has_kids"] {
                let cc = theme_color(t, "foreground_muted")
                if row["expanded"] {
                    line(fb, tx, midy - 1, tx + 4, midy + 3, cc)
                    line(fb, tx + 4, midy + 3, tx + 8, midy - 1, cc)
                } else {
                    line(fb, tx + 1, midy - 4, tx + 5, midy, cc)
                    line(fb, tx + 5, midy, tx + 1, midy + 4, cc)
                }
            }
            let m = measure_text(f, row["label"])
            draw_text(fb, tx + 14, ry + (this.row_height - m[1]) / 2, row["label"], f, theme_color(t, "foreground"))
            i += 1
        }
    }

    fn _handle(event) {
        let kind = _event_kind_local(event)
        let r = this.screen_rect()
        if kind == "mouse" and event.is_press {
            this.focus()
            let idx = int((event.y - r[1]) / this.row_height)
            let rows = this.visible_rows()
            if idx >= 0 and idx < len(rows) {
                let row = rows[idx]
                let tx = r[0] + 8 + row["depth"] * this.indent
                if row["has_kids"] and event.x >= tx - 3 and event.x <= tx + 12 {
                    this.toggle(row["key"])
                } else {
                    this.selected = idx
                    if this._click_handler != null { this._click_handler(this) }
                }
            }
            return true
        }
        if kind == "key" and this.focused and event.is_press {
            let rows = this.visible_rows()
            if event.name == "Down" { if this.selected < len(rows) - 1 { this.selected += 1; if this._click_handler != null { this._click_handler(this) } } return true }
            if event.name == "Up"   { if this.selected > 0 { this.selected -= 1; if this._click_handler != null { this._click_handler(this) } } return true }
            if event.name == "Right" {
                if this.selected >= 0 and this.selected < len(rows) {
                    let row = rows[this.selected]
                    if row["has_kids"] and not row["expanded"] { this.toggle(row["key"]) }
                }
                return true
            }
            if event.name == "Left" {
                if this.selected >= 0 and this.selected < len(rows) {
                    let row = rows[this.selected]
                    if row["has_kids"] and row["expanded"] { this.toggle(row["key"]) }
                }
                return true
            }
        }
        return false
    }
}

fn tree_view(roots) { return TreeView(roots) }

-- ── Dropdown — a value selector with a popup list ──────
-- The popup extends below the header, past the widget's own bounds, so
-- Dropdown overrides handle_event (which normally rejects clicks outside a
-- widget's rect) to route clicks in the open list. A click elsewhere
-- closes it.

class Dropdown < Widget {
    fn init(items) {
        this._setup_widget()
        this.role = "combobox"
        this.focusable = true
        this.items = items ?? []
        this.selected = if len(this.items) > 0 { 0 } else { -1 }
        this.open = false
        this.row_height = 24
        this.padding_x = 10
    }

    fn set_items(items) {
        this.items = items
        if this.selected >= len(items) { this.selected = if len(items) > 0 { 0 } else { -1 } }
    }
    fn value() {
        if this.selected >= 0 and this.selected < len(this.items) { return this.items[this.selected] }
        return ""
    }
    fn preferred_size() { return [150, 28] }

    -- Screen rect of the open list, directly below the header.
    fn _popup_rect() {
        let r = this.screen_rect()
        return [r[0], r[1] + r[3], r[2], len(this.items) * this.row_height]
    }

    fn _paint(fb) {
        let r = this.screen_rect()
        let t = this.theme()
        let f = theme_font(t)
        fill_rect(fb, r[0], r[1], r[2], r[3], theme_color(t, "surface"))
        let border_c = if this.focused { theme_color(t, "focus_ring") } else { theme_color(t, "border") }
        rect(fb, r[0], r[1], r[2], r[3], border_c)
        draw_text(fb, r[0] + this.padding_x, r[1] + (r[3] - f.height) / 2, this.value(), f, theme_color(t, "foreground"))
        -- caret chevron (down when closed, up when open) on the right
        let cx = r[0] + r[2] - 16
        let cy = r[1] + r[3] / 2
        let cc = theme_color(t, "foreground_muted")
        if this.open {
            line(fb, cx, cy + 2, cx + 4, cy - 2, cc); line(fb, cx + 4, cy - 2, cx + 8, cy + 2, cc)
        } else {
            line(fb, cx, cy - 2, cx + 4, cy + 2, cc); line(fb, cx + 4, cy + 2, cx + 8, cy - 2, cc)
        }
        -- open popup list
        if this.open {
            let p = this._popup_rect()
            fill_rect(fb, p[0], p[1], p[2], p[3], theme_color(t, "surface_elevated"))
            rect(fb, p[0], p[1], p[2], p[3], theme_color(t, "border"))
            mut i = 0
            while i < len(this.items) {
                let iy = p[1] + i * this.row_height
                if i == this.selected {
                    fill_rect(fb, p[0] + 1, iy, p[2] - 2, this.row_height, theme_color(t, "selection"))
                }
                draw_text(fb, p[0] + this.padding_x, iy + (this.row_height - f.height) / 2, this.items[i], f, theme_color(t, "foreground"))
                i += 1
            }
        }
    }

    -- Override the base dispatch so popup clicks (outside our rect) reach us.
    fn handle_event(event) {
        if not this.visible or not this.enabled { return false }
        let kind = _event_kind_local(event)
        if kind == "mouse" and event.is_press {
            let r = this.screen_rect()
            let in_header = event.x >= r[0] and event.x < r[0] + r[2] and event.y >= r[1] and event.y < r[1] + r[3]
            if this.open {
                let p = this._popup_rect()
                if event.x >= p[0] and event.x < p[0] + p[2] and event.y >= p[1] and event.y < p[1] + p[3] {
                    let idx = int((event.y - p[1]) / this.row_height)
                    if idx >= 0 and idx < len(this.items) {
                        this.selected = idx
                        if this._click_handler != null { this._click_handler(this) }
                    }
                    this.open = false
                    return true
                }
                this.open = false      -- click-away closes
                return in_header
            }
            if in_header { this.focus(); this.open = true; return true }
            return false
        }
        if kind == "key" and this.focused and event.is_press {
            if event.name == "Down" { if this.selected < len(this.items) - 1 { this.selected += 1; if this._click_handler != null { this._click_handler(this) } } return true }
            if event.name == "Up"   { if this.selected > 0 { this.selected -= 1; if this._click_handler != null { this._click_handler(this) } } return true }
            if event.name == "Enter" or event.name == " " { this.open = not this.open; return true }
            if event.name == "Escape" { this.open = false; return true }
        }
        return false
    }
}

fn dropdown(items) { return Dropdown(items) }

-- Local helper duplicated from ui.clarity (modules can't re-import each
-- other's private helpers cleanly without circular deps).
-- ── Tooltip — hover help text ──────────────────────────
--
-- A tooltip is an overlay, not a child: parenting it to the widget it
-- describes would clip it to that widget's bounds and bury it inside that
-- subtree's z-order. Instead it observes a target's screen rect plus the
-- pointer, and paints last, above the tree.
--
--   let tip = tooltip("Save the current file")
--   tip.attach(save_button)
--   -- each frame, after input:
--   tip.update(mouse_x, mouse_y, frame_ms)
--   -- and after painting the widget tree:
--   tip.paint_overlay(fb)

class Tooltip < Widget {
    fn init(text_value) {
        this._setup_widget()
        this.role = "tooltip"
        this.focusable = false
        this.text = text_value ?? ""
        this.target = null
        this.shown = false
        this.delay_ms = 500        -- pointer dwell before it appears
        this.hover_ms = 0
        this.pad_x = 8
        this.pad_y = 5
        this.gap = 6               -- distance from the target edge
    }

    fn attach(widget) { this.target = widget; return this }
    fn set_text(v) { this.text = v }
    fn set_delay(ms) { this.delay_ms = ms }
    fn hide() { this.shown = false; this.hover_ms = 0 }

    -- True while the pointer rests inside the target.
    fn hovering(mx, my) {
        if this.target == null { return false }
        if not this.target.visible { return false }
        let r = this.target.screen_rect()
        return mx >= r[0] and mx < r[0] + r[2] and my >= r[1] and my < r[1] + r[3]
    }

    -- Advance the dwell timer by one frame; returns whether the tip shows.
    fn update(mx, my, dt_ms) {
        if not this.hovering(mx, my) {
            this.hover_ms = 0
            this.shown = false
            return false
        }
        this.hover_ms = this.hover_ms + dt_ms
        this.shown = this.hover_ms >= this.delay_ms
        return this.shown
    }

    fn size() {
        let f = theme_font(this.theme())
        let m = measure_text(f, this.text)
        return [m[0] + this.pad_x * 2, m[1] + this.pad_y * 2]
    }

    -- Centred under the target, nudged to stay on screen, and flipped
    -- above the target when it would overflow the bottom edge.
    fn bubble_rect(fb_w, fb_h) {
        let s = this.size()
        let bw = s[0]
        let bh = s[1]
        if this.target == null { return [0, 0, bw, bh] }
        let r = this.target.screen_rect()
        mut bx = r[0] + int((r[2] - bw) / 2)
        mut by = r[1] + r[3] + this.gap
        if by + bh > fb_h { by = r[1] - bh - this.gap }
        if by < 0 { by = 0 }
        if bx + bw > fb_w { bx = fb_w - bw }
        if bx < 0 { bx = 0 }
        return [bx, by, bw, bh]
    }

    -- Paint above the rest of the tree. A no-op unless shown.
    fn paint_overlay(fb) {
        if not this.shown { return null }
        if this.text == "" { return null }
        let t = this.theme()
        let f = theme_font(t)
        let b = this.bubble_rect(fb.width, fb.height)
        fill_rect(fb, b[0], b[1], b[2], b[3], theme_color(t, "surface_elevated"))
        rect(fb, b[0], b[1], b[2], b[3], theme_color(t, "border"))
        draw_text(fb, b[0] + this.pad_x, b[1] + this.pad_y, this.text, f, theme_color(t, "foreground"))
    }

    -- A tooltip never consumes input and draws nothing in tree order.
    fn _handle(event) { return false }
    fn _paint(fb) { return null }
}

fn tooltip(text) { return Tooltip(text) }

fn _event_kind_local(event) {
    let t = type(event)
    if t == "MouseEvent" { return "mouse" }
    if t == "KeyEvent" { return "key" }
    if t == "TouchEvent" { return "touch" }
    return "unknown"
}
