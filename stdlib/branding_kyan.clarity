-- Kyan branding kit — KyanOS identity (rebrand phase K1).
--
-- Replaces the Drop+Leaf spring branding with the faceted-K
-- monogram: the letter K cut like a gem, its upper-right edge lit
-- by the signature gradient. Wordmark is "KyanOS" — "Kyan" in ink,
-- "OS" in the signature cyan. The gradient lives only on the lit
-- edge and accent elements; everything else is quiet dark glass.
--
-- Parallel to branding_modern.clarity (which stays for the legacy
-- spring splash). App icons reuse the modern abstract-mark set and
-- add "prism" — the game-hub hero mark.

from "draw.clarity" import line, circle, fill_rect, rect, rounded_rect, polygon, polyline, fill_polygon
from "graphics.clarity" import framebuffer
from "theme_kyan.clarity" import kyan_gradient
from "branding_modern.clarity" import paint_icon, icon_recipes
from "font.clarity" import draw_text, measure_text, draw_text_scaled, draw_text_smooth, measure_text_scaled, builtin_font

-- ── Brand identity ─────────────────────────────

let KYAN_BRAND_NAME = "KyanOS"
let KYAN_LANG_NAME = "Clarity"
let KYAN_TAGLINE = "Dark glass. One light."

-- Fixed dark-glass facet tones — the monogram always sits on a dark
-- tile (boot splash is void-black in both modes; the app tile is
-- dark glass), so the shard colours don't track the theme; only the
-- lit edge does, via the signature gradient.
let _FACET_STEM_HI = 0xFF3B4258
let _FACET_STEM_LO = 0xFF2A3044
let _FACET_DIAG_HI = 0xFF454E68
let _FACET_DIAG_LO = 0xFF333A50
let _TILE_TOP      = 0xFF10151F
let _TILE_BOTTOM   = 0xFF05060A

-- Map a local design coord (0..104 box, matching the mockup SVG)
-- to screen space centred on (cx, cy) at the given pixel size.
fn _kyan_pt(cx, cy, size, lx, ly) {
    let sx = cx - size / 2 + int(lx / 104.0 * size)
    let sy = cy - size / 2 + int(ly / 104.0 * size)
    return [sx, sy]
}

fn _kyan_facet(fb, cx, cy, size, pts, dx, dy, color) {
    mut mapped = []
    for p in pts {
        let s = _kyan_pt(cx, cy, size, p[0], p[1])
        push(mapped, [s[0] + dx, s[1] + dy])
    }
    fill_polygon(fb, mapped, color)
    return mapped
}

-- Paint the faceted-K monogram. opts:
--   "tile"     — draw the dark rounded tile behind it (default false)
--   "assemble" — 0..1 intro progress; <1 offsets shards for the
--                boot "assemble" moment (default 1.0, fully settled)
fn paint_monogram(fb, cx, cy, size, theme, opts) {
    let o = opts ?? {}
    let assemble = if has(o, "assemble") { o["assemble"] } else { 1.0 }
    let draw_tile = if has(o, "tile") { o["tile"] } else { false }

    if draw_tile {
        let t = size + int(size * 0.42)
        let tx = cx - t / 2
        let ty = cy - t / 2
        -- Simple two-band tile (no gradient primitive yet — K2 adds it)
        rounded_rect(fb, tx, ty, t, t, int(t / 4.6), _TILE_BOTTOM)
        fill_rect(fb, tx + 2, ty + 2, t - 4, t / 2, _TILE_TOP)
    }

    -- Shard displacement during the assemble moment: each facet
    -- slides in from a slightly different offset, easing to zero.
    let slack = int((1.0 - assemble) * (size * 0.18))
    let lit = kyan_gradient(theme, 0.82)   -- cyan-leaning edge

    -- stem (two shards)
    _kyan_facet(fb, cx, cy, size, [[22,12],[40,12],[36,52],[22,52]], 0 - slack, 0, _FACET_STEM_HI)
    _kyan_facet(fb, cx, cy, size, [[22,52],[36,52],[40,92],[22,92]], 0 - slack, slack, _FACET_STEM_LO)
    -- upper diagonal shard (slides from upper-right)
    _kyan_facet(fb, cx, cy, size, [[40,50],[82,10],[90,20],[50,56]], slack, 0 - slack, _FACET_DIAG_HI)
    -- lower diagonal shard (slides from lower-right)
    _kyan_facet(fb, cx, cy, size, [[48,58],[88,90],[74,94],[40,64]], slack, slack, _FACET_DIAG_LO)
    -- the lit edge — signature gradient facet, settles last, with a
    -- crisp brighter stroke along it for the neon glow-line
    let lit_pts = _kyan_facet(fb, cx, cy, size, [[82,10],[90,20],[50,56],[46,48]], slack, 0 - slack, lit)
    polygon(fb, lit_pts, kyan_gradient(theme, 1.0))
}

-- Wordmark: "Kyan" in ink + "OS" in the signature cyan. Returns the
-- total pixel width drawn.
fn paint_kyan_wordmark(fb, x, y, theme, opts) {
    let o = opts ?? {}
    let font = if has(o, "font") { o["font"] } else { builtin_font() }
    let text = if has(o, "text") { o["text"] } else { KYAN_BRAND_NAME }
    let ink = if has(o, "color") { o["color"] } else { theme["foreground"] }
    let accent = if has(o, "accent") { o["accent"] } else { theme["accent"] }
    let split = if has(o, "split") { o["split"] } else { 4 }   -- "Kyan" | "OS"
    let scale = if has(o, "scale") { o["scale"] } else { 1 }
    let letter_spacing = if has(o, "letter_spacing") { o["letter_spacing"] } else { 1 }
    mut cursor = x
    mut i = 0
    while i < len(text) {
        let glyph = char_at(text, i)
        let color = if i < split { ink } else { accent }
        draw_text_smooth(fb, cursor, y, glyph, font, color, scale, 0)
        cursor = cursor + measure_text_scaled(font, glyph, scale, 0)[0] + letter_spacing
        i = i + 1
    }
    return cursor - x
}

-- ── App icons — a modern, anti-aliased set ──────────────
--
-- The old icons were thin 1-px "abstract marks" that looked archaic.
-- These are bold, filled glyphs in the Kyan palette. To kill the
-- jaggies, each icon is drawn at 3x into a scratch buffer seeded with
-- the real destination pixels, then box-downsampled back — supersampled
-- anti-aliasing that composites cleanly over whatever's behind it (the
-- dock glass, the launcher scrim, a window).

let _ICON_SS = 3

fn kyan_icon_recipes() {
    mut out = {}
    for kv in entries(icon_recipes()) { out[kv[0]] = kv[1] }
    out["prism"] = {"mark": "prism", "accent": "accent"}
    out["voidrunner"] = {"mark": "prism", "accent": "accent"}
    return out
}

fn paint_prism_icon(fb, x, y, size, theme) {
    paint_kyan_icon(fb, "prism", x, y, size, theme)
    return true
}

let _KNOWN_ICONS = ["prism", "voidrunner", "terminal", "files", "editor", "monitor", "settings", "calc", "viewer", "mail", "chat", "store"]

fn paint_kyan_icon(fb, app_id, x, y, size, theme) {
    let matched = contains(_KNOWN_ICONS, app_id)
    let ss = _ICON_SS
    let n = size * ss
    let tmp = framebuffer(n, n)
    -- seed the scratch buffer with the upscaled destination background
    mut yy = 0
    while yy < n {
        let sy = y + int(yy / ss)
        mut xx = 0
        while xx < n {
            tmp.put_pixel(xx, yy, fb.get_pixel(x + int(xx / ss), sy))
            xx = xx + 1
        }
        yy = yy + 1
    }
    -- draw the bold mark at 3x
    _kyan_mark(tmp, app_id, 0, 0, n, theme)
    -- box-downsample back into the destination (anti-aliased)
    let cnt = ss * ss
    mut dy = 0
    while dy < size {
        mut dx = 0
        while dx < size {
            mut r = 0
            mut g = 0
            mut b = 0
            mut oy = 0
            while oy < ss {
                mut ox = 0
                while ox < ss {
                    let p = tmp.get_pixel(dx * ss + ox, dy * ss + oy)
                    r = r + (int(p / 65536) & 0xFF)
                    g = g + (int(p / 256) & 0xFF)
                    b = b + (p & 0xFF)
                    ox = ox + 1
                }
                oy = oy + 1
            }
            fb.put_pixel(x + dx, y + dy, 4278190080 + int(r / cnt) * 65536 + int(g / cnt) * 256 + int(b / cnt))
            dx = dx + 1
        }
        dy = dy + 1
    }
    return matched
}

-- The bold filled marks, drawn in a size×size box at (x, y).
fn _kyan_mark(fb, app, x, y, s, theme) {
    let cyan = theme["accent"]
    let violet = theme["accent_secondary"]
    let indigo = theme["accent_tertiary"]
    let ink = theme["foreground"]
    let muted = theme["foreground_muted"]
    let glass = theme["surface_elevated"]
    let pad = int(s * 0.14)
    let iw = s - 2 * pad
    let cx = x + int(s / 2)
    let cy = y + int(s / 2)

    if app == "prism" or app == "voidrunner" {
        let top = y + int(s * 0.20)
        let bot = y + int(s * 0.80)
        let half = int(s * 0.30)
        fill_polygon(fb, [[cx, top], [cx + half, bot], [cx - half, bot]], violet)
        fill_polygon(fb, [[cx, top], [cx + int(half / 2), int((top + bot) / 2)], [cx, bot]], cyan)
        fill_rect(fb, cx - max(1, int(s / 32)), top, max(2, int(s / 16)), bot - top, 0xFFEAF6FF)
        return null
    }
    if app == "terminal" {
        rounded_rect(fb, x + pad, y + pad, iw, iw, int(s * 0.14), 0xFF0B0F18)
        fill_rect(fb, x + pad, y + pad, iw, int(s * 0.16), glass)
        -- chevron ">"
        let bx = x + int(s * 0.30)
        let by = cy
        let cw = int(s * 0.16)
        fill_polygon(fb, [[bx, by - cw], [bx + cw, by], [bx, by + cw], [bx - int(cw / 2), by + cw], [bx + int(cw / 2), by], [bx - int(cw / 2), by - cw]], cyan)
        -- prompt underscore
        fill_rect(fb, cx + int(s * 0.02), by + int(cw * 0.6), int(s * 0.22), max(2, int(s / 22)), cyan)
        return null
    }
    if app == "files" {
        let fw = iw
        let fy = y + int(s * 0.30)
        rounded_rect(fb, x + pad, fy - int(s * 0.10), int(fw * 0.5), int(s * 0.14), int(s * 0.05), violet)
        rounded_rect(fb, x + pad, fy, fw, int(s * 0.42), int(s * 0.06), cyan)
        return null
    }
    if app == "editor" {
        rounded_rect(fb, x + pad, y + pad, iw, iw, int(s * 0.10), 0xFFEAEEF7)
        fill_polygon(fb, [[x + s - pad - int(iw * 0.34), y + pad], [x + s - pad, y + pad], [x + s - pad, y + pad + int(iw * 0.34)]], glass)
        let lx = x + pad + int(s * 0.10)
        let lw = iw - int(s * 0.20)
        fill_rect(fb, lx, cy - int(s * 0.10), lw, max(2, int(s / 24)), violet)
        fill_rect(fb, lx, cy, int(lw * 0.75), max(2, int(s / 24)), muted)
        fill_rect(fb, lx, cy + int(s * 0.10), int(lw * 0.5), max(2, int(s / 24)), muted)
        return null
    }
    if app == "monitor" {
        let base = y + s - pad
        let bw = int(s * 0.16)
        let gap = int(s * 0.08)
        let x0 = cx - int((3 * bw + 2 * gap) / 2)
        rounded_rect(fb, x0, base - int(s * 0.28), bw, int(s * 0.28), int(bw / 3), indigo)
        rounded_rect(fb, x0 + bw + gap, base - int(s * 0.46), bw, int(s * 0.46), int(bw / 3), violet)
        rounded_rect(fb, x0 + 2 * (bw + gap), base - int(s * 0.62), bw, int(s * 0.62), int(bw / 3), cyan)
        return null
    }
    if app == "settings" {
        -- three sliders with knobs (modern, not a gear)
        let rows = [{"y": 0.34, "kx": 0.66, "c": cyan}, {"y": 0.5, "kx": 0.38, "c": violet}, {"y": 0.66, "kx": 0.58, "c": indigo}]
        for row in rows {
            let ry = y + int(s * row["y"])
            fill_rect(fb, x + pad, ry - max(1, int(s / 40)), iw, max(2, int(s / 20)), glass)
            circle(fb, x + pad + int(iw * row["kx"]), ry, int(s * 0.075), row["c"])
        }
        return null
    }
    if app == "calc" {
        rounded_rect(fb, x + pad, y + pad, iw, iw, int(s * 0.12), glass)
        fill_rect(fb, x + pad + int(s * 0.08), y + pad + int(s * 0.08), iw - int(s * 0.16), int(s * 0.16), 0xFF0B0F18)
        mut gy2 = y + pad + int(s * 0.34)
        mut ri = 0
        while ri < 2 {
            mut cxi = x + pad + int(s * 0.10)
            mut cc = 0
            while cc < 3 {
                let col = if ri == 0 and cc == 2 { cyan } else { muted }
                circle(fb, cxi, gy2, int(s * 0.045), col)
                cxi = cxi + int(s * 0.24)
                cc = cc + 1
            }
            gy2 = gy2 + int(s * 0.20)
            ri = ri + 1
        }
        return null
    }
    if app == "viewer" {
        rounded_rect(fb, x + pad, y + pad, iw, iw, int(s * 0.10), glass)
        circle(fb, x + pad + int(iw * 0.72), y + pad + int(iw * 0.28), int(s * 0.07), 0xFFFBBF24)
        fill_polygon(fb, [[x + pad, y + s - pad], [x + pad + int(iw * 0.4), cy], [x + pad + int(iw * 0.7), y + s - pad]], cyan)
        fill_polygon(fb, [[x + pad + int(iw * 0.45), y + s - pad], [x + pad + int(iw * 0.75), y + int(s * 0.5)], [x + s - pad, y + s - pad]], violet)
        return null
    }
    if app == "mail" {
        rounded_rect(fb, x + pad, y + int(s * 0.28), iw, int(s * 0.44), int(s * 0.06), cyan)
        fill_polygon(fb, [[x + pad, y + int(s * 0.30)], [cx, cy], [x + s - pad, y + int(s * 0.30)]], 0xFF0B1524)
        return null
    }
    if app == "chat" {
        rounded_rect(fb, x + pad, y + pad, iw, int(iw * 0.72), int(s * 0.14), violet)
        fill_polygon(fb, [[x + pad + int(iw * 0.2), y + pad + int(iw * 0.66)], [x + pad + int(iw * 0.14), y + s - pad], [x + pad + int(iw * 0.44), y + pad + int(iw * 0.66)]], violet)
        circle(fb, cx - int(s * 0.14), y + pad + int(iw * 0.34), int(s * 0.035), 0xFFEAF6FF)
        circle(fb, cx, y + pad + int(iw * 0.34), int(s * 0.035), 0xFFEAF6FF)
        circle(fb, cx + int(s * 0.14), y + pad + int(iw * 0.34), int(s * 0.035), 0xFFEAF6FF)
        return null
    }
    if app == "store" {
        fill_polygon(fb, [[cx, y + pad], [x + s - pad, cy], [cx, y + s - pad], [x + pad, cy]], violet)
        fill_polygon(fb, [[cx, y + int(s * 0.3)], [x + s - int(s * 0.34), cy], [cx, y + int(s * 0.7)], [x + int(s * 0.34), cy]], cyan)
        return null
    }
    -- generic: a rounded tile with a signature dot
    rounded_rect(fb, x + pad, y + pad, iw, iw, int(s * 0.12), glass)
    circle(fb, cx, cy, int(s * 0.16), cyan)
}

fn max(a, b) { if a > b { return a }; return b }
